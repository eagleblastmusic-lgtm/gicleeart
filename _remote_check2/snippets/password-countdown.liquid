{%- doc -%}
  Komunikat na stronie hasła (zamiast licznika odliczania).
{%- enddoc -%}

{%- if section.settings.show_password_countdown -%}

{% liquid
  assign show_pc_heading = true
  if section.settings.password_countdown_show_heading == false
    assign show_pc_heading = false
  endif
  assign _pc_message = ''
  if show_pc_heading
    assign _pc_custom = section.settings.password_countdown_heading | strip
    assign _pc_custom_lc = _pc_custom | downcase
    if _pc_custom != blank and _pc_custom_lc != '[auto]' and _pc_custom != 'Do otwarcia pozostało:'
      assign _pc_message = _pc_custom
    else
      assign _pc_message = 'password.maintenance.message' | t
    endif
  endif
%}

<div class="password-countdown" aria-live="polite">
  <div class="password-countdown__inner">
    {% if _pc_message != blank %}
      <p class="password-countdown__heading">{{ _pc_message }}</p>
    {% endif %}
  </div>
</div>

{%- endif -%}

{% stylesheet %}
  .password-countdown {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    margin-block-end: var(--gap-md, 1rem);
    text-align: center;
  }

  .password-countdown__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-md, 1rem);
  }

  .password-countdown__heading {
    margin: 0;
    max-width: 22rem;
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style, normal);
    font-weight: var(--font-accent--weight, 400);
    font-size: clamp(0.95rem, 2.75vw, 1.2rem);
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: none;
    font-feature-settings:
      'kern' 1,
      'liga' 1;
    color: var(--color-foreground-heading, var(--color-foreground));
  }
{% endstylesheet %}
