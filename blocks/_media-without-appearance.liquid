
{% liquid
  assign unset_image_tag = false
  if block.settings.image_position == 'contain'
    assign unset_image_tag = true
  endif
%}

{% render 'media', unset_image_tag: unset_image_tag %}

{% schema %}
{
  "name": "t:names.media",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        },
        {
          "value": "scroll_video",
          "label": "Wideo sterowane przewijaniem"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "visible_if": "{{ block.settings.media_type == 'image'  }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "scroll_video_asset",
      "label": "Identyfikator sekwencji klatek",
      "info": "Filozofia: giclee-philosophy-frames · Portal Wrota: giclee-philosophy-wrota",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "select",
      "id": "scroll_video_engine",
      "label": "Sposób odtwarzania",
      "options": [
        {
          "value": "video",
          "label": "Film — natywny odtwarzacz"
        },
        {
          "value": "frames",
          "label": "Klatki — sekwencja WebP"
        }
      ],
      "default": "video",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "select",
      "id": "scroll_video_quality",
      "label": "Jakość wyświetlania",
      "options": [
        {
          "value": "720p",
          "label": "720p — najwyższa płynność"
        },
        {
          "value": "1080p",
          "label": "1080p — Full HD"
        }
      ],
      "default": "720p",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "select",
      "id": "scroll_video_container",
      "label": "Format filmu",
      "options": [
        {
          "value": "mp4",
          "label": "MP4 H.264 — najwyższa zgodność"
        },
        {
          "value": "webm",
          "label": "WebM — gotowy plik, możliwa alfa"
        }
      ],
      "default": "mp4",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' and block.settings.scroll_video_engine == 'video' }}"
    },
    {
      "type": "text",
      "id": "scroll_video_source",
      "label": "Konkretny plik (GicleeApp)",
      "info": "Wartość zarządzana przez listę plików w GicleeApp. Puste pole korzysta z domyślnego slotu formatu i jakości.",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' and block.settings.scroll_video_engine == 'video' }}"
    },
    {
      "type": "text",
      "id": "scroll_intro_title",
      "label": "Nagłówek początkowy",
      "info": "Znak | rozpoczyna nową linię.",
      "default": "FILOZOFIA|MARKI",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "richtext",
      "id": "scroll_intro_subtitle",
      "label": "Podtytuł początkowy",
      "default": "<p>Giclée Art opiera się na idei, że dzieło sztuki nie kończy się na pliku cyfrowym.</p>",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_intro_pin_vh",
      "label": "Przypięcie nagłówka początkowego",
      "min": 10,
      "max": 300,
      "step": 5,
      "unit": "vh",
      "default": 45,
      "info": "Jak długo nagłówek z podtytułem pozostaje przypięty podczas scrolla.",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_intro_fade_start_vh",
      "label": "Start znikania nagłówka początkowego",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "vh",
      "default": 45,
      "info": "Po ilu vh przewijania nagłówek zaczyna znikać. Nie wcześniej niż kończy się przypięcie.",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "richtext",
      "id": "scroll_outro_text",
      "label": "Tekst końcowy",
      "default": "<p>Kończy się dopiero wtedy, gdy otrzymuje swoją ostateczną formę — spójną, archiwalną i gotową do ekspozycji.</p>",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_outro_appear_percent",
      "label": "Pojawienie się tekstu końcowego",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 95,
      "info": "W którym momencie animacji filmu pojawia się tekst końcowy.",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_outro_pin_vh",
      "label": "Przypięcie tekstu końcowego",
      "min": 10,
      "max": 300,
      "step": 5,
      "unit": "vh",
      "default": 60,
      "info": "Jak długo tekst końcowy pozostaje przypięty po pojawieniu.",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "select",
      "id": "scroll_motion_preset",
      "label": "Charakter odtwarzania",
      "options": [
        { "value": "direct", "label": "Bezpośredni 1:1" },
        { "value": "product", "label": "Precyzyjny produktowy" },
        { "value": "smooth", "label": "Płynny" },
        { "value": "cinematic", "label": "Filmowy" },
        { "value": "soft-inertia", "label": "Miękka bezwładność" },
        { "value": "dynamic", "label": "Dynamiczny" },
        { "value": "heavy-camera", "label": "Ciężka kamera" },
        { "value": "luxury", "label": "Delikatny luksusowy" },
        { "value": "custom", "label": "Własne ustawienia" }
      ],
      "default": "direct",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "number",
      "id": "scroll_motion_speed",
      "label": "Tempo",
      "default": 1,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "select",
      "id": "scroll_motion_easing",
      "label": "Easing",
      "options": [
        { "value": "linear", "label": "Linear" },
        { "value": "ease-in", "label": "Ease In" },
        { "value": "ease-out", "label": "Ease Out" },
        { "value": "ease-in-out", "label": "Ease In-Out" },
        { "value": "sine-in-out", "label": "Sine In-Out" },
        { "value": "quad-in-out", "label": "Quad In-Out" },
        { "value": "cubic-in-out", "label": "Cubic In-Out" },
        { "value": "quart-in-out", "label": "Quart In-Out" },
        { "value": "expo-in-out", "label": "Expo In-Out" },
        { "value": "smoothstep", "label": "Smoothstep" },
        { "value": "smootherstep", "label": "Smootherstep" },
        { "value": "custom-bezier", "label": "Custom Cubic Bézier" }
      ],
      "default": "linear",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "text",
      "id": "scroll_motion_bezier",
      "label": "Custom Cubic Bézier: x1,y1,x2,y2",
      "default": "0.25,0.10,0.25,1.00",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_smoothing_ms",
      "label": "Wygładzanie",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_lag_ms",
      "label": "Lag",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_inertia",
      "label": "Bezwładność",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_damping",
      "label": "Tłumienie",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_max_catchup",
      "label": "Maksymalna prędkość nadrabiania",
      "min": 0,
      "max": 8,
      "step": 0.1,
      "default": 0,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "select",
      "id": "scroll_motion_stop_behavior",
      "label": "Po zatrzymaniu scrolla",
      "options": [
        { "value": "immediate", "label": "Zatrzymaj natychmiast" },
        { "value": "reach", "label": "Płynnie dojdź do celu" },
        { "value": "nearest-frame", "label": "Dokończ do najbliższej klatki" },
        { "value": "decelerate", "label": "Delikatnie wyhamuj" },
        { "value": "snap", "label": "Snap do najbliższego punktu" }
      ],
      "default": "immediate",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_snap_points",
      "label": "Liczba punktów snap",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 5,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "select",
      "id": "scroll_motion_direction",
      "label": "Kierunek",
      "options": [
        { "value": "normal", "label": "Normalny" },
        { "value": "reverse", "label": "Odwrócony" }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_material_start",
      "label": "Początek materiału",
      "min": 0,
      "max": 99,
      "step": 1,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_material_end",
      "label": "Koniec materiału",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "select",
      "id": "scroll_motion_interpolation",
      "label": "Interpolacja postępu",
      "options": [
        { "value": "none", "label": "Brak — natychmiast" },
        { "value": "linear", "label": "Linear" },
        { "value": "exponential", "label": "Exponential smoothing" },
        { "value": "damp", "label": "Damp" },
        { "value": "spring", "label": "Spring" },
        { "value": "velocity", "label": "Velocity-based" }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "checkbox",
      "id": "scroll_motion_tail_pacing",
      "label": "Płynne domknięcie hamowania",
      "default": false,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_tail_window_frames",
      "label": "Zakres płynnego domknięcia",
      "min": 2,
      "max": 30,
      "step": 1,
      "unit": "kl.",
      "default": 12,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "select",
      "id": "scroll_motion_frame_rounding",
      "label": "Wybór klatki WebP",
      "options": [
        { "value": "floor", "label": "Floor" },
        { "value": "round", "label": "Round" },
        { "value": "ceil", "label": "Ceil" }
      ],
      "default": "round",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_mp4_dead_zone_ms",
      "label": "Martwa strefa filmu (MP4/WebM)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "ms",
      "default": 4,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_webp_dead_zone_frames",
      "label": "Martwa strefa WebP",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 1,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_preload_radius",
      "label": "Promień preloadu WebP",
      "min": 2,
      "max": 60,
      "step": 1,
      "default": 12,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_motion_cache_frames",
      "label": "Limit cache bitmap (0 = auto)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "checkbox",
      "id": "scroll_preserve_alpha",
      "label": "Zachowaj kanał alfa",
      "default": true,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "select",
      "id": "scroll_background_mode",
      "label": "Tryb tła",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "transparent", "label": "Przezroczyste" },
        { "value": "color", "label": "Kolor" },
        { "value": "gradient", "label": "Gradient" },
        { "value": "image", "label": "Obraz strony" }
      ],
      "default": "auto",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "text",
      "id": "scroll_background_value",
      "label": "Kolor / gradient / obraz fallbacku",
      "default": "#000000",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "checkbox",
      "id": "scroll_background_parallax",
      "label": "Paralaksa tła (mysz)",
      "default": false,
      "info": "Subtelny ruch obrazu lub WebM tła pod kursorem. Działa na desktopie.",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' and block.settings.scroll_video_asset != 'giclee-philosophy-wrota' }}"
    },
    {
      "type": "checkbox",
      "id": "scroll_alpha_diagnostics",
      "label": "Diagnostyka krawędzi alfa",
      "default": false,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "checkbox",
      "id": "scroll_force_transparent",
      "label": "Wymuś wariant przezroczysty",
      "default": false,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_video_duration",
      "label": "Długość animacji",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "s",
      "default": 6,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "scroll_video_viewport",
      "label": "Wysokość obszaru animacji",
      "min": 100,
      "max": 1500,
      "step": 50,
      "unit": "vh",
      "default": 400,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' }}"
    },
    {
      "type": "range",
      "id": "before_after_count",
      "label": "Galeria Przed i po — liczba obrazów",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' and block.settings.scroll_video_asset == 'giclee-philosophy-wrota' }}"
    },
    {
      "type": "checkbox",
      "id": "fm_bg_parallax_enabled",
      "label": "Paralaksa tła (mysz)",
      "default": true,
      "info": "Subtelny ruch warstwy Bottom pod kursorem po końcówce filmu Wrota.",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' and block.settings.scroll_video_asset == 'giclee-philosophy-wrota' }}"
    },
    {
      "type": "checkbox",
      "id": "before_after_motion_blur",
      "label": "Galeria Przed i po — efekt smużenia",
      "default": true,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' and block.settings.scroll_video_asset == 'giclee-philosophy-wrota' }}"
    },
    {
      "type": "checkbox",
      "id": "before_after_film_grain",
      "label": "Galeria Przed i po — animowane filmowe ziarno",
      "default": true,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' and block.settings.scroll_video_asset == 'giclee-philosophy-wrota' }}"
    },
    {
      "type": "checkbox",
      "id": "before_after_bg_transparent",
      "label": "Galeria Przed i po — przezroczystość tła",
      "default": true,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' and block.settings.scroll_video_asset == 'giclee-philosophy-wrota' }}"
    },
    {
      "type": "checkbox",
      "id": "before_after_preserve_prev_bg",
      "label": "Galeria Przed i po — zachowaj winietę i tło poprzedniego ekranu",
      "default": true,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' and block.settings.scroll_video_asset == 'giclee-philosophy-wrota' }}"
    },
    {
      "type": "range",
      "id": "before_after_bg_radial_opacity",
      "label": "Galeria Przed i po — tło radialne",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' and block.settings.scroll_video_asset == 'giclee-philosophy-wrota' and block.settings.before_after_bg_transparent }}"
    },
    {
      "type": "range",
      "id": "before_after_bg_linear_opacity",
      "label": "Galeria Przed i po — tło liniowe",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ block.settings.media_type == 'scroll_video' and block.settings.scroll_video_asset == 'giclee-philosophy-wrota' and block.settings.before_after_bg_transparent }}"
    },
    {
      "type": "textarea",
      "id": "before_after_texts_json",
      "label": "Galeria Przed i po — teksty (GicleeApp)",
      "info": "To pole jest zarządzane przez czytelny panel sekcji „Przed i po” w GicleeApp.",
      "default": "{}",
      "visible_if": "{{ block.settings.media_type == 'scroll_video' and block.settings.scroll_video_asset == 'giclee-philosophy-wrota' }}"
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:settings.loop",
      "default": true,
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:settings.autoplay",
      "default": false,
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:settings.image_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain ",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:settings.video_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.media_type == 'video' or block.settings.media_type == 'scroll_video' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.media"
    }
  ]
}
{% endschema %}
