

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  <div
    class="border-style"
    style="{% render 'border-override', settings: section.settings %}"
  >
    {% liquid
      assign bg_media = section.settings.background_media
      assign bg_desktop = section.settings.background_image
      assign bg_mobile = section.settings.background_image_mobile
      assign bg_fit = section.settings.background_image_position
    %}
    {% if bg_media == 'image' and bg_mobile != blank and bg_desktop != blank %}
      <div class="password-background-dual">
        <div
          class="background-image-container password-background-dual__desktop{% if bg_fit == 'fit' %} background-image-fit{% endif %}"
          aria-hidden="true"
        >
          {% liquid
            assign sizes = '100vw'
            assign widths = '832, 1200, 1600, 1920, 2560, 3840'
            assign fetch_priority = 'high'
            assign loading = 'eager'
          %}
          {{
            bg_desktop
            | image_url: width: 3840
            | image_tag: sizes: sizes, widths: widths, loading: loading, fetchpriority: fetch_priority
          }}
        </div>
        <div
          class="background-image-container password-background-dual__mobile{% if bg_fit == 'fit' %} background-image-fit{% endif %}"
          aria-hidden="true"
        >
          {% liquid
            assign sizes_m = '100vw'
            assign widths_m = '375, 550, 750, 1100, 1600'
          %}
          {{
            bg_mobile
            | image_url: width: 1600
            | image_tag: sizes: sizes_m, widths: widths_m, loading: loading, fetchpriority: fetch_priority
          }}
        </div>
      </div>
    {% else %}
      {% liquid
        assign bg_for_single = bg_desktop
        if bg_media == 'image' and bg_for_single == blank and bg_mobile != blank
          assign bg_for_single = bg_mobile
        endif
      %}
      {% render 'background-media',
        background_media: section.settings.background_media,
        background_video: section.settings.video,
        background_video_position: section.settings.video_position,
        background_image: bg_for_single,
        background_image_position: section.settings.background_image_position
      %}
    {% endif %}

    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--{{ section.settings.content_direction }}
        section-content-wrapper
        {% if section.settings.vertical_on_mobile %} mobile-column{% endif %}
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {%  render 'spacing-style', settings: section.settings %}
      "
      data-testid="section-content"
    >
      {% render 'password-countdown', section: section %}

      {% content_for 'blocks' %}

      {%- if shop.password_message != blank -%}
        <div class="password-content">
          {{ shop.password_message }}
        </div>
      {%- endif -%}
    </div>

    <div class="password-section__lang-flags">
      {%- render 'password-language-flags' -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-password {
    flex-grow: 1;
    display: flex;
  }

  /* Flagi — lewy dolny róg; tylko ten blok ma hit-area (bez pełnoekranowego overlay z pointer-events: none). */
  .password-section__lang-flags {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 6;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: clamp(0.45rem, 2.2vmin, 1rem);
    max-width: min(100%, 22rem);
    pointer-events: auto;
  }

  .password-section__lang-flags .password-footer__langs {
    margin: 0;
    padding: 0;
    width: fit-content;
    max-width: min(100%, 22rem);
  }

  .password-section__lang-flags .password-footer__langs-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: var(--gap-2xs, 0.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .password-section__lang-flags .password-footer__langs-item {
    margin: 0;
  }

  .password-section__lang-flags a.password-footer__lang-btn {
    text-decoration: none;
    color: inherit;
  }

  .password-section__lang-flags .password-footer__lang-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.15rem;
    margin: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    line-height: 1;
    border-radius: 6px;
    transition:
      opacity var(--animation-speed, 0.2s) var(--animation-easing, ease),
      transform var(--animation-speed, 0.2s) var(--animation-easing, ease);
    opacity: 0.72;
    color: inherit;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
  }

  .password-section__lang-flags .password-footer__lang-btn:hover,
  .password-section__lang-flags .password-footer__lang-btn:focus-visible {
    opacity: 1;
    outline: none;
  }

  .password-section__lang-flags .password-footer__lang-btn:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .password-section__lang-flags .password-footer__lang-btn--current {
    opacity: 1;
    transform: scale(1.06);
  }

  .password-section__lang-flags .password-footer__lang-btn--inactive {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.25));
  }

  .password-section__lang-flags .password-footer__lang-flag {
    font-size: clamp(1.2rem, 3.2vw, 1.55rem);
    display: block;
    line-height: 1;
  }

  .password-content {
    text-align: center;
  }

  /* Dwa obrazy tła: telefon ≤749px, desktop ≥750px */
  .password-background-dual__desktop {
    display: none;
  }

  .password-background-dual__mobile {
    display: block;
  }

  @media screen and (min-width: 750px) {
    .password-background-dual__desktop {
      display: block;
    }

    .password-background-dual__mobile {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.section",
  "class": "section-wrapper section-password",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "t:settings.align_baseline",
      "default": false,
      "visible_if": "{{ section.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:settings.background_media",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "none"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:settings.video_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Obraz tła (telefon)",
      "info": "Opcjonalny. Gdy ustawisz obraz główny i ten, na szerokości do 749px pokazuje się wersja na telefon, od 750px — główny.",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "t:settings.image_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "fit",
          "label": "t:options.fit"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.borders",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "label": "t:settings.border_width",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.border_opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Licznik odliczania"
    },
    {
      "type": "checkbox",
      "id": "show_password_countdown",
      "label": "Pokaż licznik do otwarcia",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "password_countdown_show_heading",
      "label": "Pokaż tekst nad licznikiem",
      "default": true,
      "visible_if": "{{ section.settings.show_password_countdown }}"
    },
    {
      "type": "text",
      "id": "password_countdown_heading",
      "label": "Własny tekst nad licznikiem (opcjonalnie)",
      "default": "[auto]",
      "info": "[auto] = tekst z tłumaczeń motywu (wg języka sklepu). Zastąp własnym tekstem tylko jeśli ma być ten sam we wszystkich językach."
    },
    {
      "type": "text",
      "id": "password_countdown_end",
      "label": "Data i godzina końca (ISO 8601)",
      "default": "2026-06-03T00:00:00+02:00",
      "info": "Używane gdy w ustawieniach motywu (Strona hasła) pole globalnej daty jest puste lub ma starą wartość 2026-06-01."
    },
    {
      "type": "text",
      "id": "password_countdown_expired_message",
      "label": "Komunikat po zakończeniu odliczania",
      "default": "[auto]",
      "info": "[auto] = komunikat z tłumaczeń motywu."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
