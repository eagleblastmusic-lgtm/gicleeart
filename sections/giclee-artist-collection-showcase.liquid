{%- liquid
  assign max_products = section.settings.max_products | default: 50
  assign layout_mode = section.settings.layout_mode | default: 'coverflow'

  capture default_eyebrow
    render 'giclee-i18n-text', scope: 'sections', id: section.id, field: 'eyebrow', fallback: section.settings.eyebrow
  endcapture
  if default_eyebrow == blank
    assign default_eyebrow = 'giclee.ui.showcase_eyebrow_default' | t
  endif

  capture default_heading
    render 'giclee-i18n-text', scope: 'sections', id: section.id, field: 'heading', fallback: section.settings.heading
  endcapture
  if default_heading == blank
    assign default_heading = 'giclee.ui.showcase_heading_default' | t
  endif

  capture default_lead
    render 'giclee-i18n-text', scope: 'sections', id: section.id, field: 'lead', fallback: section.settings.lead
  endcapture

  capture cta_label
    render 'giclee-i18n-text', scope: 'sections', id: section.id, field: 'cta_label', fallback: section.settings.cta_label
  endcapture
  if cta_label == blank
    assign cta_label = 'giclee.ui.showcase_cta_default' | t
  endif
  assign enable_artist_nav = section.settings.enable_artist_nav | default: true
  assign enable_scroll_panel = section.settings.enable_scroll_panel | default: true
  assign end_page = true
  if section.settings.end_page == false
    assign end_page = false
  endif

  assign artist_nav_source = section.settings.artist_nav_source | default: 'auto_catalog'
  assign use_manual_blocks = false
  if artist_nav_source == 'manual_blocks'
    assign use_manual_blocks = true
  endif

  assign gacs_hidden_csv = ',francois-boucher,william-bradford,paul-fisher,jean-auguste-ingres,peder-severin-kryer,edmund-blair-leighton,charles-sillem-lidderdale,giordano-luca,anders-andersen-lundby,johan-thomas-lundbye,anton-melbye,jean-francois-millet,claude-monet,thomas-moran,bartolome-esteban-murillo,harmenszoon-van-rijn-rembrandt,guido-reni,aguste-renoir,willem-roelofs,dante-gabriel-rossetti,rachel-ruysch,rafael-santi,alfred-sisley,tycjan-tiziano-vecellio,claude-joseph-vernet,'

  assign artist_block_count = 0
  for block in section.blocks
    if block.type == 'artist'
      assign artist_block_count = artist_block_count | plus: 1
    endif
  endfor

  assign catalog_menu = section.settings.catalog_menu
  if catalog_menu == blank or catalog_menu.links == blank
    assign catalog_menu = linklists['main-menu']
  endif

  assign catalog_parent = blank
  assign catalog_parent_title = section.settings.catalog_menu_parent | default: 'Katalog' | downcase | strip
  if catalog_menu != blank
    for top_link in catalog_menu.links
      assign top_title = top_link.title | downcase | strip
      if catalog_parent_title != blank and top_title contains catalog_parent_title
        assign catalog_parent = top_link
        break
      endif
    endfor
    if catalog_parent == blank
      for top_link in catalog_menu.links
        assign has_nested_collection = false
        for link_l1 in top_link.links
          if link_l1.type == 'collection_link'
            assign has_nested_collection = true
            break
          endif
          for link_l2 in link_l1.links
            if link_l2.type == 'collection_link'
              assign has_nested_collection = true
              break
            endif
          endfor
          if has_nested_collection
            break
          endif
        endfor
        if has_nested_collection
          assign catalog_parent = top_link
          break
        endif
      endfor
    endif
  endif

  assign gacs_artist_handles = '' | split: ','
  assign artist_entries_count = 0
  assign initial_artist_index = 0

  if use_manual_blocks and artist_block_count > 0
    assign artist_match_index = 0
    for block in section.blocks
      if block.type != 'artist'
        continue
      endif
      assign block_col = block.settings.collection
      if block_col == blank or block_col.products_count == 0
        continue
      endif
      assign handle_token = block_col.handle | prepend: ',' | append: ','
      if gacs_hidden_csv contains handle_token
        continue
      endif
      if collection != blank and block_col.handle == collection.handle
        assign initial_artist_index = artist_match_index
      endif
      assign artist_match_index = artist_match_index | plus: 1
    endfor
    assign artist_entries_count = artist_match_index
  else
    assign gacs_seen_handles = ','
    assign gacs_merged_pipe = ''

    if catalog_parent != blank
      for link_l1 in catalog_parent.links
        assign nav_col = blank
        if link_l1.type == 'collection_link'
          assign nav_col = link_l1.object
        elsif link_l1.url contains '/collections/'
          assign url_tail = link_l1.url | split: '/collections/' | last | split: '?' | first | split: '/' | first
          assign nav_col = collections[url_tail]
        endif
        if nav_col != blank
          assign handle_token = nav_col.handle | prepend: ',' | append: ','
          assign seen_token = nav_col.handle | prepend: ',' | append: ','
          unless gacs_hidden_csv contains handle_token or gacs_seen_handles contains seen_token
            assign gacs_seen_handles = gacs_seen_handles | append: nav_col.handle | append: ','
            assign gacs_merged_pipe = gacs_merged_pipe | append: nav_col.handle | append: '|'
          endunless
        endif
        for link_l2 in link_l1.links
          assign nav_col = blank
          if link_l2.type == 'collection_link'
            assign nav_col = link_l2.object
          elsif link_l2.url contains '/collections/'
            assign url_tail = link_l2.url | split: '/collections/' | last | split: '?' | first | split: '/' | first
            assign nav_col = collections[url_tail]
          endif
          if nav_col != blank
            assign handle_token = nav_col.handle | prepend: ',' | append: ','
            assign seen_token = nav_col.handle | prepend: ',' | append: ','
            unless gacs_hidden_csv contains handle_token or gacs_seen_handles contains seen_token
              assign gacs_seen_handles = gacs_seen_handles | append: nav_col.handle | append: ','
              assign gacs_merged_pipe = gacs_merged_pipe | append: nav_col.handle | append: '|'
            endunless
          endif
          for link_l3 in link_l2.links
            assign nav_col = blank
            if link_l3.type == 'collection_link'
              assign nav_col = link_l3.object
            elsif link_l3.url contains '/collections/'
              assign url_tail = link_l3.url | split: '/collections/' | last | split: '?' | first | split: '/' | first
              assign nav_col = collections[url_tail]
            endif
            if nav_col != blank
              assign handle_token = nav_col.handle | prepend: ',' | append: ','
              assign seen_token = nav_col.handle | prepend: ',' | append: ','
              unless gacs_hidden_csv contains handle_token or gacs_seen_handles contains seen_token
                assign gacs_seen_handles = gacs_seen_handles | append: nav_col.handle | append: ','
                assign gacs_merged_pipe = gacs_merged_pipe | append: nav_col.handle | append: '|'
              endunless
            endif
          endfor
        endfor
      endfor
    endif

    for nav_col in collections
      if nav_col.handle == 'all' or nav_col.handle == 'frontpage'
        continue
      endif
      assign handle_token = nav_col.handle | prepend: ',' | append: ','
      if gacs_hidden_csv contains handle_token
        continue
      endif
      assign seen_token = nav_col.handle | prepend: ',' | append: ','
      if gacs_seen_handles contains seen_token
        continue
      endif
      assign gacs_seen_handles = gacs_seen_handles | append: nav_col.handle | append: ','
      assign gacs_merged_pipe = gacs_merged_pipe | append: nav_col.handle | append: '|'
    endfor

    assign gacs_artist_handles = gacs_merged_pipe | split: '|'

    assign artist_match_index = 0
    assign initial_artist_index = 0
    for artist_handle in gacs_artist_handles
      if artist_handle == blank
        continue
      endif
      if collection != blank and artist_handle == collection.handle
        assign initial_artist_index = artist_match_index
      endif
      assign artist_match_index = artist_match_index | plus: 1
    endfor
    assign artist_entries_count = artist_match_index
  endif

  assign showcase_collection = blank
  assign artist_name = blank
  assign heading = blank
  assign lead = blank

  if use_manual_blocks and artist_block_count > 0
    assign artist_match_index = 0
    for block in section.blocks
      if block.type != 'artist'
        continue
      endif
      assign block_col = block.settings.collection
      if block_col == blank or block_col.products_count == 0
        continue
      endif
      assign handle_token = block_col.handle | prepend: ',' | append: ','
      if gacs_hidden_csv contains handle_token
        continue
      endif
      if artist_match_index == initial_artist_index
        assign showcase_collection = block_col
        assign artist_name = block.settings.artist_name
        assign heading = block.settings.heading
        assign lead = block.settings.lead
        break
      endif
      assign artist_match_index = artist_match_index | plus: 1
    endfor
  elsif artist_entries_count > 0
    assign artist_match_index = 0
    for artist_handle in gacs_artist_handles
      if artist_handle == blank
        continue
      endif
      assign nav_col = collections[artist_handle]
      if nav_col == blank
        continue
      endif
      if artist_match_index == initial_artist_index
        assign showcase_collection = nav_col
        break
      endif
      assign artist_match_index = artist_match_index | plus: 1
    endfor
  else
    assign showcase_collection = section.settings.collection
    if showcase_collection == blank and collection != blank
      assign showcase_collection = collection
    endif
    assign artist_name = section.settings.artist_name
    assign heading = section.settings.heading
    assign lead = section.settings.lead
    assign artist_entries_count = 1
    assign initial_artist_index = 0
  endif

  assign collection_title = showcase_collection.title | default: default_heading
  if artist_name == blank
    assign artist_name = collection_title
  endif
  capture artist_name
    render 'giclee-artist-catalog-name', name: artist_name
  endcapture
  assign artist_name = artist_name | strip
  assign eyebrow = artist_name
  if eyebrow == blank
    assign eyebrow = default_eyebrow
  endif
  if heading == blank
    assign heading = default_heading
  endif
  if heading == blank
    assign heading = collection_title
  endif
  if lead == blank
    assign lead = default_lead
  endif

  if section.settings.heading != blank
    capture i18n_section_heading
      render 'giclee-i18n-text', scope: 'sections', id: section.id, field: 'heading', fallback: section.settings.heading
    endcapture
    if heading == blank or heading == section.settings.heading
      assign heading = i18n_section_heading
    endif
  endif
  if section.settings.lead != blank
    capture i18n_section_lead
      render 'giclee-i18n-text', scope: 'sections', id: section.id, field: 'lead', fallback: section.settings.lead
    endcapture
    if lead == blank or lead == section.settings.lead
      assign lead = i18n_section_lead
    endif
  endif

  assign cta_link = section.settings.cta_link
  if cta_link == blank and showcase_collection != blank
    assign cta_link = showcase_collection.url
  endif

  assign showcase_collection_quote = ''
  assign showcase_collection_quotes_json = '[]'
  assign showcase_has_quotes = false
  if showcase_collection != blank
    assign showcase_quotes_mf = showcase_collection.metafields.custom.collection_quotes
    if showcase_quotes_mf != blank and showcase_quotes_mf.value != blank
      assign showcase_collection_quotes_json = showcase_quotes_mf.value | json
      assign showcase_has_quotes = true
      if showcase_quotes_mf.value.first != blank
        assign showcase_collection_quote = showcase_quotes_mf.value.first
      endif
    endif
    if showcase_collection_quote == blank
      assign showcase_quote_mf = showcase_collection.metafields.custom.collection_quote
      if showcase_quote_mf != blank
        assign showcase_collection_quote = showcase_quote_mf.value | default: showcase_quote_mf
        assign showcase_collection_quotes_json = showcase_collection_quote | json | prepend: '[' | append: ']'
        assign showcase_has_quotes = true
      endif
    endif
  endif

  assign show_artist_nav = false
  if enable_artist_nav and artist_entries_count > 1
    assign show_artist_nav = true
  endif

  assign use_artist_json = show_artist_nav
  assign prev_artist_index = initial_artist_index | minus: 1
  assign next_artist_index = initial_artist_index | plus: 1
  assign prev_artist_name = ''
  assign next_artist_name = ''
  if show_artist_nav and prev_artist_index >= 0
    assign prev_handle = gacs_artist_handles[prev_artist_index]
    if prev_handle != blank
      assign prev_col = collections[prev_handle]
      if prev_col != blank
        assign prev_artist_name = prev_col.title
        capture prev_artist_name
          render 'giclee-artist-catalog-name', name: prev_artist_name
        endcapture
        assign prev_artist_name = prev_artist_name | strip
      endif
    endif
  endif
  if show_artist_nav and next_artist_index < artist_entries_count
    assign next_handle = gacs_artist_handles[next_artist_index]
    if next_handle != blank
      assign next_col = collections[next_handle]
      if next_col != blank
        assign next_artist_name = next_col.title
        capture next_artist_name
          render 'giclee-artist-catalog-name', name: next_artist_name
        endcapture
        assign next_artist_name = next_artist_name | strip
      endif
    endif
  endif
-%}

<link
  rel="stylesheet"
  href="{{ 'giclee-artist-collection-showcase.css' | asset_url }}?v=gacs-seam-fix-20260628"
>
<link
  rel="stylesheet"
  href="{{ 'giclee-showcase-slide-overlays.css' | asset_url }}?v=gacs-overlay-v14-20260628"
>
<link
  rel="stylesheet"
  href="{{ 'giclee-artist-biography.css' | asset_url }}&gab=gab-text-header-sync-20260628"
>
<script
  src="{{ 'giclee-active-author.js' | asset_url }}?v=gacs-artist-name-v49-20260622"
  defer
></script>
<script
  src="{{ 'giclee-artist-biography.js' | asset_url }}?v=gab-bg-reveal-20260701"
  defer
></script>
<script
  src="{{ 'giclee-carousel-config.js' | asset_url }}&v=karuzela-config-v1-20260628"
  defer
></script>
<script>
  window.__GICLEE_KARUZELA_ASSETS = {
    karuzela1: {{ 'giclee-karuzela1.js' | asset_url | json }},
    karuzela2: {{ 'giclee-karuzela2.js' | asset_url | json }},
    karuzela2Css: {{ 'giclee-karuzela2.css' | asset_url | json }}
  };
</script>
<script
  src="{{ 'giclee-karuzela.js' | asset_url }}&v=karuzela-router-v13-bg-nzoom-20260628"
  defer
></script>
<script
  src="{{ 'giclee-showcase-slide-overlays.js' | asset_url }}?v=gacs-overlay-v13-unseen-20260628"
  defer
></script>

{%- if end_page -%}
  <style>
    #shopify-section-{{ section.id }} {
      flex-grow: 0 !important;
      flex-shrink: 0;
      align-self: flex-start;
      width: 100%;
      min-height: 0 !important;
    }

    #shopify-section-{{ section.id }} > .section-background {
      display: none;
    }

    body:has(#shopify-section-{{ section.id }}) {
      min-height: auto !important;
    }

    body:has(#shopify-section-{{ section.id }}) main.content-for-layout {
      flex: 0 0 auto !important;
      min-height: 0 !important;
    }

    body:has(#shopify-section-{{ section.id }}) footer {
      display: none !important;
    }
  </style>
{%- endif -%}

{%- if enable_scroll_panel -%}
<link
  rel="stylesheet"
  href="{{ 'giclee-bio-collection-scroll-stack.css' | asset_url }}&v=bio-seam-fix-20260701"
>
{%- endif -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<section
  class="giclee-artist-showcase giclee-artist-showcase--{{ layout_mode }} color-{{ section.settings.color_scheme }}{% if end_page %} gacs-end-page{% endif %}{% if show_artist_nav %} giclee-artist-showcase--multi-artist{% endif %}"
  data-giclee-artist-showcase
  data-gacs-exhibition
  data-layout="{{ layout_mode }}"
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-ms="{{ section.settings.autoplay_interval | times: 1000 }}"
  data-artist-index="{{ initial_artist_index }}"
  data-artist-count="{{ artist_entries_count }}"
  data-show-cta="{{ section.settings.show_cta }}"
  data-cta-label="{{ cta_label | escape }}"
  data-gacs-fixed-lead="{{ default_lead | escape }}"
  data-max-products="{{ max_products }}"
  aria-label="{{ artist_name | escape }}"
  {{ section.shopify_attributes }}
>
  {%- if use_artist_json -%}
    <script type="application/json" data-gacs-artists-json>
      [
      {%- assign artist_json_i = 0 -%}
      {%- if use_manual_blocks and artist_block_count > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'artist' -%}{%- continue -%}{%- endif -%}
          {%- assign block_col = block.settings.collection -%}
          {%- if block_col == blank or block_col.products_count == 0 -%}{%- continue -%}{%- endif -%}
          {%- assign handle_token = block_col.handle | prepend: ',' | append: ',' -%}
          {%- if gacs_hidden_csv contains handle_token -%}{%- continue -%}{%- endif -%}
          {%- render 'giclee-artist-showcase-artist-json',
            artist_col: block_col,
            artist_name_override: block.settings.artist_name,
            artist_heading_override: block.settings.heading,
            artist_lead_override: block.settings.lead,
            artist_preview_override: block.settings.preview_image,
            artist_entry_id: block.id,
            max_products: max_products,
            default_eyebrow: default_eyebrow,
            default_heading: default_heading,
            default_lead: default_lead
          -%}
          {%- assign artist_json_i = artist_json_i | plus: 1 -%}
          {%- if artist_json_i < artist_entries_count -%},{%- endif -%}
        {%- endfor -%}
      {%- elsif artist_entries_count > 0 -%}
        {%- for artist_handle in gacs_artist_handles -%}
          {%- if artist_handle == blank -%}{%- continue -%}{%- endif -%}
          {%- assign nav_col = collections[artist_handle] -%}
          {%- if nav_col == blank -%}{%- continue -%}{%- endif -%}
          {%- render 'giclee-artist-showcase-artist-json',
            artist_col: nav_col,
            artist_name_override: '',
            artist_heading_override: '',
            artist_lead_override: '',
            artist_preview_override: blank,
            artist_entry_id: nav_col.id,
            max_products: max_products,
            default_eyebrow: default_eyebrow,
            default_heading: default_heading,
            default_lead: default_lead
          -%}
          {%- assign artist_json_i = artist_json_i | plus: 1 -%}
          {%- if artist_json_i < artist_entries_count -%},{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      ]
    </script>
  {%- endif -%}

  <div class="giclee-artist-showcase__inner">
    <div class="giclee-artist-showcase__header-row{% unless show_artist_nav %} giclee-artist-showcase__header-row--solo{% endunless %}">
      {%- if show_artist_nav -%}
        <button
          type="button"
          class="giclee-artist-showcase__artist-nav giclee-artist-showcase__artist-nav--prev"
          data-gacs-artist-nav="prev"
          aria-label="{{ 'giclee.ui.showcase_prev_artist' | t }}"
          {% if initial_artist_index <= 0 %}hidden disabled{% endif %}
        >
          <span class="giclee-artist-showcase__artist-nav-label">← {{ 'giclee.ui.showcase_prev_artist' | t }}</span>
          <span class="giclee-artist-showcase__artist-nav-name" data-gacs-artist-nav-name>{{ prev_artist_name | escape }}</span>
          <span class="giclee-artist-showcase__artist-nav-preview" data-gacs-artist-nav-preview aria-hidden="true"></span>
        </button>
      {%- endif -%}

      <div class="giclee-artist-showcase__exhibition-content" data-gacs-exhibition-content>
        <header class="giclee-artist-showcase__header">
          {%- if eyebrow != blank -%}
            <span class="giclee-artist-showcase__eyebrow" data-gacs-field="eyebrow">{{ eyebrow | escape }}</span>
          {%- endif -%}
          {%- if heading != blank -%}
            <h2 class="giclee-artist-showcase__title" data-gacs-field="heading">{{ heading | escape }}</h2>
          {%- endif -%}
          {%- if lead != blank -%}
            <p class="giclee-artist-showcase__lead" data-gacs-field="lead">{{ lead | escape }}</p>
          {%- endif -%}
          {%- if section.settings.show_cta and cta_link != blank and cta_label != blank -%}
            <a class="giclee-artist-showcase__cta" data-gacs-field="cta" href="{{ cta_link }}">{{ cta_label | escape }}</a>
          {%- else -%}
            <span class="giclee-artist-showcase__cta-spacer" aria-hidden="true"></span>
          {%- endif -%}
        </header>
      </div>

      {%- if show_artist_nav -%}
        <button
          type="button"
          class="giclee-artist-showcase__artist-nav giclee-artist-showcase__artist-nav--next"
          data-gacs-artist-nav="next"
          aria-label="{{ 'giclee.ui.showcase_next_artist' | t }}"
          {% if next_artist_index >= artist_entries_count %}hidden disabled{% endif %}
        >
          <span class="giclee-artist-showcase__artist-nav-label">{{ 'giclee.ui.showcase_next_artist' | t }} →</span>
          <span class="giclee-artist-showcase__artist-nav-name" data-gacs-artist-nav-name>{{ next_artist_name | escape }}</span>
          <span class="giclee-artist-showcase__artist-nav-preview" data-gacs-artist-nav-preview aria-hidden="true"></span>
        </button>
      {%- endif -%}
    </div>

    <div class="giclee-artist-showcase__exhibition-content giclee-artist-showcase__exhibition-content--stage" data-gacs-exhibition-content>
      <div class="giclee-artist-showcase__stage">
        {%- if layout_mode == 'coverflow' -%}
          <button
            type="button"
            class="giclee-artist-showcase__nav giclee-artist-showcase__nav--prev"
            aria-label="{{ 'giclee.ui.showcase_prev_work' | t }}"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}

        <div
          class="giclee-artist-showcase__viewport"
          tabindex="0"
          role="region"
          aria-roledescription="karuzela"
          aria-label="{{ 'giclee.ui.showcase_gallery' | t }}"
        >
          <div class="giclee-artist-showcase__track" data-gacs-track>
            {%- render 'giclee-artist-showcase-track',
              collection: showcase_collection,
              max_products: max_products
            -%}
          </div>
        </div>

        {%- if layout_mode == 'coverflow' -%}
          <button
            type="button"
            class="giclee-artist-showcase__nav giclee-artist-showcase__nav--next"
            aria-label="{{ 'giclee.ui.showcase_next_work' | t }}"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}
      </div>

      {%- if layout_mode == 'coverflow' -%}
        <div class="giclee-artist-showcase__dots" role="tablist" aria-label="{{ 'giclee.ui.showcase_gallery_nav' | t }}"></div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Dekoracyjna warstwa tekstowa — nie wpływa na layout karuzeli. {%- endcomment -%}
  <div
    class="giclee-showcase-overlay"
    data-gacs-showcase-overlay
    data-gacs-quote-author="{{ artist_name | escape }}"
    {% if showcase_has_quotes %}
      data-gacs-collection-quotes="{{ showcase_collection_quotes_json | escape }}"
    {% endif %}
    {% if showcase_collection_quote != blank %}
      data-gacs-collection-quote="{{ showcase_collection_quote | escape }}"
    {% endif %}
    hidden
  >
    <div class="giclee-showcase-overlay__meta" data-gacs-overlay-meta hidden>
      <p class="giclee-showcase-overlay__meta-line" data-gacs-overlay-date></p>
      <p class="giclee-showcase-overlay__meta-line" data-gacs-overlay-technique></p>
      <p class="giclee-showcase-overlay__meta-line" data-gacs-overlay-genre></p>
    </div>
    <div
      class="carousel-quote"
      data-gacs-overlay-quote
      {% unless showcase_has_quotes %}hidden{% endunless %}
    >
      <span class="carousel-quote__mark" aria-hidden="true">
        <svg viewBox="0 0 30 18" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M10.1 2.4C7.1 3.9 5.1 6.4 5.1 9.4c0 2.9 1.8 4.9 4.4 4.9 2.2 0 3.7-1.45 3.7-3.45 0-1.85-1.25-3.05-3.05-3.05-.55 0-1.05.1-1.5.32.38-1.42 1.55-2.7 3.35-3.78L10.1 2.4Z"
            fill="currentColor"
          />
          <path
            d="M22.5 2.4c-3 1.5-5 4-5 7 0 2.9 1.8 4.9 4.4 4.9 2.2 0 3.7-1.45 3.7-3.45 0-1.85-1.25-3.05-3.05-3.05-.55 0-1.05.1-1.5.32.38-1.42 1.55-2.7 3.35-3.78L22.5 2.4Z"
            fill="currentColor"
          />
        </svg>
      </span>
      <p class="carousel-quote__text" data-gacs-overlay-quote-text></p>
      <p class="carousel-quote__author" data-gacs-overlay-quote-author{% unless showcase_has_quotes and artist_name != blank %} hidden{% endunless %}>
        {%- if showcase_has_quotes and artist_name != blank -%}— {{ artist_name | escape }}{%- endif -%}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kolekcja autora — galeria",
  "tag": "section",
  "class": "giclee-artist-collection-showcase-section collection-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Kolekcja (legacy)",
      "info": "Używane gdy brak bloków autorów poniżej. Na stronie kolekcji: bieżąca kolekcja."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Liczba dzieł",
      "min": 3,
      "max": 50,
      "step": 1,
      "default": 50,
      "info": "Shopify zwraca do 50 produktów w Liquid i products.json. Największa kolekcja w sklepie: ok. 40 dzieł."
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Układ",
      "options": [
        {
          "value": "coverflow",
          "label": "3D coverflow (wow)"
        },
        {
          "value": "editorial",
          "label": "Editorial — siatka muzealna"
        }
      ],
      "default": "coverflow"
    },
    {
      "type": "header",
      "content": "Nagłówek sekcji (domyślnie)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etykieta (zapasowa)",
      "info": "Domyślnie wyświetlana jest nazwa autora z kolekcji. To pole tylko gdy nazwy brak.",
      "default": "Kolekcja autora"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Tytuł",
      "info": "Puste = „Wybrane dzieła” lub tytuł kolekcji"
    },
    {
      "type": "text",
      "id": "artist_name",
      "label": "Nazwa artysty (legacy)",
      "info": "Gdy brak bloków autorów"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Opis pod tytułem",
      "default": "Reprodukcji fine art — z kolekcji © Giclée Art — Restoration Edition 2026",
      "info": "Stały tekst pod „Wybrane dzieła” — ten sam dla wszystkich autorów (nie opis kolekcji Shopify)."
    },
    {
      "type": "header",
      "content": "Nawigacja między autorami"
    },
    {
      "type": "select",
      "id": "artist_nav_source",
      "label": "Źródło listy autorów",
      "options": [
        {
          "value": "auto_catalog",
          "label": "Automatycznie z menu Katalog"
        },
        {
          "value": "manual_blocks",
          "label": "Ręczne bloki poniżej"
        }
      ],
      "default": "auto_catalog",
      "info": "Domyślnie: wszystkie kolekcje z podmenu Katalog (jak w nawigacji sklepu), bez ukrytych autorów."
    },
    {
      "type": "link_list",
      "id": "catalog_menu",
      "label": "Menu nawigacji",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "catalog_menu_parent",
      "label": "Pozycja menu z autorami",
      "default": "Katalog",
      "info": "Nazwa pozycji z podlinkowanymi kolekcjami (domyślnie Katalog)."
    },
    {
      "type": "checkbox",
      "id": "enable_artist_nav",
      "label": "Włącz nawigację między autorami",
      "default": true
    },
    {
      "type": "header",
      "content": "Przycisk CTA"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Pokaż przycisk CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Tekst przycisku CTA",
      "default": "Zobacz całą kolekcję"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link CTA",
      "info": "Puste = URL wybranej kolekcji"
    },
    {
      "type": "header",
      "content": "Panel ekspozycyjny (scroll)"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll_panel",
      "label": "Wysuwany panel nad poprzednią sekcją",
      "info": "Galeria nachodzi na treść nad nią i przykrywa nagłówek podczas przewijania.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "end_page",
      "label": "Galeria kończy stronę",
      "info": "Usuwa pustą przestrzeń pod galerią i ukrywa stopkę.",
      "default": true
    },
    {
      "type": "header",
      "content": "Karuzela"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Autoplay (coverflow)",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Interwał autoplay (s)",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 7
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schemat kolorów",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "artist",
      "name": "Autor / kolekcja",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Kolekcja autora"
        },
        {
          "type": "text",
          "id": "artist_name",
          "label": "Nazwa autora",
          "info": "Puste = tytuł kolekcji"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Tytuł ekspozycji",
          "info": "Puste = domyślny tytuł sekcji"
        },
        {
          "type": "textarea",
          "id": "lead",
          "label": "Opis ekspozycji",
          "info": "Puste = opis kolekcji Shopify"
        },
        {
          "type": "image_picker",
          "id": "preview_image",
          "label": "Miniatura nawigacji",
          "info": "Opcjonalnie — hover „Poprzedni/Następny autor”. Puste = pierwsze dzieło."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kolekcja autora — galeria",
      "settings": {
        "layout_mode": "coverflow",
        "eyebrow": "Kolekcja autora",
        "heading": "Wybrane dzieła",
        "lead": "Kuratorski wybór reprodukcji fine art — prezentacja jak w galerii, nie w sklepie.",
        "cta_label": "Zobacz całą kolekcję"
      }
    }
  ]
}
{% endschema %}
