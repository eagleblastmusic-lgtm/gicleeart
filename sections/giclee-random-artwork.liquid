{%- liquid
  assign pool_limit = section.settings.pool_limit | default: 50
  assign pool_collection = section.settings.pool_collection
  if pool_collection == blank
    assign pool_collection = collections.all
  endif
  assign fetch_full = section.settings.fetch_full_pool
  assign enable_webgl = section.settings.enable_webgl
  if section.settings.enable_webgl == nil
    assign enable_webgl = true
  endif
  assign design_variant = section.settings.design_variant | default: 'v1'
  assign enable_atmosphere = false
  assign enable_living_museum = false
  if design_variant == 'v2'
    assign enable_atmosphere = true
  elsif design_variant == 'v3'
    assign enable_living_museum = true
  endif
  assign atmosphere_intensity = section.settings.atmosphere_intensity | default: 35
  assign atmosphere_glow_size = section.settings.atmosphere_glow_size | default: 100
  assign atmosphere_glow_response = section.settings.atmosphere_glow_response | default: 50
  assign atmosphere_haze = section.settings.atmosphere_haze | default: 100
  assign atmosphere_haze_speed = section.settings.atmosphere_haze_speed | default: 100
  assign atmosphere_dust = section.settings.atmosphere_dust | default: 25
  assign atmosphere_dust_amount = section.settings.atmosphere_dust_amount | default: 50
  assign atmosphere_dust_speed = section.settings.atmosphere_dust_speed | default: 100
  assign living_light_enabled = section.settings.living_light_enabled
  if section.settings.living_light_enabled == nil
    assign living_light_enabled = true
  endif
  assign living_dust_enabled = section.settings.living_dust_enabled
  if section.settings.living_dust_enabled == nil
    assign living_dust_enabled = true
  endif
  assign living_light_intensity = section.settings.living_light_intensity | default: 45
  assign living_dust_particles = section.settings.living_dust_particles | default: 120
  assign living_dust_opacity = section.settings.living_dust_opacity | default: 115
  assign living_dust_size = section.settings.living_dust_size | default: 125
  assign living_dust_speed = section.settings.living_dust_speed | default: 75
  assign living_dust_fps = section.settings.living_dust_fps | default: 24
  assign living_dust_dpr_cap = section.settings.living_dust_dpr_cap | default: 125
  assign custom_bg = 'none'
  if section.settings.background_video != blank
    assign custom_bg = 'video'
  elsif section.settings.background_image != blank
    assign custom_bg = 'image'
  endif
-%}

<link
  rel="stylesheet"
  href="{{ 'giclee-random-artwork.css' | asset_url }}?v=grw-living-museum-dust-controls-20260721"
>
{%- if enable_atmosphere -%}
  <link
    rel="stylesheet"
    href="{{ 'giclee-random-artwork-atmosphere.css' | asset_url }}?v=grw-museum-atmosphere-controls-20260721"
  >
  <script
    src="{{ 'giclee-random-artwork-atmosphere.js' | asset_url }}?v=grw-museum-atmosphere-controls-20260721"
    defer
  ></script>
{%- elsif enable_living_museum -%}
  <link
    rel="stylesheet"
    href="{{ 'giclee-random-artwork-living-museum.css' | asset_url }}?v=grw-living-museum-dust-controls-20260721"
  >
  <script
    src="{{ 'giclee-random-artwork-living-museum.js' | asset_url }}?v=grw-living-museum-dust-controls-20260721"
    defer
  ></script>
{%- endif -%}
<script
  src="{{ 'giclee-random-artwork.js' | asset_url }}?v=grw-living-museum-dust-controls-20260721"
  defer
></script>

<giclee-random-artwork
  class="giclee-random-artwork color-{{ section.settings.color_scheme }}{% if custom_bg != 'none' %} grw--custom-bg grw--custom-bg-{{ custom_bg }}{% endif %}"
  data-state="idle"
  data-design-variant="{{ design_variant }}"
  data-root-url="{{ routes.root_url }}"
  data-products-endpoint="{{ routes.root_url }}/collections/all/products.json"
  data-fetch-full="{% if fetch_full %}true{% else %}false{% endif %}"
  data-enable-webgl="{% if enable_webgl %}true{% else %}false{% endif %}"
  data-atmosphere-enabled="{% if enable_atmosphere %}true{% else %}false{% endif %}"
  data-atmosphere-intensity="{{ atmosphere_intensity }}"
  data-atmosphere-glow-size="{{ atmosphere_glow_size }}"
  data-atmosphere-glow-response="{{ atmosphere_glow_response }}"
  data-atmosphere-haze="{{ atmosphere_haze }}"
  data-atmosphere-haze-speed="{{ atmosphere_haze_speed }}"
  data-atmosphere-dust="{{ atmosphere_dust }}"
  data-atmosphere-dust-amount="{{ atmosphere_dust_amount }}"
  data-atmosphere-dust-speed="{{ atmosphere_dust_speed }}"
  data-living-light-enabled="{% if living_light_enabled %}true{% else %}false{% endif %}"
  data-living-dust-enabled="{% if living_dust_enabled %}true{% else %}false{% endif %}"
  data-living-light-intensity="{{ living_light_intensity }}"
  data-living-dust-particles="{{ living_dust_particles }}"
  data-living-dust-opacity="{{ living_dust_opacity }}"
  data-living-dust-size="{{ living_dust_size }}"
  data-living-dust-speed="{{ living_dust_speed }}"
  data-living-dust-fps="{{ living_dust_fps }}"
  data-living-dust-dpr-cap="{{ living_dust_dpr_cap }}"
  data-webgl-url="{{ 'giclee-random-artwork-webgl.js' | asset_url }}"
  data-three-url="{{ 'three.module.js' | asset_url }}"
  data-phase-1="{{ section.settings.loading_text | escape }}"
  data-phase-2="{{ section.settings.phase_text_2 | escape }}"
  data-phase-3="{{ section.settings.phase_text_3 | escape }}"
  {{ section.shopify_attributes }}
>
  <script type="application/json" data-grw-pool>
    {%- render 'giclee-random-artwork-pool', pool_collection: pool_collection, pool_limit: pool_limit -%}
  </script>

  <div class="giclee-random-artwork__scene" data-grw-scene>
    {%- comment -%} Wlasne tlo uzytkownika (obraz lub film) — pod warstwami dekoracyjnymi {%- endcomment -%}
    {%- if custom_bg != 'none' -%}
      <div
        class="giclee-random-artwork__custom-bg{% if section.settings.background_parallax %} grw--custom-bg-parallax{% endif %}"
        data-grw-custom-bg
        aria-hidden="true"
      >
        <div class="giclee-random-artwork__custom-bg-layers">
          {%- render 'background-media',
            background_media: custom_bg,
            background_image: section.settings.background_image,
            background_image_position: 'cover',
            background_image_object_y: section.settings.background_image_object_y,
            background_video: section.settings.background_video,
            background_video_position: 'cover',
            section: section
          -%}
        </div>
      </div>
    {%- endif -%}

    <div class="giclee-random-artwork__bg" aria-hidden="true">
      <span class="giclee-random-artwork__bg-aurora"></span>
      <span class="giclee-random-artwork__bg-beams"></span>
      <span class="giclee-random-artwork__bg-grain"></span>
      <span class="giclee-random-artwork__bg-vignette"></span>
    </div>

    {%- if enable_living_museum -%}
      <div class="giclee-random-artwork__living-museum" data-grw-living-museum aria-hidden="true">
        <span class="giclee-random-artwork__living-spotlight" data-grw-living-spotlight></span>
        <canvas class="giclee-random-artwork__living-dust" data-grw-living-dust></canvas>
        <span class="giclee-random-artwork__living-vignette"></span>
      </div>
    {%- endif -%}

    <div class="giclee-random-artwork__canvas" data-grw-canvas-mount aria-hidden="true"></div>

    {%- if enable_atmosphere -%}
      <div class="giclee-random-artwork__atmosphere" data-grw-atmosphere aria-hidden="true">
        <span class="giclee-random-artwork__atmosphere-haze giclee-random-artwork__atmosphere-haze--gallery"></span>
        <span class="giclee-random-artwork__atmosphere-haze giclee-random-artwork__atmosphere-haze--depth"></span>
        <span class="giclee-random-artwork__atmosphere-glow" data-grw-atmosphere-glow></span>
        <canvas class="giclee-random-artwork__atmosphere-dust" data-grw-atmosphere-dust></canvas>
      </div>
    {%- endif -%}

    <div class="giclee-random-artwork__portal" data-grw-portal aria-hidden="true">
      <span class="giclee-random-artwork__portal-halo"></span>
      <span class="giclee-random-artwork__portal-ring giclee-random-artwork__portal-ring--outer"></span>
      <span class="giclee-random-artwork__portal-ring giclee-random-artwork__portal-ring--inner"></span>
      <span class="giclee-random-artwork__portal-core"></span>
    </div>

    <div class="giclee-random-artwork__content">
      <header class="giclee-random-artwork__intro" data-grw-intro>
        {%- if section.settings.eyebrow != blank -%}
          <span class="giclee-random-artwork__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="giclee-random-artwork__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="giclee-random-artwork__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
        <button type="button" class="giclee-random-artwork__draw" data-grw-draw>
          <span class="giclee-random-artwork__draw-glow" aria-hidden="true"></span>
          <span class="giclee-random-artwork__draw-label">{{ section.settings.button_label | escape }}</span>
        </button>
      </header>

      <div class="giclee-random-artwork__phase" data-grw-phase-wrap aria-live="polite">
        <span class="giclee-random-artwork__phase-text" data-grw-phase>{{ section.settings.loading_text | escape }}</span>
      </div>

      <div class="giclee-random-artwork__result" data-grw-result hidden>
        <span class="giclee-random-artwork__result-eyebrow">{{ section.settings.result_heading | escape }}</span>
        <a class="giclee-random-artwork__frame" data-grw-result-link href="#">
          <span class="giclee-random-artwork__frame-glow" aria-hidden="true"></span>
          <span class="giclee-random-artwork__frame-mat">
            <img
              class="giclee-random-artwork__result-image"
              data-grw-result-image
              src=""
              alt=""
              loading="lazy"
              decoding="async"
            >
          </span>
        </a>
        <div class="giclee-random-artwork__plaque">
          <span class="giclee-random-artwork__result-artist" data-grw-result-artist hidden></span>
          <h2 class="giclee-random-artwork__result-title">
            <span data-grw-result-title></span><span class="giclee-random-artwork__result-year" data-grw-result-year hidden></span>
          </h2>
        </div>
        <div class="giclee-random-artwork__actions">
          <a class="giclee-random-artwork__cta giclee-random-artwork__cta--primary" data-grw-view href="#">
            {{ section.settings.view_label | escape }}
          </a>
          <button type="button" class="giclee-random-artwork__cta giclee-random-artwork__cta--ghost" data-grw-replay>
            {{ section.settings.replay_label | escape }}
          </button>
        </div>
      </div>

      <div class="giclee-random-artwork__error" data-grw-error hidden role="alert">
        <p class="giclee-random-artwork__error-text">{{ section.settings.error_text | escape }}</p>
        <button type="button" class="giclee-random-artwork__cta giclee-random-artwork__cta--ghost" data-grw-retry>
          {{ section.settings.retry_label | escape }}
        </button>
      </div>
    </div>
  </div>
</giclee-random-artwork>

{% schema %}
{
  "name": "Losuj Obraz — oracle",
  "tag": "section",
  "class": "giclee-random-artwork-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Tresci" },
    { "type": "text", "id": "eyebrow", "label": "Etykieta nad tytulem", "default": "Fine Art Oracle" },
    { "type": "text", "id": "heading", "label": "Naglowek", "default": "Niech sztuka wybierze Ciebie" },
    { "type": "textarea", "id": "subtitle", "label": "Podtytul", "default": "Kliknij i odkryj losowo wybrane dzielo z naszej kolekcji — byc moze wlasnie ono mialo trafic do Twojego wnetrza." },
    { "type": "text", "id": "button_label", "label": "Przycisk glowny", "default": "Losuj obraz" },
    { "type": "header", "content": "Teksty fazy losowania" },
    { "type": "text", "id": "loading_text", "label": "Tekst 1 (ladowanie)", "default": "Przeszukuje kolekcje…" },
    { "type": "text", "id": "phase_text_2", "label": "Tekst 2", "default": "Obrazy zaczynaja mowic…" },
    { "type": "text", "id": "phase_text_3", "label": "Tekst 3", "default": "Jedno dzielo przyciaga wzrok…" },
    { "type": "header", "content": "Wynik" },
    { "type": "text", "id": "result_heading", "label": "Naglowek wyniku", "default": "Wybrany obraz" },
    { "type": "text", "id": "view_label", "label": "CTA — zobacz obraz", "default": "Zobacz obraz" },
    { "type": "text", "id": "replay_label", "label": "CTA — wylosuj ponownie", "default": "Wylosuj ponownie" },
    { "type": "header", "content": "Stan bledu" },
    { "type": "text", "id": "error_text", "label": "Komunikat bledu", "default": "Nie udalo sie wczytac kolekcji. Sprobuj ponownie." },
    { "type": "text", "id": "retry_label", "label": "CTA — ponow", "default": "Sprobuj ponownie" },
    { "type": "header", "content": "Pula produktow" },
    { "type": "collection", "id": "pool_collection", "label": "Kolekcja zrodlowa", "info": "Puste = wszystkie produkty (collections/all)." },
    { "type": "range", "id": "pool_limit", "label": "Startowa pula z Liquid", "min": 6, "max": 50, "step": 1, "default": 50, "info": "Shopify zwraca maks. 50 produktow w Liquid. Pelna pula doczytywana jest po stronie klienta." },
    { "type": "checkbox", "id": "fetch_full_pool", "label": "Doczytaj pelna pule (AJAX)", "default": true, "info": "Pobiera wszystkie opublikowane produkty z /collections/all/products.json." },
    { "type": "header", "content": "Wlasne tlo" },
    { "type": "paragraph", "content": "Film ma pierwszenstwo przed obrazem. Puste pola = domyslna scena (aurora + WebGL)." },
    { "type": "image_picker", "id": "background_image", "label": "Obraz tla" },
    { "type": "video", "id": "background_video", "label": "Film / animacja tla" },
    { "type": "checkbox", "id": "background_parallax", "label": "Parallax tla (mysz)", "default": false, "info": "Subtelny ruch obrazu lub filmu w tle przy ruszaniu kursorem." },
    { "type": "header", "content": "Wariant designu" },
    {
      "type": "select",
      "id": "design_variant",
      "label": "Wariant",
      "options": [
        { "value": "v1", "label": "V1 — podstawowa" },
        { "value": "v2", "label": "V2 — atmosfera muzealna" },
        { "value": "v3", "label": "V3 — Living Museum Light" }
      ],
      "default": "v1",
      "info": "V1 to baza. V2 dodaje edytowalna atmosfere. V3 choreografuje reflektor, pyl, WebGL i swiatlo wyniku."
    },
    { "type": "paragraph", "content": "Parametry V2 sa dostepne w Giclee App przez Edytuj atmosfere." },
    { "type": "range", "id": "atmosphere_intensity", "label": "V2 — glow: intensywnosc", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 35 },
    { "type": "range", "id": "atmosphere_glow_size", "label": "V2 — glow: rozmiar", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "atmosphere_glow_response", "label": "V2 — glow: responsywnosc", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "atmosphere_haze", "label": "V2 — mgielka: intensywnosc", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "atmosphere_haze_speed", "label": "V2 — mgielka: szybkosc", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "range", "id": "atmosphere_dust", "label": "V2 — pyl: widocznosc", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 25 },
    { "type": "range", "id": "atmosphere_dust_amount", "label": "V2 — pyl: ilosc", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "atmosphere_dust_speed", "label": "V2 — pyl: szybkosc", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "header", "content": "V3 — Living Museum Light" },
    { "type": "paragraph", "content": "Domyslne parametry pylu odpowiadaja zaakceptowanej wersji: 120 drobinek, 115% widocznosci, 125% rozmiaru, 75% szybkosci, 24 FPS i DPR 1.25." },
    { "type": "checkbox", "id": "living_light_enabled", "label": "Wlacz reflektor kursora", "default": true },
    { "type": "checkbox", "id": "living_dust_enabled", "label": "Wlacz pyl ambientowy", "default": true },
    { "type": "range", "id": "living_light_intensity", "label": "Intensywnosc swiatla", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 45 },
    { "type": "range", "id": "living_dust_particles", "label": "Pyl — liczba drobinek", "min": 20, "max": 240, "step": 10, "default": 120 },
    { "type": "range", "id": "living_dust_opacity", "label": "Pyl — widocznosc", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 115 },
    { "type": "range", "id": "living_dust_size", "label": "Pyl — rozmiar", "min": 50, "max": 200, "step": 5, "unit": "%", "default": 125 },
    { "type": "range", "id": "living_dust_speed", "label": "Pyl — szybkosc", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 75 },
    { "type": "range", "id": "living_dust_fps", "label": "Pyl — limit FPS", "min": 12, "max": 30, "step": 1, "default": 24 },
    { "type": "range", "id": "living_dust_dpr_cap", "label": "Pyl — limit jakosci DPR", "min": 75, "max": 150, "step": 5, "unit": "%", "default": 125 },
    { "type": "header", "content": "Wyglad" },
    { "type": "checkbox", "id": "enable_webgl", "label": "Wlacz efekt WebGL (Three.js)", "default": true, "info": "Wylaczenie zostawia elegancki wariant CSS." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schemat kolorow", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Losuj Obraz — oracle" }]
}
{% endschema %}
