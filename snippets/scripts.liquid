{% doc %}
  Renders all global scripts, module preloads, and importmaps for the theme.

  @param {object} [product] - The product object, available on product pages.
{% enddoc %}

<script type="importmap">
  {
    "imports": {
      "@theme/overflow-list": "{{ 'overflow-list.js' | asset_url }}",
      "@theme/product-title": "{{ 'product-title-truncation.js' | asset_url }}",
      "@theme/component": "{{ 'component.js' | asset_url }}",
      "@theme/dialog": "{{ 'dialog.js' | asset_url }}",
      "@theme/events": "{{ 'events.js' | asset_url }}",
      "@theme/focus": "{{ 'focus.js' | asset_url }}",
      "@theme/morph": "{{ 'morph.js' | asset_url }}",
      "@theme/paginated-list": "{{ 'paginated-list.js' | asset_url }}",
      "@theme/performance": "{{ 'performance.js' | asset_url }}",
      "@theme/product-form": "{{ 'product-form.js' | asset_url }}",
      "@theme/recently-viewed-products": "{{ 'recently-viewed-products.js' | asset_url }}",
      "@theme/scrolling": "{{ 'scrolling.js' | asset_url }}",
      "@theme/section-renderer": "{{ 'section-renderer.js' | asset_url }}",
      "@theme/section-hydration": "{{ 'section-hydration.js' | asset_url }}",
      "@theme/money-formatting": "{{ 'money-formatting.js' | asset_url }}",
      "@theme/utilities": "{{ 'utilities.js' | asset_url }}",
      "@theme/variant-picker": "{{ 'variant-picker.js' | asset_url }}&giclee_v=no-passepartout-option-20260623-2306",
      "@theme/media-gallery": "{{ 'media-gallery.js' | asset_url }}",
      "@theme/quick-add": "{{ 'quick-add.js' | asset_url }}",
      "@theme/paginated-list-aspect-ratio": "{{ 'paginated-list-aspect-ratio.js' | asset_url }}",
      "@theme/popover-polyfill": "{{ 'popover-polyfill.js' | asset_url }}",
      "@theme/component-quantity-selector": "{{ 'component-quantity-selector.js' | asset_url }}",
      "@theme/comparison-slider": "{{ 'comparison-slider.js' | asset_url }}",
      "@theme/sticky-add-to-cart": "{{ 'sticky-add-to-cart.js' | asset_url }}",
      "@theme/fly-to-cart": "{{ 'fly-to-cart.js' | asset_url }}"
    }
  }
</script>

<script
  src="{{ 'view-transitions.js' | asset_url }}"
  async
></script>

{% if request.page_type == 'page' and template.suffix == 'faq' %}
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/ScrollTrigger.min.js" defer></script>
  <script src="{{ 'giclee-hero-text-hover.js' | asset_url }}" defer></script>
  {{ 'faq-accordion-galaxy.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'faq-accordion-entrance.js' | asset_url }}" defer></script>
  <script src="{{ 'faq-section-effects.js' | asset_url }}" defer></script>
  {{ 'giclee-page-section-effects.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'giclee-page-section-effects-boot.js' | asset_url }}" defer></script>
{% elsif request.page_type == 'page' and template.suffix == 'filozofia-marki' %}
  {{ 'giclee-home-prehero-chrome.css' | asset_url | stylesheet_tag }}
  {{ 'giclee-fm-wrota-parallax.css' | asset_url | stylesheet_tag }}
  {{ 'giclee-fm-before-after.css' | asset_url | stylesheet_tag }}
  <script type="application/json" id="giclee-fm-wrota-parallax-assets">
    {
      "bottom": {{ 'giclee-fm-parallax-bottom.webp' | asset_url | json }}
    }
  </script>
  <script type="application/json" id="giclee-fm-quote-bg-assets">
    {
      "image": {{ 'giclee-fm-quote-bg.webp' | asset_url | json }}
    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/gsap.min.js" defer></script>
  <script src="{{ 'giclee-fm-before-after.js' | asset_url }}" defer></script>
  <script src="{{ 'giclee-fm-wrota-parallax.js' | asset_url }}" defer></script>
  <script src="{{ 'giclee-filozofia-quote-pin.js' | asset_url }}" defer></script>
  <script src="{{ 'giclee-filozofia-wrota-portal.js' | asset_url }}" defer></script>
{% elsif request.page_type == 'blog' %}
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/ScrollTrigger.min.js" defer></script>
  <script src="{{ 'giclee-hero-text-hover.js' | asset_url }}" defer></script>
  <script src="{{ 'blog-posts-entrance.js' | asset_url }}" defer></script>
  <script src="{{ 'blog-posts-hover.js' | asset_url }}" defer></script>
  <script src="{{ 'blog-section-effects.js' | asset_url }}" defer></script>
  {{ 'giclee-page-section-effects.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'giclee-page-section-effects-boot.js' | asset_url }}" defer></script>
{% endif %}

{% assign giclee_text_layers_asset = '' %}
{% if request.page_type == 'index' %}
  {% assign giclee_text_layers_asset = 'giclee-text-layers-index.js' %}
{% elsif request.page_type == 'collection' %}
  {% assign giclee_text_layers_asset = 'giclee-text-layers-collection.js' %}
{% elsif request.page_type == 'blog' %}
  {% assign giclee_text_layers_asset = 'giclee-text-layers-blog.js' %}
{% elsif request.page_type == 'page' and template.suffix == 'contact' %}
  {% assign giclee_text_layers_asset = 'giclee-text-layers-page-contact.js' %}
{% elsif request.page_type == 'page' and template.suffix == 'faq' %}
  {% assign giclee_text_layers_asset = 'giclee-text-layers-page-faq.js' %}
{% elsif request.page_type == 'page' and template.suffix == 'filozofia-marki' %}
  {% assign giclee_text_layers_asset = 'giclee-text-layers-page-filozofia-marki.js' %}
{% elsif request.page_type == 'page' and template.suffix == 'giclee-frame' %}
  {% assign giclee_text_layers_asset = 'giclee-text-layers-page-giclee-frame.js' %}
{% elsif request.page_type == 'page' and template.suffix == 'losuj-produkt' %}
  {% assign giclee_text_layers_asset = 'giclee-text-layers-page-losuj-produkt.js' %}
{% elsif request.page_type == 'page' and template.suffix == 'wspolpraca' %}
  {% assign giclee_text_layers_asset = 'giclee-text-layers-page-wspolpraca.js' %}
{% elsif request.page_type == 'product' and template.suffix == 'szablon-wlasna-fotografia' %}
  {% assign giclee_text_layers_asset = 'giclee-text-layers-product-szablon-wlasna-fotografia.js' %}
{% endif %}
{% unless giclee_text_layers_asset == blank %}
  {{ 'giclee-text-layers.css' | asset_url | stylesheet_tag }}
  <script src="{{ giclee_text_layers_asset | asset_url }}" defer></script>
  <script src="{{ 'giclee-text-layers.js' | asset_url }}" defer></script>
{% endunless %}

