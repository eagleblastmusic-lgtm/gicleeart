{%- doc -%}
  Komunikat na stronie hasła (zamiast licznika odliczania).
{%- enddoc -%}

{%- if section.settings.show_password_countdown -%}

{% liquid
  assign show_pc_heading = true
  if section.settings.password_countdown_show_heading == false
    assign show_pc_heading = false
  endif
  assign _pc_message = ''
  if show_pc_heading
    assign _locale_base = request.locale.iso_code | split: '-' | first | downcase
    case _locale_base
      when 'de'
        assign _pc_message = 'Wir überarbeiten die Architektur der Website. Wir sind bald wieder da.'
      when 'en'
        assign _pc_message = "Site architecture rebuild in progress. We'll be back soon."
      when 'fr'
        assign _pc_message = "Refonte de l'architecture du site. Nous revenons bientôt."
      when 'es'
        assign _pc_message = 'Reestructuración de la arquitectura del sitio. Volveremos pronto.'
      when 'it'
        assign _pc_message = "Ristrutturazione dell'architettura del sito. Torneremo presto."
      when 'nl'
        assign _pc_message = 'Herstructurering van de site-architectuur. We zijn binnenkort terug.'
      else
        assign _pc_message = 'Przebudowa architektury strony. Wkrótce wrócimy'
    endcase
  endif
%}

<div class="password-countdown" aria-live="polite">
  <div class="password-countdown__inner">
    {% if _pc_message != blank %}
      <p class="password-countdown__heading">{{ _pc_message }}</p>
    {% endif %}
  </div>
</div>

{%- endif -%}

{% stylesheet %}
  .password-countdown {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    margin-block-end: var(--gap-md, 1rem);
    text-align: center;
  }

  .password-countdown__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-md, 1rem);
  }

  .password-countdown__heading {
    margin: 0;
    max-width: 22rem;
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style, normal);
    font-weight: var(--font-accent--weight, 400);
    font-size: clamp(0.95rem, 2.75vw, 1.2rem);
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: none;
    font-feature-settings:
      'kern' 1,
      'liga' 1;
    color: var(--color-foreground-heading, var(--color-foreground));
  }
{% endstylesheet %}
