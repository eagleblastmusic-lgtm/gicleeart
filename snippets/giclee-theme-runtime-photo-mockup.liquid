  {% if template.suffix == 'fotografia-obraz' or template.suffix == 'szablon-wlasna-fotografia' %}
  {%- liquid
    assign pm_cart_product = product
    if pm_cart_product == blank
      assign pm_cart_product = all_products['twoje-zdjecie-jako-wydruk-giclee-na-papierze-fine-art-w-drewnianej-ramie']
    endif
  -%}
  {%- if pm_cart_product -%}
  <script type="application/json" id="pm-cart-product-data">
    {
      "id": {{ pm_cart_product.id | json }},
      "optionNames": [
        {%- for option in pm_cart_product.options -%}
          {{ option.name | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "variants": [
        {%- for variant in pm_cart_product.variants -%}
          {
            "id": {{ variant.id | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | json }},
            "compare_at_price": {{ variant.compare_at_price | json }},
            "options": {{ variant.options | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
  {%- endif -%}
  <script src="{{ 'giclee-print-analysis.js' | asset_url }}?v=size-m-20260701"></script>
  <script>
    (function() {
      var hero = document.getElementById('pm-hero');
      if (!hero) return;

      var pmCartProduct = null;
      try {
        var pmCartDataEl = document.getElementById('pm-cart-product-data');
        if (pmCartDataEl) pmCartProduct = JSON.parse(pmCartDataEl.textContent);
      } catch (err) {
        console.warn('pm-cart-product-data parse failed', err);
      }

      function gicleeT(key, fallback) {
        if (typeof window.__gicleeI18nGet === 'function') return window.__gicleeI18nGet(key, fallback);
        var bag = window.__gicleeI18n || {};
        var v = bag[key];
        if (!v || (typeof v === 'string' && /translation missing/i.test(v))) return fallback;
        return v;
      }

      var pmSizeToVariant = { M: 'M', S: 'M', L: 'L', XL: 'XL' };

      function pmNormalizeShopifySize(size) {
        var analysis = window.GicleePrintAnalysis;
        if (analysis && analysis.normalizeShopifySize) {
          return analysis.normalizeShopifySize(size) || 'M';
        }
        var key = String(size || '').trim().toUpperCase();
        if (key === 'S') return 'M';
        if (key === 'M' || key === 'L' || key === 'XL') return key;
        return 'M';
      }

      function pmNormalize(value) {
        return String(value || '').normalize('NFC').trim().toLowerCase();
      }

      function pmResolveVariant(config) {
        if (!pmCartProduct || !pmCartProduct.variants) return null;
        var color = config.color;
        var wood = config.wood;
        var size = pmSizeToVariant[config.size] || config.size;
        var names = pmCartProduct.optionNames || ['Kolor', 'Rozmiar', 'Rodzaj drewna'];

        for (var i = 0; i < pmCartProduct.variants.length; i++) {
          var variant = pmCartProduct.variants[i];
          if (variant.available === false) continue;
          var opts = variant.options || [];
          var matched = { color: false, size: false, wood: false };

          for (var j = 0; j < opts.length; j++) {
            var optName = pmNormalize(names[j] || '');
            var optVal = pmNormalize(opts[j]);
            if (optName.indexOf('passe') >= 0) continue;
            if (optName.indexOf('kolor') >= 0) {
              if (optVal === pmNormalize(color)) matched.color = true;
            } else if (optName.indexOf('rozmiar') >= 0) {
              if (optVal === pmNormalize(size)) matched.size = true;
            } else if (optName.indexOf('drewn') >= 0) {
              if (optVal === pmNormalize(wood)) matched.wood = true;
            }
          }

          if (!matched.color && opts[0] && pmNormalize(opts[0]) === pmNormalize(color)) matched.color = true;
          if (!matched.size && opts[1] && pmNormalize(opts[1]) === pmNormalize(size)) matched.size = true;
          if (!matched.wood && opts[2] && pmNormalize(opts[2]) === pmNormalize(wood)) matched.wood = true;

          if (matched.color && matched.size && matched.wood) return variant;
        }

        return null;
      }

      function pmGetCartSectionIds() {
        var ids = [];
        document.querySelectorAll('cart-items-component[data-section-id]').forEach(function(el) {
          if (el.dataset.sectionId) ids.push(el.dataset.sectionId);
        });
        return ids;
      }

      function pmDispatchCartUpdate(cart, variantId, sections) {
        document.dispatchEvent(new CustomEvent('cart:update', {
          bubbles: true,
          detail: {
            resource: cart,
            sourceId: 'pm-config-add-to-cart',
            data: {
              source: 'pm-configurator',
              itemCount: 1,
              variantId: String(variantId),
              productId: pmCartProduct ? String(pmCartProduct.id) : '',
              sections: sections || {}
            }
          }
        }));
      }

      function pmHideConfiguratorUi() {
        document.body.classList.remove('pm-app-drawer-open');
        var configEl = document.getElementById('pm-config');
        if (configEl) {
          configEl.classList.remove('is-open');
          var toggle = configEl.querySelector('.pm-config-trigger');
          if (toggle) toggle.setAttribute('aria-expanded', 'false');
          var options = configEl.querySelector('.pm-config-options');
          if (options) options.hidden = true;
        }
        syncPmSideShopVisibility();
      }

      function pmScrollPageToTop() {
        pmHideConfiguratorUi();
        document.body.style.top = '';
        document.body.style.position = '';
        document.body.style.width = '';
        document.body.style.paddingRight = '';

        var scrollTargets = [document.documentElement, document.body, document.scrollingElement];
        scrollTargets.forEach(function(el) {
          if (!el) return;
          el.scrollTop = 0;
          el.scrollLeft = 0;
        });
        window.scrollTo(0, 0);
      }

      function pmOpenCartDrawer() {
        var drawer = document.querySelector('cart-drawer-component');
        if (drawer) {
          if (typeof drawer.open === 'function') {
            drawer.open();
            return;
          }
          if (typeof drawer.showDialog === 'function') {
            drawer.showDialog();
            return;
          }
        }
        var trigger = document.querySelector('[data-testid="cart-drawer-trigger"]');
        if (trigger) trigger.click();
      }

      function pmPageScrollY() {
        return window.pageYOffset
          || document.documentElement.scrollTop
          || document.body.scrollTop
          || 0;
      }

      function pmWaitThenOpenCart() {
        var started = Date.now();
        var minDelayMs = 520;
        var maxWaitMs = 1500;

        pmScrollPageToTop();
        if (pmPageScrollY() > 2) {
          window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
        }

        function finish() {
          pmScrollPageToTop();
          pmOpenCartDrawer();
        }

        function maybeFinish() {
          var atTop = pmPageScrollY() <= 2;
          var elapsed = Date.now() - started;
          if (atTop && elapsed >= minDelayMs) {
            finish();
            return true;
          }
          if (elapsed >= maxWaitMs) {
            finish();
            return true;
          }
          return false;
        }

        function onScrollEnd() {
          if (maybeFinish()) {
            document.removeEventListener('scrollend', onScrollEnd, true);
            clearInterval(pollTimer);
            clearTimeout(maxTimer);
          }
        }

        document.addEventListener('scrollend', onScrollEnd, true);
        var pollTimer = setInterval(function() {
          if (maybeFinish()) {
            document.removeEventListener('scrollend', onScrollEnd, true);
            clearInterval(pollTimer);
            clearTimeout(maxTimer);
          }
        }, 40);
        var maxTimer = setTimeout(function() {
          document.removeEventListener('scrollend', onScrollEnd, true);
          clearInterval(pollTimer);
          finish();
        }, maxWaitMs);
      }

      function pmPauseMockupAutoScroll(ms) {
        if (typeof window.pmPauseMockupAutoScroll === 'function') {
          window.pmPauseMockupAutoScroll(ms || 6000);
          return;
        }
        var heroEl = document.getElementById('pm-hero');
        if (heroEl) {
          heroEl.dispatchEvent(new CustomEvent('pm-pause-mockup-scroll', {
            bubbles: true,
            detail: { ms: ms || 6000 }
          }));
        }
      }

      function pmShowCartUiImmediately() {
        pmHideConfiguratorUi();
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';

        if (typeof window.pmScrollPageToTopForCart === 'function') {
          window.pmScrollPageToTopForCart().then(function() {
            pmOpenCartDrawer();
          });
          return;
        }

        pmPauseMockupAutoScroll(4000);
        pmWaitThenOpenCart();
      }

      function pmAddConfiguredToCart(config, buttonEl) {
        if (!pmCartProduct) {
          if (buttonEl) {
            var noDataPrev = buttonEl.textContent;
            buttonEl.textContent = gicleeT('mockup_no_product', 'Brak danych produktu');
            setTimeout(function() { buttonEl.textContent = noDataPrev; }, 2200);
          }
          return Promise.reject(new Error('Product data missing'));
        }

        if (typeof window.pmHasMockupImage === 'function' && !window.pmHasMockupImage()) {
          if (buttonEl) {
            var noImgPrev = buttonEl.textContent;
            buttonEl.textContent = gicleeT('mockup_upload_first', 'Najpierw wgraj zdjęcie');
            setTimeout(function() { buttonEl.textContent = noImgPrev; }, 2200);
          }
          return Promise.reject(new Error('No mockup image'));
        }

        var variant = pmResolveVariant(config);
        if (!variant) {
          if (buttonEl) {
            var prev = buttonEl.textContent;
            buttonEl.textContent = gicleeT('mockup_variant_unavailable', 'Wariant niedostępny');
            setTimeout(function() { buttonEl.textContent = prev; }, 2200);
          }
          return Promise.reject(new Error('Variant unavailable'));
        }

        if (buttonEl) {
          buttonEl.disabled = true;
          buttonEl.dataset.prevLabel = buttonEl.textContent.trim() || gicleeT('add_to_cart', 'Dodaj do koszyka');
          buttonEl.textContent = gicleeT('adding_to_cart', 'Dodawanie…');
        }

        pmPauseMockupAutoScroll(8000);

        var uploadPromise = Promise.resolve(null);
        if (typeof window.pmPrepareOrderUpload === 'function') {
          uploadPromise = window.pmPrepareOrderUpload(config).catch(function(err) {
            if (buttonEl) {
              buttonEl.textContent = (err && err.message) ? String(err.message).slice(0, 48) : gicleeT('mockup_upload_error', 'Błąd uploadu');
              setTimeout(function() {
                buttonEl.disabled = false;
                buttonEl.textContent = buttonEl.dataset.prevLabel || gicleeT('add_to_cart', 'Dodaj do koszyka');
              }, 2600);
            }
            throw err;
          });
        }

        return uploadPromise.then(function(uploadResult) {
          var formData = new FormData();
          formData.append('id', String(variant.id));
          formData.append('quantity', '1');
          if (uploadResult && uploadResult.uploadId) {
            formData.append('properties[_Upload ID]', String(uploadResult.uploadId));
          }
          var passepartout = (config && config.passepartout) || 'Białe';
          if (window.GICLEE_PASSEPARTOUT && typeof window.GICLEE_PASSEPARTOUT.normalize === 'function') {
            passepartout = window.GICLEE_PASSEPARTOUT.normalize(passepartout);
          }
          formData.append('properties[Passepartout]', passepartout);
          var sectionIds = pmGetCartSectionIds();
          if (sectionIds.length) {
            formData.append('sections', sectionIds.join(','));
            formData.append('sections_url', window.location.pathname);
          }

          var cartAddUrl = (window.Theme && Theme.routes && Theme.routes.cart_add_url) || '/cart/add.js';

          return fetch(cartAddUrl, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
          })
            .then(function(response) {
              return response.json().then(function(data) {
                if (!response.ok || data.status) {
                  throw new Error(data.description || data.message || 'Cart add failed');
                }
                return data;
              });
            })
            .then(function(data) {
              return fetch('/cart.js', { headers: { Accept: 'application/json' } })
                .then(function(r) { return r.json(); })
                .then(function(cart) {
                  pmDispatchCartUpdate(cart, variant.id, data.sections);
                  pmShowCartUiImmediately();
                  if (buttonEl) {
                    buttonEl.disabled = false;
                    buttonEl.textContent = buttonEl.dataset.prevLabel || gicleeT('add_to_cart', 'Dodaj do koszyka');
                  }
                });
            });
        }).catch(function(err) {
          if (err && err.message === 'No mockup image') return;
          if (err && err.message === 'Variant unavailable') return;
          if (err && err.message === 'Product data missing') return;
          console.error('pmAddConfiguredToCart', err);
          if (buttonEl && buttonEl.disabled) {
            buttonEl.textContent = gicleeT('mockup_try_again', 'Spróbuj ponownie');
            setTimeout(function() {
              buttonEl.disabled = false;
              buttonEl.textContent = buttonEl.dataset.prevLabel || 'Dodaj do koszyka';
            }, 2200);
          }
        });
      }

      var cta = document.getElementById('pm-cta');
      var root = document.body;
      var backButton = document.getElementById('pm-back-to-preview');
      if (cta && !backButton) {
        backButton = document.createElement('button');
        backButton.type = 'button';
        backButton.id = 'pm-back-to-preview';
        backButton.textContent = '\u2190 ' + gicleeT('mockup_back', 'Powrót');
        root.appendChild(backButton);
      }
      function pmNotifySideShopLayout() {
        hero.dispatchEvent(new CustomEvent('pm-side-shop-update', { bubbles: true }));
      }

      function syncPmSideShopCartPlacement(shopEl, configEl, mobileToolbar, loaded, open) {
        var cartSection = shopEl.querySelector('.pm-side-cart');
        if (!cartSection) {
          var addBtn = document.getElementById('pm-config-add-to-cart');
          if (addBtn) cartSection = addBtn.closest('.pm-side-cart');
        }
        if (!cartSection) return;

        if (mobileToolbar && loaded && open && configEl) {
          if (cartSection.parentElement !== configEl) {
            configEl.appendChild(cartSection);
          }
        } else if (cartSection.parentElement !== shopEl) {
          shopEl.appendChild(cartSection);
        }
      }

      function syncPmSideShopVisibility() {
        var configEl = document.getElementById('pm-config');
        var shopEl = document.getElementById('pm-side-shop');
        if (!shopEl || !configEl) return;
        var loaded = hero.classList.contains('loaded');
        var open = loaded && configEl.classList.contains('is-open');
        var mobileToolbar =
          window.matchMedia &&
          window.matchMedia('(max-width: 980px)').matches;
        shopEl.hidden = !loaded;
        shopEl.classList.toggle('pm-side-shop--mobile-toolbar', mobileToolbar && loaded);
        shopEl.classList.toggle('pm-side-shop--cart-open', open);
        var showShop = open || (mobileToolbar && loaded);
        shopEl.classList.toggle('is-visible', showShop);
        shopEl.setAttribute('aria-hidden', showShop ? 'false' : 'true');
        syncPmSideShopCartPlacement(shopEl, configEl, mobileToolbar, loaded, open);
        if (open) {
          requestAnimationFrame(function() {
            pmNotifySideShopLayout();
          });
        } else {
          pmNotifySideShopLayout();
        }
      }

      function ensurePmSideShop(heroEl) {
        var stage = heroEl.querySelector('.pm-stage');
        if (!stage) return null;

        var shopEl = document.getElementById('pm-side-shop');
        var hintEl = stage.querySelector('.pm-hint');
        if (!shopEl) {
          shopEl = document.createElement('div');
          shopEl.id = 'pm-side-shop';
          shopEl.className = 'pm-side-shop';
          shopEl.hidden = true;
          shopEl.setAttribute('aria-hidden', 'true');
          shopEl.innerHTML = [
            '<section class="pm-side-price" aria-label="Cena">',
            '  <div class="pm-config-price" id="pm-config-price" aria-live="polite">',
            '    <span class="pm-config-price__eyebrow">Cena</span>',
            '    <span class="pm-config-price__value" id="pm-config-price-value">—</span>',
            '  </div>',
            '</section>',
            '<section class="pm-side-cart" aria-label="Dodaj do koszyka">',
            '  <button type="button" class="pm-config-add-to-cart" id="pm-config-add-to-cart">Dodaj do koszyka</button>',
            '</section>'
          ].join('');
          if (hintEl) stage.insertBefore(shopEl, hintEl);
          else stage.appendChild(shopEl);
        } else if (hintEl && shopEl.nextElementSibling !== hintEl && shopEl !== hintEl.previousElementSibling) {
          stage.insertBefore(shopEl, hintEl);
        }

        var priceSection = shopEl.querySelector('.pm-side-price');
        var cartSection = shopEl.querySelector('.pm-side-cart');
        var priceWrap = document.getElementById('pm-config-price');
        var addBtn = document.getElementById('pm-config-add-to-cart');

        if (priceWrap && priceSection && priceWrap.parentElement !== priceSection) {
          priceSection.appendChild(priceWrap);
        }
        if (addBtn && cartSection && addBtn.parentElement !== cartSection) {
          if (addBtn.querySelector('.pm-config-add-to-cart__text')) {
            var labelEl = addBtn.querySelector('.pm-config-add-to-cart__text');
            addBtn.textContent = labelEl
              ? (labelEl.textContent || 'Dodaj do koszyka').trim()
              : 'Dodaj do koszyka';
          }
          cartSection.appendChild(addBtn);
        }

        syncPmSideShopVisibility();
        return document.getElementById('pm-config-price-value');
      }

      function buildPmLeftRail() {
        if (!hero) return;
        var rail = document.getElementById('pm-left-rail');
        if (!rail) {
          rail = document.createElement('div');
          rail.id = 'pm-left-rail';
          hero.appendChild(rail);
        }
        var inviteEl = document.getElementById('pm-lab-invite');
        if (!inviteEl) {
          inviteEl = document.createElement('div');
          inviteEl.id = 'pm-lab-invite';
          inviteEl.innerHTML = gicleeT('mockup_invite_html', '<strong>Podoba się?</strong>Skonfiguruj i dodaj do koszyka. Twój plik wraz z kadrowaniem zostanie przesłany automatycznie po opłaceniu zamówienia.');
          rail.appendChild(inviteEl);
        } else if (inviteEl.parentElement !== rail) {
          rail.appendChild(inviteEl);
        }
        var configEl = document.getElementById('pm-config');
        if (!configEl) {
          configEl = document.createElement('div');
          configEl.id = 'pm-config';
          configEl.className = 'pm-config';
          configEl.innerHTML = [
            '<button type="button" class="pm-config-trigger" id="pm-config-toggle" aria-expanded="false" aria-controls="pm-config-options">',
            '  <span class="pm-config-trigger__icon" aria-hidden="true">',
            '    <svg viewBox="0 0 24 24" fill="none"><path d="M6 6h14l-1.4 8.2H7.4L5 4H3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.2" cy="19.2" r="1.35" fill="currentColor"/><circle cx="17.2" cy="19.2" r="1.35" fill="currentColor"/></svg>',
            '  </span>',
            '  <span class="pm-config-trigger__label">Skonfiguruj i dodaj do koszyka</span>',
            '</button>',
            '<div class="pm-config-options" id="pm-config-options" hidden>',
            '  <div class="pm-config-row" data-row="wood" role="group" aria-label="Rodzaj drewna">',
            '    <button type="button" class="pm-opt pm-opt--wood is-selected" data-value="dab" aria-pressed="true">dąb</button>',
            '    <button type="button" class="pm-opt pm-opt--wood" data-value="sosna" aria-pressed="false">sosna</button>',
            '  </div>',
            '  <div class="pm-config-row" data-row="color" role="group" aria-label="Kolor ramy">',
            '    <button type="button" class="pm-opt pm-opt--swatch is-selected" data-value="czarny" style="--pm-swatch:#121212" aria-label="Czarny" aria-pressed="true"></button>',
            '    <button type="button" class="pm-opt pm-opt--swatch" data-value="jasny-braz" style="--pm-swatch:#9a7040" aria-label="Jasny brąz" aria-pressed="false"></button>',
            '    <button type="button" class="pm-opt pm-opt--swatch" data-value="braz" style="--pm-swatch:#8b5a38" aria-label="Brąz" aria-pressed="false"></button>',
            '    <button type="button" class="pm-opt pm-opt--swatch" data-value="ciemny-braz" style="--pm-swatch:#4a3222" aria-label="Ciemny brąz" aria-pressed="false"></button>',
            '  </div>',
            '  <div class="pm-config-row" data-row="size" role="group" aria-label="Rozmiar">',
            '    <button type="button" class="pm-opt pm-opt--size is-selected" data-value="M" aria-pressed="true">M</button>',
            '    <button type="button" class="pm-opt pm-opt--size" data-value="L" aria-pressed="false">L</button>',
            '    <button type="button" class="pm-opt pm-opt--size" data-value="XL" aria-pressed="false">XL</button>',
            '  </div>',
            '  <div class="pm-config-row pm-config-row--labeled" data-row="passepartout" role="group" aria-label="Passepartout">',
            '    <span class="pm-config-row__label">Passepartout</span>',
            '    <span class="pm-config-row__opts">',
            '      <button type="button" class="pm-opt pm-opt--pp is-selected" data-value="bialy" aria-pressed="true">Białe</button>',
            '      <button type="button" class="pm-opt pm-opt--pp" data-value="czarny" aria-pressed="false">Czarne</button>',
            '    </span>',
            '  </div>',
            '</div>',
            '<div class="pm-quality-panel pm-quality-panel--empty" id="pm-quality-panel" aria-live="polite">',
            '  <div class="pm-quality-panel__head">',
            '    <span class="pm-quality-panel__eyebrow">Jakość wydruku</span>',
            '    <span class="pm-quality-panel__format"></span>',
            '  </div>',
            '  <div class="pm-quality-panel__verdict">Jakość wydruku</div>',
            '  <div class="pm-quality-panel__meta"></div>',
            '  <div class="pm-quality-panel__file"></div>',
            '  <div class="pm-quality-panel__bar" role="presentation"><span class="pm-quality-panel__bar-fill"></span></div>',
            '  <p class="pm-quality-panel__note">Wgraj zdjęcie, aby zobaczyć ocenę jakości wydruku.</p>',
            '</div>'
          ].join('');
          rail.appendChild(configEl);
          initPmConfigurator(configEl, hero);
        } else if (configEl.dataset.pmConfigInit !== '1') {
          initPmConfigurator(configEl, hero);
        }
        ensurePmQualityPanel(hero);
        ensurePmSideShop(hero);
      }

      function ensurePmQualityPanel(heroEl) {
        var configEl = document.getElementById('pm-config');
        if (!configEl || configEl.dataset.pmQualityInit === '1') return;
        if (!document.getElementById('pm-quality-panel')) {
          var panel = document.createElement('div');
          panel.id = 'pm-quality-panel';
          panel.className = 'pm-quality-panel pm-quality-panel--empty';
          panel.setAttribute('aria-live', 'polite');
          panel.innerHTML = [
            '<div class="pm-quality-panel__head">',
            '  <span class="pm-quality-panel__eyebrow">Jakość wydruku</span>',
            '  <span class="pm-quality-panel__format"></span>',
            '</div>',
            '<div class="pm-quality-panel__verdict">Jakość wydruku</div>',
            '<div class="pm-quality-panel__meta"></div>',
            '<div class="pm-quality-panel__file"></div>',
            '<div class="pm-quality-panel__bar" role="presentation"><span class="pm-quality-panel__bar-fill"></span></div>',
            '<p class="pm-quality-panel__note">Wgraj zdjęcie, aby zobaczyć ocenę jakości wydruku.</p>'
          ].join('');
          configEl.appendChild(panel);
        }
        initPmQualityPanel(configEl, heroEl);
      }

      function initPmQualityPanel(root, heroEl) {
        if (root.dataset.pmQualityInit === '1') return;
        root.dataset.pmQualityInit = '1';

        var panel = root.querySelector('#pm-quality-panel');
        if (!panel) return;

        var verdictEl = panel.querySelector('.pm-quality-panel__verdict');
        var metaEl = panel.querySelector('.pm-quality-panel__meta');
        var fileEl = panel.querySelector('.pm-quality-panel__file');
        if (!fileEl && metaEl) {
          fileEl = document.createElement('div');
          fileEl.className = 'pm-quality-panel__file';
          metaEl.insertAdjacentElement('afterend', fileEl);
        }
        var barFill = panel.querySelector('.pm-quality-panel__bar-fill');
        var noteEl = panel.querySelector('.pm-quality-panel__note');
        var formatEl = panel.querySelector('.pm-quality-panel__format');

        var imageData = null;
        var viewCrop = null;
        var currentSize = pmNormalizeShopifySize(
          (window.pmFrameConfig && window.pmFrameConfig.size) || 'M'
        );
        var orientation = 'portrait';
        var qualityRaf = 0;

        function formatFileInfo(data) {
          if (!data) return '';
          var w = data.decodeWidthPx || data.widthPx;
          var h = data.decodeHeightPx || data.heightPx;
          if (!w || !h) return '';
          var mp = (w * h) / 1e6;
          var parts = [w + '×' + h + ' px', mp.toFixed(1) + ' MP'];
          if (data.fileBytes > 0) parts.push(Math.round(data.fileBytes / 1024) + ' KB');
          return parts.join(' · ');
        }

        function setPlaceholder(msg) {
          panel.className = 'pm-quality-panel pm-quality-panel--empty';
          if (verdictEl) verdictEl.textContent = gicleeT('mockup_quality_title', 'Jakość wydruku');
          if (metaEl) metaEl.textContent = '';
          if (fileEl) fileEl.textContent = '';
          if (noteEl) noteEl.textContent = msg;
          if (formatEl) formatEl.textContent = '';
          if (barFill) barFill.style.width = '0%';
        }

        function renderQualityNow() {
          var analysis = window.GicleePrintAnalysis;
          if (!analysis) {
            setPlaceholder(gicleeT('mockup_quality_loading', 'Ładowanie analizy…'));
            return;
          }
          if (!imageData || !imageData.widthPx || !imageData.heightPx) {
            setPlaceholder(gicleeT('mockup_quality_upload', 'Wgraj zdjęcie, aby zobaczyć ocenę jakości wydruku.'));
            return;
          }

          var image = { widthPx: imageData.widthPx, heightPx: imageData.heightPx };
          var sizeKey = pmNormalizeShopifySize(currentSize);
          var fileResult = analysis.analyseForShopifySize(image, sizeKey, orientation);
          if (!fileResult) {
            setPlaceholder(gicleeT('mockup_quality_select_size', 'Wybierz rozmiar, aby zobaczyć analizę.'));
            return;
          }

          var displayResult = fileResult;
          var useCropPpi =
            viewCrop &&
            viewCrop.zoom > 1.01 &&
            viewCrop.visibleWidthPx > 0 &&
            viewCrop.visibleHeightPx > 0;
          if (useCropPpi) {
            var cropResult = analysis.analyseForShopifySize(
              image,
              sizeKey,
              orientation,
              {
                widthPx: viewCrop.visibleWidthPx,
                heightPx: viewCrop.visibleHeightPx
              }
            );
            if (cropResult) displayResult = cropResult;
          }

          var active = displayResult;
          panel.className = 'pm-quality-panel pm-quality-panel--' + (active.verdict.tone || 'gray');
          if (verdictEl) verdictEl.textContent = active.verdict.label;
          if (metaEl) {
            metaEl.textContent = Math.round(active.limitingPpi) + ' PPI · cel ' + analysis.TARGET_DPI + ' DPI';
            if (useCropPpi && Math.abs(active.limitingPpi - fileResult.limitingPpi) >= 1) {
              metaEl.textContent += ' · plik ' + Math.round(fileResult.limitingPpi) + ' PPI';
            }
          }
          if (fileEl) fileEl.textContent = formatFileInfo(imageData);
          if (noteEl) noteEl.textContent = active.verdict.note;
          if (formatEl) formatEl.textContent = fileResult.name + ' · ' + sizeKey;
          if (barFill) {
            barFill.style.width = Math.min(100, active.quality) + '%';
            barFill.className = 'pm-quality-panel__bar-fill pm-quality-panel__bar-fill--' +
              analysis.barColorForPpi(active.limitingPpi);
          }
        }

        function renderQuality() {
          if (qualityRaf) return;
          qualityRaf = requestAnimationFrame(function() {
            qualityRaf = 0;
            renderQualityNow();
          });
        }

        heroEl.addEventListener('pm-image-loaded', function(e) {
          if (e.detail) {
            imageData = e.detail;
            if (e.detail.orientation) orientation = e.detail.orientation;
          }
          renderQuality();
        });

        heroEl.addEventListener('pm-frame-change', function(e) {
          if (e.detail && e.detail.orientation) {
            orientation = e.detail.orientation;
            renderQuality();
          }
        });

        heroEl.addEventListener('pm-config-change', function(e) {
          if (e.detail && e.detail.size) {
            currentSize = pmNormalizeShopifySize(e.detail.size);
            renderQuality();
          }
        });

        heroEl.addEventListener('pm-view-change', function(e) {
          if (!e.detail) return;
          viewCrop = e.detail;
          if (e.detail.orientation) orientation = e.detail.orientation;
          renderQuality();
        });

        renderQuality();
      }

      function initPmConfigurator(root, heroEl) {
        if (root.dataset.pmConfigInit === '1') return;
        root.dataset.pmConfigInit = '1';

        var toggle = root.querySelector('.pm-config-trigger');
        var options = root.querySelector('.pm-config-options');
        if (!toggle || !options) return;
        var mockupAddBtn = document.getElementById('pm-mockup-add-to-cart');
        if (mockupAddBtn) mockupAddBtn.remove();
        ensurePmSideShop(heroEl);

        if (heroEl.dataset.pmCartClickInit !== '1') {
          heroEl.dataset.pmCartClickInit = '1';
          heroEl.addEventListener('click', function(e) {
            var addBtn = e.target.closest('#pm-config-add-to-cart');
            if (!addBtn || addBtn.disabled) return;
            e.preventDefault();
            e.stopPropagation();
            pmPauseMockupAutoScroll(4000);
            publishConfig();
            heroEl.dispatchEvent(new CustomEvent('pm-config-add-to-cart', {
              bubbles: true,
              detail: window.pmFrameConfig
            }));
            pmAddConfiguredToCart(window.pmFrameConfig, addBtn);
          });
        }

        var colorLabels = {
          'czarny': 'Czarny',
          'jasny-braz': 'Jasny Brąz',
          'braz': 'Brąz',
          'ciemny-braz': 'Ciemny Brąz'
        };
        var state = { wood: 'dab', color: 'czarny', size: 'M', passepartout: 'bialy' };
        var passepartoutLabels = { bialy: 'Białe', czarny: 'Czarne' };
        var colorRow = root.querySelector('.pm-config-row[data-row="color"]');
        var sizeRow = root.querySelector('.pm-config-row[data-row="size"]');
        var priceValueEl = document.getElementById('pm-config-price-value');

        function pmFormatMoney(cents) {
          if (cents == null || !isFinite(cents)) return '';
          return (cents / 100).toLocaleString('pl-PL', {
            style: 'currency',
            currency: 'PLN',
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
          });
        }

        function syncConfigPrice() {
          if (!priceValueEl) return;
          var cfg = {
            wood: state.wood === 'dab' ? 'Dąb' : 'Sosna',
            color: colorLabels[state.color] || 'Czarny',
            size: state.size
          };
          var variant = pmResolveVariant(cfg);
          priceValueEl.classList.remove('is-unavailable');
          if (!variant) {
            priceValueEl.textContent = gicleeT('mockup_unavailable', 'Niedostępny');
            priceValueEl.classList.add('is-unavailable');
            return;
          }
          var priceHtml = pmFormatMoney(variant.price);
          if (
            variant.compare_at_price &&
            variant.compare_at_price > variant.price
          ) {
            priceHtml +=
              '<span class="pm-config-price__compare">' +
              pmFormatMoney(variant.compare_at_price) +
              '</span>';
          }
          priceValueEl.innerHTML = priceHtml;
        }

        function syncDefaultSizeUi() {
          if (!sizeRow) return;
          sizeRow.querySelectorAll('.pm-opt').forEach(function(btn) {
            var isDefaultSize = btn.getAttribute('data-value') === 'M';
            btn.classList.toggle('is-selected', isDefaultSize);
            btn.setAttribute('aria-pressed', isDefaultSize ? 'true' : 'false');
          });
        }

        function publishConfig() {
          window.pmFrameConfig = {
            wood: state.wood === 'dab' ? 'Dąb' : 'Sosna',
            color: colorLabels[state.color] || 'Czarny',
            size: state.size,
            passepartout: passepartoutLabels[state.passepartout] || 'Białe'
          };
          heroEl.dispatchEvent(new CustomEvent('pm-config-change', {
            bubbles: true,
            detail: window.pmFrameConfig
          }));
          syncConfigPrice();
        }

        function syncColorOptionsForWood() {
          if (!colorRow) return;
          var pineOnly = state.wood === 'sosna';
          var swatches = colorRow.querySelectorAll('.pm-opt--swatch');
          swatches.forEach(function(btn) {
            var val = btn.getAttribute('data-value');
            var unavailable = pineOnly && val !== 'czarny';
            btn.classList.toggle('is-unavailable', unavailable);
            btn.disabled = unavailable;
            if (unavailable) {
              btn.classList.remove('is-selected');
              btn.setAttribute('aria-pressed', 'false');
            }
          });
          if (pineOnly) {
            var black = colorRow.querySelector('[data-value="czarny"]');
            if (black) {
              swatches.forEach(function(btn) {
                if (btn !== black) {
                  btn.classList.remove('is-selected');
                  btn.setAttribute('aria-pressed', 'false');
                }
              });
              black.classList.add('is-selected');
              black.setAttribute('aria-pressed', 'true');
              state.color = 'czarny';
            }
          }
        }

        toggle.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          var open = root.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          options.hidden = !open;
          syncPmSideShopVisibility();
        });

        root.querySelectorAll('.pm-opt').forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            if (btn.disabled || btn.classList.contains('is-unavailable')) return;
            var row = btn.closest('.pm-config-row');
            if (!row) return;
            row.querySelectorAll('.pm-opt').forEach(function(peer) {
              peer.classList.remove('is-selected');
              peer.setAttribute('aria-pressed', 'false');
            });
            btn.classList.add('is-selected');
            btn.setAttribute('aria-pressed', 'true');
            var key = row.getAttribute('data-row');
            if (key) state[key] = btn.getAttribute('data-value') || state[key];
            if (key === 'wood') syncColorOptionsForWood();
            publishConfig();
          });
        });

        syncDefaultSizeUi();
        syncColorOptionsForWood();
        publishConfig();
        pmNotifySideShopLayout();
      }

      buildPmLeftRail();
      hero.addEventListener('pm-image-loaded', syncPmSideShopVisibility);
      window.addEventListener('resize', syncPmSideShopVisibility);

      if (!cta) return;

      cta.setAttribute('href', '#');

      var chevronsWrap = cta.querySelector('.pm-cta-chevrons');
      if (chevronsWrap) {
        chevronsWrap.style.flexDirection = 'row';
        chevronsWrap.style.gap = '4px';
        chevronsWrap.style.marginTop = '0';
      }
      var chevrons = cta.querySelectorAll('.pm-cta-chevrons svg');
      var delays = ['0s', '0.18s', '0.36s'];
      chevrons.forEach(function(svg, idx) {
        svg.style.transform = 'rotate(-90deg)';
        svg.style.animationName = 'pmChevronHorizontalForced';
        svg.style.animationDuration = '1.8s';
        svg.style.animationTimingFunction = 'ease-in-out';
        svg.style.animationIterationCount = 'infinite';
        svg.style.animationDelay = delays[idx] || '0s';
      });
      document.addEventListener('click', function(e) {
        var trigger = e.target && e.target.closest ? e.target.closest('#pm-cta') : null;
        if (!trigger) return;
        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        root.classList.toggle('pm-app-drawer-open');
      }, true);

      backButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        root.classList.remove('pm-app-drawer-open');
      }, true);
    })();
  </script>
  {% endif %}
