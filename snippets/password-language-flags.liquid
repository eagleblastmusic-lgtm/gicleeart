{%- doc -%}
  Flagi języków (PL, DE, NL, IT, ES, FR, EN) na stronie hasła.
  Szuka shop_locale po bazowym kodzie języka (np. de z de-DE). Dla EN wybiera en-EU
  (nie pierwszy „en”, np. en-GB). Gdy brak locale, zapasowy href /en-eu/password itd.
{%- enddoc -%}
{%- liquid
  assign password_lang_order = 'pl|de|nl|it|es|fr|en' | split: '|'
-%}
<nav
  class="password-footer__langs"
  aria-label="{{ 'content.language' | t }}"
>
  <ul class="password-footer__langs-list list-unstyled" role="list">
    {%- for target_code in password_lang_order -%}
      {%- assign locale_obj = false -%}
      {%- assign tc_down = target_code | downcase -%}
      {%- if tc_down == 'en' -%}
        {%- comment -%} English: zawsze rynek EU (en-eu), nie pierwszy dopasowany „en” (np. en-GB). {%- endcomment -%}
        {%- for loc in shop.published_locales -%}
          {%- assign iso_raw = loc.iso_code | replace: '_', '-' | downcase -%}
          {%- if iso_raw == 'en-eu' -%}
            {%- assign locale_obj = loc -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- unless locale_obj -%}
          {%- for loc in localization.available_languages -%}
            {%- assign iso_raw = loc.iso_code | replace: '_', '-' | downcase -%}
            {%- if iso_raw == 'en-eu' -%}
              {%- assign locale_obj = loc -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}
      {%- else -%}
        {%- for loc in shop.published_locales -%}
          {%- assign iso_raw = loc.iso_code | replace: '_', '-' -%}
          {%- assign loc_base = iso_raw | split: '-' | first | downcase -%}
          {%- if loc_base == tc_down -%}
            {%- assign locale_obj = loc -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- unless locale_obj -%}
          {%- for loc in localization.available_languages -%}
            {%- assign iso_raw = loc.iso_code | replace: '_', '-' -%}
            {%- assign loc_base = iso_raw | split: '-' | first | downcase -%}
            {%- if loc_base == tc_down -%}
              {%- assign locale_obj = loc -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}
      {%- endif -%}

      {%- liquid
        case target_code
          when 'pl'
            assign flag_char = '🇵🇱'
            assign label_fallback = 'Polski'
          when 'de'
            assign flag_char = '🇩🇪'
            assign label_fallback = 'Deutsch'
          when 'nl'
            assign flag_char = '🇳🇱'
            assign label_fallback = 'Nederlands'
          when 'it'
            assign flag_char = '🇮🇹'
            assign label_fallback = 'Italiano'
          when 'es'
            assign flag_char = '🇪🇸'
            assign label_fallback = 'Español'
          when 'fr'
            assign flag_char = '🇫🇷'
            assign label_fallback = 'Français'
          when 'en'
            assign flag_char = '🇬🇧'
            assign label_fallback = 'English'
          else
            assign flag_char = target_code | upcase
            assign label_fallback = target_code
        endcase
      -%}
      {%- liquid
        assign pwd_fallback = ''
        assign href_lang_syn = ''
        case tc_down
          when 'pl'
            assign pwd_fallback = '/password'
            assign href_lang_syn = 'pl-PL'
          when 'en'
            assign pwd_fallback = '/en-eu/password'
            assign href_lang_syn = 'en-EU'
          else
            assign region_up = tc_down | upcase
            assign href_lang_syn = tc_down | append: '-' | append: region_up
            assign pwd_fallback = '/' | append: tc_down | append: '-' | append: tc_down | append: '/password'
        endcase
      -%}

      <li class="password-footer__langs-item">
        {%- if locale_obj -%}
          {%- liquid
            if locale_obj.primary or locale_obj.root_url == '/'
              assign pwd_url = '/password'
            else
              assign pwd_url = locale_obj.root_url | strip | append: '/password' | replace: '//', '/'
            endif
            assign req_iso = request.locale.iso_code | replace: '_', '-'
            assign req_base = req_iso | split: '-' | first | downcase
            assign is_current = false
            if req_base == tc_down
              assign is_current = true
            endif
          -%}
          <a
            href="{{ pwd_url }}"
            hreflang="{{ locale_obj.iso_code }}"
            lang="{{ locale_obj.iso_code }}"
            class="password-footer__lang-btn{% if is_current %} password-footer__lang-btn--current{% endif %}"
            {% if is_current %}
              aria-current="true"
            {% endif %}
            aria-label="{{ locale_obj.endonym_name | escape }}"
          >
            <span class="password-footer__lang-flag" aria-hidden="true">{{ flag_char }}</span>
          </a>
        {%- elsif pwd_fallback != blank -%}
          {%- liquid
            assign req_iso = request.locale.iso_code | replace: '_', '-'
            assign req_base = req_iso | split: '-' | first | downcase
            assign is_current = false
            if req_base == tc_down
              assign is_current = true
            endif
          -%}
          <a
            href="{{ pwd_fallback }}"
            hreflang="{{ href_lang_syn }}"
            lang="{{ href_lang_syn }}"
            class="password-footer__lang-btn password-footer__lang-btn--synthetic{% if is_current %} password-footer__lang-btn--current{% endif %}"
            {% if is_current %}
              aria-current="true"
            {% endif %}
            aria-label="{{ label_fallback }}"
          >
            <span class="password-footer__lang-flag" aria-hidden="true">{{ flag_char }}</span>
          </a>
        {%- else -%}
          <span
            class="password-footer__lang-btn password-footer__lang-btn--inactive"
            aria-label="{{ label_fallback }}"
          >
            <span class="password-footer__lang-flag" aria-hidden="true">{{ flag_char }}</span>
          </span>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
