  <style>
    #page-transition {
      position: fixed;
      inset: 0;
      z-index: 99998;
      pointer-events: none;
      display: flex;
    }
    #page-transition.active,
    #page-transition.pt-init,
    #page-transition.closing,
    #page-transition.opening {
      z-index: 2147483647;
    }
    #page-transition.active {
      pointer-events: all;
    }
    #page-transition.opening {
      pointer-events: none;
    }
    #page-transition.closing,
    #page-transition.pt-init {
      pointer-events: all;
    }
    .pt-panel {
      position: fixed;
      top: 0;
      width: 50%;
      height: 100%;
      background: #080808;
      will-change: transform;
      --pt-open-duration: 1.25s;
      --pt-close-duration: 0.72s;
      transition: transform var(--pt-open-duration) cubic-bezier(0.45, 0, 0.15, 1);
    }
    .pt-left {
      left: 0;
      transform: translateX(-100%);
    }
    .pt-right {
      right: 0;
      transform: translateX(100%);
    }
    .pt-seam {
      position: fixed;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 1px;
      height: 100%;
      background: linear-gradient(to bottom, transparent 10%, #c9a84c 40%, #c9a84c 60%, transparent 90%);
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1;
      pointer-events: none;
    }
    #page-transition.pt-init .pt-left,
    #page-transition.closing .pt-left {
      transform: translateX(0);
    }
    #page-transition.pt-init .pt-right,
    #page-transition.closing .pt-right {
      transform: translateX(0);
    }
    #page-transition.pt-init .pt-panel,
    #page-transition.closing .pt-panel {
      transition: transform var(--pt-close-duration, 0.72s) cubic-bezier(0.76, 0, 0.24, 1);
    }
    #page-transition.pt-init .pt-seam {
      opacity: 1;
      transition: none !important;
    }
    #page-transition.closing .pt-seam {
      opacity: 1;
      transition: opacity 0.25s ease;
      transition-delay: 0.45s;
    }
    #page-transition.opening .pt-left {
      transform: translateX(-100%);
    }
    #page-transition.opening .pt-right {
      transform: translateX(100%);
    }
    #page-transition.opening .pt-panel {
      transition: transform var(--pt-open-duration, 1.25s) cubic-bezier(0.45, 0, 0.15, 1);
    }
    #page-transition.opening .pt-seam {
      opacity: 0;
      transition-delay: 0s;
    }

    body.curtain-content-hide .product-grid__item,
    body.curtain-content-hide .product-grid__item .card-gallery,
    body.curtain-content-hide .product-grid__item .card-gallery img,
    body.curtain-content-hide .product-grid__item product-card {
      visibility: hidden !important;
      opacity: 0 !important;
      transform: none !important;
      z-index: auto !important;
      transition: none !important;
    }
    body.is-navigating [data-view-transition-type],
    body.is-navigating [data-view-transition-triggered] {
      view-transition-name: none !important;
    }
    {% if template.suffix == 'faq' %}
    /* =====================================================================
       FAQ — PREMIUM ACCORDION (tylko UI/UX, treść bez zmian)
       Zakres: wyłącznie strona FAQ (template.suffix == 'faq').
       Wyższa specyficzność + !important nadpisuje globalne .accordion z base.css
       jedynie na tej stronie — inne akordeony (np. produkt) bez zmian.
       ===================================================================== */
    accordion-custom {
      /* szybsze, płynne rozwijanie (komponent czyta tę zmienną) */
      --animation-speed-slow: 320ms;
      --animation-easing: cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Wejście kart (stagger zsynchronizowany z kurtyną przejścia) */
    @keyframes faqItemIn {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .accordion accordion-custom {
      display: block;
      opacity: 0;
      animation: faqItemIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .accordion accordion-custom:nth-child(1)  { animation-delay: 0.80s; }
    .accordion accordion-custom:nth-child(2)  { animation-delay: 0.95s; }
    .accordion accordion-custom:nth-child(3)  { animation-delay: 1.10s; }
    .accordion accordion-custom:nth-child(4)  { animation-delay: 1.25s; }
    .accordion accordion-custom:nth-child(5)  { animation-delay: 1.40s; }
    .accordion accordion-custom:nth-child(6)  { animation-delay: 1.55s; }
    .accordion accordion-custom:nth-child(7)  { animation-delay: 1.70s; }
    .accordion accordion-custom:nth-child(8)  { animation-delay: 1.85s; }
    .accordion accordion-custom:nth-child(n+9){ animation-delay: 2.00s; }

    /* Odstęp między kartami (stała szerokość kontenera bez zmian) */
    .accordion accordion-custom + accordion-custom { margin-block-start: 14px; }

    /* Karta — glassmorphism + miękki cień (na details, by radius clipował treść) */
    .accordion accordion-custom details {
      position: relative;
      margin: 0 !important;
      padding-left: 0 !important;
      border: 1px solid rgba(255, 255, 255, 0.08) !important;
      border-radius: 16px !important;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.012)) !important;
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      box-shadow:
        0 1px 1px rgba(0, 0, 0, 0.18),
        0 10px 30px -20px rgba(0, 0, 0, 0.65) !important;
      overflow: hidden;
      transition:
        border-color 0.3s ease,
        box-shadow 0.3s ease,
        background 0.3s ease,
        transform 0.3s ease;
    }

    /* Subtelna złota linia u góry karty */
    .accordion accordion-custom details::before {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(198, 169, 107, 0.5), transparent);
      opacity: 0;
      transition: opacity 0.35s ease;
      pointer-events: none;
      z-index: 1;
    }

    /* Hover — delikatne podświetlenie + lekkie uniesienie */
    @media (hover: hover) {
      .accordion accordion-custom details:hover {
        border-color: rgba(198, 169, 107, 0.45) !important;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02)) !important;
        box-shadow:
          0 1px 1px rgba(0, 0, 0, 0.2),
          0 18px 40px -22px rgba(0, 0, 0, 0.75) !important;
        transform: translateY(-1px);
      }
      .accordion accordion-custom details:hover::before { opacity: 0.7; }
    }

    /* Otwarta (aktywna) — złota ramka + glow */
    .accordion accordion-custom details[open] {
      border-color: rgba(198, 169, 107, 0.6) !important;
      background: linear-gradient(180deg, rgba(198, 169, 107, 0.06), rgba(198, 169, 107, 0.015)) !important;
      box-shadow:
        0 1px 1px rgba(0, 0, 0, 0.2),
        0 20px 46px -22px rgba(0, 0, 0, 0.8),
        0 0 0 1px rgba(198, 169, 107, 0.12),
        0 0 30px -6px rgba(198, 169, 107, 0.18) !important;
    }
    .accordion accordion-custom details[open]::before { opacity: 1; }

    /* Pytanie (summary) — większy obszar dotyku, wyrazista hierarchia */
    .accordion accordion-custom details summary.details__header {
      align-items: center;
      gap: 18px;
      padding: 22px 24px !important;
      min-height: 64px;
      color: #fff;
      font-weight: 600;
      letter-spacing: 0.005em;
      border-radius: 16px;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition: color 0.25s ease, letter-spacing 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .accordion accordion-custom details[open] summary.details__header {
      letter-spacing: 0.02em;
    }
    .accordion accordion-custom details summary.details__header:focus-visible {
      outline: 2px solid rgba(198, 169, 107, 0.85);
      outline-offset: 3px;
    }

    /* Ikona — okrągły badge, strzałka obraca się przy otwieraniu */
    .accordion accordion-custom details summary.details__header .svg-wrapper.icon-caret {
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      margin-inline-start: auto;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.03);
      color: #c6a96b;
      transition: background 0.3s ease, border-color 0.3s ease;
    }
    .accordion accordion-custom details summary.details__header .svg-wrapper.icon-caret svg {
      width: 14px;
      height: 14px;
      fill: none !important;
      stroke: currentColor;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @media (hover: hover) {
      .accordion accordion-custom details:hover summary .svg-wrapper.icon-caret {
        border-color: rgba(198, 169, 107, 0.5);
        background: rgba(198, 169, 107, 0.08);
      }
    }
    .accordion accordion-custom details[open] summary .svg-wrapper.icon-caret {
      border-color: rgba(198, 169, 107, 0.6);
      background: rgba(198, 169, 107, 0.12);
    }

    /* Odpowiedź — spokojniejsza, czytelna; płynne height + opacity + slide */
    .accordion accordion-custom details .details-content {
      padding: 0 24px !important;
      color: rgba(255, 255, 255, 0.62);
      line-height: 1.75;
      transform: translateY(-4px);
    }
    .accordion accordion-custom details .details-content :is(p, li) {
      color: rgba(255, 255, 255, 0.62);
    }
    .accordion accordion-custom details[open] .details-content {
      padding: 2px 24px 24px 24px !important;
      transform: translateY(0);
    }

    /* Płynne rozwijanie/zwijanie — nadpisuje wbudowane transition:none (poza focus) */
    .accordion accordion-custom details .details-content,
    .accordion accordion-custom details::details-content,
    .accordion accordion-custom details:not(:focus-within) .details-content,
    .accordion accordion-custom details:not(:focus-within)::details-content {
      transition:
        content-visibility 0.32s allow-discrete,
        block-size 0.32s cubic-bezier(0.4, 0, 0.2, 1),
        padding-block 0.32s cubic-bezier(0.4, 0, 0.2, 1),
        opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.32s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

    /* Responsywność */
    @media (max-width: 749px) {
      .accordion accordion-custom + accordion-custom { margin-block-start: 12px; }
      .accordion accordion-custom details summary.details__header {
        padding: 18px 18px !important;
        min-height: 60px;
        gap: 12px;
      }
      .accordion accordion-custom details summary.details__header .svg-wrapper.icon-caret {
        width: 30px;
        height: 30px;
      }
      .accordion accordion-custom details .details-content { padding: 0 18px !important; }
      .accordion accordion-custom details[open] .details-content { padding: 2px 18px 20px 18px !important; }
    }
    @media (min-width: 1200px) {
      .accordion accordion-custom + accordion-custom { margin-block-start: 16px; }
      .accordion accordion-custom details summary.details__header { padding: 24px 28px !important; }
      .accordion accordion-custom details .details-content { padding: 0 28px !important; }
      .accordion accordion-custom details[open] .details-content { padding: 4px 28px 28px 28px !important; }
    }

    /* Mniej ruchu = mniej animacji */
    @media (prefers-reduced-motion: reduce) {
      .accordion accordion-custom { animation: none; opacity: 1; }
      .accordion accordion-custom details,
      .accordion accordion-custom details .details-content,
      .accordion accordion-custom details summary .svg-wrapper.icon-caret { transition: none !important; }
      .accordion accordion-custom details .details-content { transform: none; }
    }
    {% endif %}

    /* ===== CONTACT TEXTAREA TRANSITION ===== */
    .contact-form__input--textarea {
      transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease !important;
    }

    /* ===== FAQ GOLDEN BAR SCROLLBAR FIX ===== */
    accordion-custom details {
      position: relative;
    }
    accordion-custom details[open] {
      border-left: 1px solid rgba(201, 168, 76, 0.4);
      padding-left: 16px;
    }

    {% if request.page_type == 'page' %}
    /* ===== CONTACT FORM STAGGER ANIMATION ===== */
    @keyframes fieldReveal {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .contact-form__form-row,
    .contact-form__form > .contact-form__input--textarea,
    .contact-form__form > *:last-child {
      opacity: 0;
      animation: fieldReveal 0.75s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .contact-form__form-row                              { animation-delay: 0.8s; }
    .contact-form__form > .contact-form__input--textarea { animation-delay: 0.98s; }
    .contact-form__form > *:last-child                   { animation-delay: 1.16s; }
    {% endif %}

    {% if template.suffix == 'contact' %}
    /* ===== CONTACT PAGE — sticky footer, bez scrolla strony (desktop) ===== */
    @media (min-width: 750px) {
      html:has(main .contact-form) {
        overflow: hidden;
        height: 100svh;
      }

      body:has(main .contact-form) {
        min-height: 100svh;
        max-height: 100svh;
        overflow: hidden;
      }

      body:has(main .contact-form) #header-group {
        flex-shrink: 0;
      }

      body:has(main .contact-form) #MainContent {
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }

      body:has(main .contact-form) #MainContent > .shopify-section {
        flex-shrink: 0;
        min-height: 0;
      }

      body:has(main .contact-form) #MainContent > .shopify-section.hero-wrapper .hero {
        --hero-min-height: clamp(120px, 16svh, 22svh);
        min-height: var(--hero-min-height);
      }

      body:has(main .contact-form) #MainContent > .shopify-section:has([data-testid^="divider-"]) .section {
        padding-block: 8px !important;
      }

      body:has(main .contact-form) #MainContent > .shopify-section:has(.contact-form) {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      body:has(main .contact-form) #MainContent > .shopify-section:has(.contact-form) .section {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-block-start: 16px !important;
        padding-block-end: 24px !important;
      }

      body:has(main .contact-form) .contact-form__input--textarea {
        min-height: 120px;
        max-height: 22vh;
      }

      body:has(main .contact-form) footer {
        flex-shrink: 0;
      }
    }
    {% endif %}

    #page-transition:not(.closing):not(.pt-init) .pt-seam {
      opacity: 0 !important;
      transition: none !important;
    }
    body.is-navigating [class*="dropdown"],
    body.is-navigating [class*="submenu"],
    body.is-navigating [class*="mega-menu"],
    body.is-navigating [class*="popover"],
    body.is-navigating [class*="nav-"] [class*="child"],
    body.is-navigating details[open] > :not(summary),
    body.is-navigating .header__submenu,
    body.is-navigating [data-open="true"] {
      display: none !important;
      opacity: 0 !important;
      visibility: hidden !important;
    }

    #page-transition.fade-to-splash {
      opacity: 0;
      transition: opacity 1.4s ease;
      pointer-events: none;
    }
    /* Force consistent collection tiles layout between local and live */
    main[data-template*="list-collections"] .resource-list--grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
    @media screen and (min-width: 750px) {
      main[data-template*="list-collections"] .resource-list--grid {
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      }
    }
    {% if template.suffix == 'fotografia-obraz' or template.suffix == 'szablon-wlasna-fotografia' %}
    /* #pm-hero transform sterowany przez pin intro (assets/giclee-photo-mockup.js, --pm-lift).
       NIE wymuszaj tu transform:none ani transition na transform — rozmazuje pin. */
    #pm-hero-ui {
      will-change: transform;
    }
    html body #pm-hero.loaded .pm-cta {
      display: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
      visibility: hidden !important;
      animation: none !important;
    }

    .shopify-section:has(#pm-hero),
    .shopify-section:has(.product-wlasna-fotografia-mockup) {
      position: relative;
      z-index: 60;
      isolation: isolate;
      transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }
    @media screen and (max-width: 749px) {
      .shopify-section:has(#pm-hero),
      .shopify-section:has(.product-wlasna-fotografia-mockup) {
        z-index: 4;
      }
      .menu-drawer,
      .menu-drawer__backdrop {
        z-index: 70;
      }
    }
    body.pm-app-drawer-open .shopify-section:has(#pm-hero),
    body.pm-app-drawer-open .shopify-section:has(.product-wlasna-fotografia-mockup) {
      transform: translateX(-100vw);
    }

    {% if template.suffix == 'fotografia-obraz' %}
    #shopify-section-template--29328540959068__custom_liquid_XCVirJ {
      position: relative;
      z-index: 60;
      isolation: isolate;
      transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }
    body.pm-app-drawer-open #shopify-section-template--29328540959068__custom_liquid_XCVirJ {
      transform: translateX(-100vw);
    }
    {% endif %}

    .shopify-section:has(#giclee-shell) {
      display: block !important;
      position: fixed !important;
      top: 0;
      right: 0;
      width: 100vw;
      height: 100vh;
      z-index: 100;
      transform: translateX(100%);
      transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      pointer-events: none;
      margin: 0 !important;
      padding: 0 !important;
      isolation: isolate;
    }
    .shopify-section:has(#giclee-shell) .section--page-width,
    .shopify-section:has(#giclee-shell) .spacing-style,
    .shopify-section:has(#giclee-shell) .section {
      max-width: none !important;
      width: 100vw !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    body.pm-app-drawer-open .shopify-section:has(#giclee-shell) {
      transform: translateX(0);
      pointer-events: auto;
    }
    #giclee-shell {
      width: 100vw !important;
      height: 100vh !important;
      margin-left: calc(-50vw + 50%) !important;
      position: relative !important;
      overflow: hidden !important;
      background: #000 !important;
    }
    #giclee-tool {
      width: 100% !important;
      height: 100% !important;
      border: 0 !important;
      display: block !important;
      background: #000 !important;
    }
    /* Ukryj pasek przewijania strony, gdy aplikacja jest otwarta */
    html:has(body.pm-app-drawer-open),
    body.pm-app-drawer-open {
      overflow: hidden !important;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    body.pm-app-drawer-open::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }
    html:has(body.pm-app-drawer-open)::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }

    #pm-cta {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
      opacity: 0 !important;
      position: fixed !important;
      right: 16px !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      z-index: 120 !important;
      flex-direction: column !important;
      align-items: center !important;
      gap: 14px !important;
      text-align: center !important;
    }
    #pm-cta .pm-cta-label {
      order: 2;
      margin-top: 4px !important;
    }
    #pm-cta .pm-cta-chevrons {
      order: 1;
      flex-direction: row !important;
      gap: 4px;
      margin-top: 0 !important;
    }
    #pm-cta .pm-cta-chevrons svg {
      transform: rotate(-90deg);
    }
    #pm-cta .pm-cta-chevrons svg:nth-child(1) {
      animation: pmChevronRight 1.8s ease-in-out infinite 0s !important;
    }
    #pm-cta .pm-cta-chevrons svg:nth-child(2) {
      animation: pmChevronRight 1.8s ease-in-out infinite 0.18s !important;
    }
    #pm-cta .pm-cta-chevrons svg:nth-child(3) {
      animation: pmChevronRight 1.8s ease-in-out infinite 0.36s !important;
    }
    @keyframes pmChevronRight {
      0%, 100% { transform: rotate(-90deg) translateX(0); }
      50%      { transform: rotate(-90deg) translateX(6px); }
    }
    @keyframes pmChevronHorizontalForced {
      0%, 100% { transform: rotate(-90deg) translateX(0); }
      50%      { transform: rotate(-90deg) translateX(6px); }
    }
    @keyframes pmChevron {
      0%, 100% { transform: rotate(-90deg) translateX(0); }
      50%      { transform: rotate(-90deg) translateX(6px); }
    }

    #pm-back-to-preview {
      position: fixed;
      top: 16px;
      left: 16px;
      z-index: 140;
      display: none;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.28);
      background: rgba(0,0,0,0.72);
      color: rgba(255,255,255,0.92);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    body.pm-app-drawer-open #pm-back-to-preview {
      display: inline-flex;
    }
    #pm-left-rail {
      position: absolute;
      left: clamp(20px, 4vw, 52px);
      top: 50%;
      transform: translateY(-50%) translateX(-18px);
      max-width: min(44ch, 46vw);
      z-index: 25;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(20px, 3vh, 32px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.85s cubic-bezier(0.22, 1, 0.36, 1),
                  visibility 0.85s;
    }
    html body #pm-hero.loaded #pm-left-rail {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(-50%) translateX(0);
