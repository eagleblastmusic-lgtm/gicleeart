    body.template-page-faq .faq-section .accordion::before,
    body.template-page-faq .faq-section .accordion::after {
      content: "";
      position: absolute;
      left: 50%;
      z-index: 1;
      pointer-events: none;
    }

    /* Szerokie, miękkie halo schodzące w dół */
    body.template-page-faq .faq-section .accordion::before {
      top: calc(100% + 2px);
      width: min(980px, 118%);
      height: 112px;
      transform: translateX(-50%);
      opacity: 0.94;
      background:
        radial-gradient(
          ellipse 52% 18% at 50% 9%,
          rgba(255, 240, 214, 0.27) 0%,
          rgba(231, 176, 107, 0.18) 20%,
          rgba(177, 103, 42, 0.09) 43%,
          rgba(91, 44, 14, 0.032) 66%,
          transparent 84%
        ),
        radial-gradient(
          ellipse 78% 54% at 50% 17%,
          rgba(191, 111, 42, 0.085) 0%,
          rgba(103, 51, 16, 0.034) 50%,
          transparent 80%
        );
      filter:
        brightness(calc(1 + var(--faq-accordion-distance-energy, 0) * 1.1))
        blur(11px);
    }

    /* Jasny rdzeń — bardzo płaska elipsa, wygięta w dół */
    body.template-page-faq .faq-section .accordion::after {
      top: calc(100% - 2px);
      width: min(760px, 84%);
      height: 22px;
      transform: translateX(-50%);
      border: 0;
      border-bottom: 1px solid rgba(255, 239, 211, 0.78);
      border-radius: 50%;
      opacity: 0.92;
      background: radial-gradient(
        ellipse 58% 95% at 50% 100%,
        rgba(255, 232, 197, 0.16) 0%,
        rgba(217, 147, 76, 0.08) 42%,
        transparent 74%
      );
      -webkit-mask-image: linear-gradient(
        90deg,
        transparent 0%,
        rgba(0, 0, 0, 0.12) 12%,
        rgba(0, 0, 0, 0.55) 31%,
        #000 50%,
        rgba(0, 0, 0, 0.55) 69%,
        rgba(0, 0, 0, 0.12) 88%,
        transparent 100%
      );
      mask-image: linear-gradient(
        90deg,
        transparent 0%,
        rgba(0, 0, 0, 0.12) 12%,
        rgba(0, 0, 0, 0.55) 31%,
        #000 50%,
        rgba(0, 0, 0, 0.55) 69%,
        rgba(0, 0, 0, 0.12) 88%,
        transparent 100%
      );
      filter:
        brightness(calc(1 + var(--faq-accordion-distance-energy, 0) * 1.45))
        drop-shadow(0 0 5px rgba(255, 229, 188, 0.19))
        drop-shadow(0 7px 18px rgba(199, 120, 48, 0.11))
        drop-shadow(0 18px 32px rgba(132, 67, 20, 0.06));
