    /* ===== FAQ — dekoracje tła (SVG łuki / elipsa / poświata; bez zmiany tła foto) ===== */
    /*
     * Stacking: hero + divider NAD okręgami, ale FAQ (grafika + gradient) zostaje
     * w normalnym malowaniu sekcji — bez obniżania całej sekcji FAQ (to gubiło gradient).
     * Okręgi mają z-index: 0 wewnątrz FAQ; hero/divider tworzą wyższy kontekst.
     */
    body.template-page-faq #MainContent > .shopify-section:has(.hero) {
      position: relative;
      z-index: 3;
      transform: translate3d(0, var(--faq-hero-scroll-y, 0px), 0);
      opacity: var(--faq-hero-scroll-opacity, 1);
      filter: blur(var(--faq-hero-scroll-blur, 0px));
      will-change: transform, opacity, filter;
    }

    body.template-page-faq #MainContent > .shopify-section[id$="__divider_YLiHg7"] {
      position: relative;
      z-index: 3;
      background: transparent !important;
    }

    body.template-page-faq #MainContent > .shopify-section[id$="__divider_YLiHg7"] > .section-background {
      background: transparent !important;
    }

    /* FAQ: clip — zapobiega wyciekaniu ozdób (złotych łuków i tarcz) pod sekcję w stronę stopki */
    body.template-page-faq #MainContent > .shopify-section:has(.faq-section) {
      --faq-scroll-bg-extension: 0px;
      position: relative;
      z-index: 4;
      overflow: clip;
      margin-block-start: calc(-1 * var(--faq-scroll-bg-extension));
    }

    body.template-page-faq .faq-section {
      position: relative;
      overflow: clip;
      isolation: isolate;
      padding-block-start: var(--faq-scroll-bg-extension);
