  <style>
    #page-transition {
      position: fixed;
      inset: 0;
      z-index: 99998;
      pointer-events: none;
      display: flex;
    }
    #page-transition.active,
    #page-transition.pt-init,
    #page-transition.closing,
    #page-transition.opening {
      z-index: 2147483647;
    }
    #page-transition.active {
      pointer-events: all;
    }
    #page-transition.opening {
      pointer-events: none;
    }
    #page-transition.closing,
    #page-transition.pt-init {
      pointer-events: all;
    }
    .pt-panel {
      position: fixed;
      top: 0;
      width: 50%;
      height: 100%;
      background: #080808;
      will-change: transform;
      --pt-open-duration: 1.25s;
      --pt-close-duration: 0.72s;
      transition: transform var(--pt-open-duration) cubic-bezier(0.45, 0, 0.15, 1);
    }
    .pt-left {
      left: 0;
      transform: translateX(-100%);
    }
    .pt-right {
      right: 0;
      transform: translateX(100%);
    }
    .pt-seam {
      position: fixed;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 1px;
      height: 100%;
      background: linear-gradient(to bottom, transparent 10%, #c9a84c 40%, #c9a84c 60%, transparent 90%);
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1;
      pointer-events: none;
    }
    #page-transition.pt-init .pt-left,
    #page-transition.closing .pt-left {
      transform: translateX(0);
    }
    #page-transition.pt-init .pt-right,
    #page-transition.closing .pt-right {
      transform: translateX(0);
    }
    #page-transition.pt-init .pt-panel,
    #page-transition.closing .pt-panel {
      transition: transform var(--pt-close-duration, 0.72s) cubic-bezier(0.76, 0, 0.24, 1);
    }
    #page-transition.pt-init .pt-seam {
      opacity: 1;
      transition: none !important;
    }
    #page-transition.closing .pt-seam {
      opacity: 1;
      transition: opacity 0.25s ease;
      transition-delay: 0.45s;
    }
    #page-transition.opening .pt-left {
      transform: translateX(-100%);
    }
    #page-transition.opening .pt-right {
      transform: translateX(100%);
    }
    #page-transition.opening .pt-panel {
      transition: transform var(--pt-open-duration, 1.25s) cubic-bezier(0.45, 0, 0.15, 1);
    }
    #page-transition.opening .pt-seam {
      opacity: 0;
      transition-delay: 0s;
    }

    body.curtain-content-hide .product-grid__item,
    body.curtain-content-hide .product-grid__item .card-gallery,
    body.curtain-content-hide .product-grid__item .card-gallery img,
    body.curtain-content-hide .product-grid__item product-card {
      visibility: hidden !important;
      opacity: 0 !important;
      transform: none !important;
      z-index: auto !important;
      transition: none !important;
    }
    body.is-navigating [data-view-transition-type],
    body.is-navigating [data-view-transition-triggered] {
      view-transition-name: none !important;
    }
    /* Hero text — cienie FAQ / Blog (klasy body z layout/theme.liquid) */
    body.template-page-faq #MainContent .hero__content-wrapper :is(h1, h2, h3, h4, h5, h6),
    body.template-page-faq #MainContent .hero__content-wrapper .text-block :is(h1, h2, h3, h4, h5, h6),
    body.template-blog #MainContent .hero__content-wrapper :is(h1, h2, h3, h4, h5, h6, p),
    body.template-blog #MainContent .hero__content-wrapper .text-block :is(h1, h2, h3, h4, h5, h6, p),
    body.template-blog #MainContent .hero__content-wrapper :is(.rte, rte-formatter) {
      text-shadow:
        0 1px 2px rgba(0, 0, 0, 0.55),
        0 4px 18px rgba(0, 0, 0, 0.45),
        0 0 28px rgba(0, 0, 0, 0.35) !important;
    }
    /*
      Hero wyłącza pointer-events na .hero__content-wrapper (tylko a/button…).
      Bez auto tekst nie dostaje mouseenter — hover GSAP nie działa.
    */
    body.template-page-faq #MainContent .hero__content-wrapper .giclee-hero-text-hover,
    body.template-blog #MainContent .hero__content-wrapper .giclee-hero-text-hover {
      pointer-events: auto;
      cursor: pointer;
    }

    {% if template.suffix == 'faq' %}
    /* =====================================================================
       FAQ — PREMIUM ACCORDION (tylko UI/UX, treść bez zmian)
       Zakres: wyłącznie strona FAQ (template.suffix == 'faq').
       Wyższa specyficzność + !important nadpisuje globalne .accordion z base.css
       jedynie na tej stronie — inne akordeony (np. produkt) bez zmian.
       ===================================================================== */

    /* Tło pod hero — grafika / gradient (GicleeApp → Tło pod hero) */
    body.template-page-faq .shopify-section:has(.faq-section) > .section-background--faq-custom {
      background: #000 !important;
    }

    body.template-page-faq .shopify-section:has(.faq-section) > .section-background--faq-gradient {
      background: transparent !important;
    }

    /* Grafika: absolutny bleed — bez tego kontener ma wysokość 0 (img jest absolute). */
    body.template-page-faq .faq-section.faq-section--bg-image {
      position: relative;
      isolation: isolate;
      overflow: clip;
      background-color: #000;
    }

    /*
     * Tło tylko w granicach sekcji (inset:0) — bez nachodzenia na stopkę.
     * Sam obraz ma stałą wysokość 100lvh i jest wycentrowany, żeby otwarcie
     * akordeonu nie zmieniało kadru (zoom).
     */
    body.template-page-faq .faq-section.faq-section--bg-image .custom-section-background {
      position: absolute;
      inset: 0;
      grid-column: 1 / -1;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
      background-color: #000;
    }

    /* Tło i jego potomkowie nigdy nie przechwytują kliknięć ani nie malują nad treścią. */
    body.template-page-faq .faq-section.faq-section--bg-image .custom-section-background,
    body.template-page-faq .faq-section.faq-section--bg-image .custom-section-background * {
      pointer-events: none !important;
    }

    body.template-page-faq .faq-section.faq-section--bg-image .custom-section-content {
      position: relative;
      z-index: 2;
      isolation: isolate;
    }

    /*
     * Hierarchia tła pod hero — osobne parametry z GicleeApp:
     * --faq-bg-blur (px), --faq-bg-saturate (%), --faq-bg-brightness (%),
     * --faq-bg-dim-overlay (%), --faq-bg-scale (% zoom).
     */
    /*
     * Stały kadr 100lvh jest zakotwiczony u góry sekcji. Otwarcie odpowiedzi
     * wydłuża wyłącznie czarne tło sekcji w dół — bez przesuwania i skalowania obrazu.
     */
    body.template-page-faq .faq-section.faq-section--bg-image .background-image-container,
    body.template-page-faq .faq-section.faq-section--bg-image video-background-component {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100lvh;
      max-height: none;
      transform: scale(calc(1 + var(--faq-bg-scale, 0) * 0.01));
      transform-origin: center center;
      filter:
        blur(calc(var(--faq-bg-blur, 0) * 1px))
        saturate(calc(var(--faq-bg-saturate, 100) * 0.01))
        brightness(calc(var(--faq-bg-brightness, 100) * 0.01));
    }

    /* Stopka zawsze nad tłem FAQ oraz nad giclee-faq-hero-curtain (z-index: 900) */
    body.template-page-faq > footer,
    body.template-page-faq footer,
    body.template-page-faq .footer-group {
      position: relative !important;
      z-index: 1001 !important;
      background-color: #000 !important;
      border-top: none !important;
      box-shadow: none !important;
    }

    /* Brak scroll-anchoring przy otwarciu — mniej skoków kadru / parallax */
    body.template-page-faq .faq-section .accordion accordion-custom,
    body.template-page-faq .faq-section .accordion accordion-custom details {
      overflow-anchor: none;
    }

    body.template-page-faq .faq-section.faq-section--bg-image .giclee-section-bg-overlay {
      position: absolute;
    }

    body.template-page-faq .faq-section.faq-section--bg-image .giclee-section-bg-overlay::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: #000;
      opacity: calc(var(--faq-bg-dim-overlay, 0) * 0.01);
    }

    /* Zanikanie tła pod hero — góra i dół (jak BIO wide_bottom / home menu-wide) */
    body.template-page-faq .faq-section.faq-section--bg-image {
      --faq-bg-fade-height: clamp(80px, 16vh, 150px);
    }

    body.template-page-faq .faq-section.faq-section--bg-image .custom-section-background::before,
    body.template-page-faq .faq-section.faq-section--bg-image .custom-section-background::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      z-index: 4;
      height: var(--faq-bg-fade-height);
      pointer-events: none;
    }

    body.template-page-faq .faq-section.faq-section--bg-image .custom-section-background::before {
      top: 0;
      background: linear-gradient(
        180deg,
        #000 0%,
        #000 12%,
        rgba(0, 0, 0, 0.94) 30%,
        rgba(0, 0, 0, 0.72) 52%,
        rgba(0, 0, 0, 0.28) 78%,
        transparent 100%
      );
    }

    body.template-page-faq .faq-section.faq-section--bg-image .custom-section-background::after {
      bottom: 0;
      background: linear-gradient(
        0deg,
        #000 0%,
        #000 12%,
        rgba(0, 0, 0, 0.94) 30%,
        rgba(0, 0, 0, 0.72) 52%,
        rgba(0, 0, 0, 0.28) 78%,
        transparent 100%
      );
    }

    body.template-page-faq .faq-section.faq-section--gradient-v1,
    body.template-page-faq .faq-section.faq-section--gradient-v1 .custom-section-background {
      background:
        radial-gradient(
          ellipse 70% 38% at 50% 0%,
          rgba(140, 108, 76, 0.20) 0%,
          rgba(69, 52, 39, 0.10) 38%,
          transparent 72%
        ),
        linear-gradient(
          180deg,
          #17130f 0%,
          #0b0907 22%,
          #030303 52%,
          #000 100%
        ) !important;
    }

    body.template-page-faq .faq-section.faq-section--gradient-v2,
    body.template-page-faq .faq-section.faq-section--gradient-v2 .custom-section-background {
      background:
        radial-gradient(
          ellipse 65% 42% at 50% 0%,
          rgba(150, 112, 78, 0.22) 0%,
          rgba(70, 51, 37, 0.09) 42%,
          transparent 72%
        ),
        radial-gradient(
          ellipse at center,
          transparent 35%,
          rgba(0, 0, 0, 0.55) 100%
        ),
        linear-gradient(
          180deg,
          #16120f 0%,
          #090807 25%,
          #000 65%
        ) !important;
    }

    body.template-page-faq .faq-section.faq-section--gradient-v1,
    body.template-page-faq .faq-section.faq-section--gradient-v2 {
      position: relative;
      --faq-bg-fade-height: clamp(80px, 16vh, 150px);
    }

    body.template-page-faq .faq-section.faq-section--gradient-v1::before,
    body.template-page-faq .faq-section.faq-section--gradient-v1::after,
    body.template-page-faq .faq-section.faq-section--gradient-v2::before,
    body.template-page-faq .faq-section.faq-section--gradient-v2::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      z-index: 0;
      height: var(--faq-bg-fade-height);
      pointer-events: none;
    }

    body.template-page-faq .faq-section.faq-section--gradient-v1::before,
    body.template-page-faq .faq-section.faq-section--gradient-v2::before {
      top: 0;
      background: linear-gradient(
        180deg,
        #000 0%,
        #000 12%,
        rgba(0, 0, 0, 0.94) 30%,
        rgba(0, 0, 0, 0.72) 52%,
        rgba(0, 0, 0, 0.28) 78%,
        transparent 100%
      );
    }

    body.template-page-faq .faq-section.faq-section--gradient-v1::after,
    body.template-page-faq .faq-section.faq-section--gradient-v2::after {
      bottom: 0;
      background: linear-gradient(
        0deg,
        #000 0%,
        #000 12%,
        rgba(0, 0, 0, 0.94) 30%,
        rgba(0, 0, 0, 0.72) 52%,
        rgba(0, 0, 0, 0.28) 78%,
        transparent 100%
      );
    }

    body.template-page-faq .faq-section.faq-section--gradient-v1 > .custom-section-content,
    body.template-page-faq .faq-section.faq-section--gradient-v2 > .custom-section-content {
      position: relative;
      z-index: 1;
    }

    /* Separatory (divider) — mniej jaskrawe na czarnym tle */
    #MainContent .divider .divider__line {
      opacity: 0.8;
    }

    accordion-custom {
      /* szybsze, płynne rozwijanie (komponent czyta tę zmienną) */
      --animation-speed-slow: 320ms;
      --animation-easing: cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Wejście kart — GSAP (assets/faq-accordion-entrance.js); tu tylko layout */
    .accordion accordion-custom {
      display: block;
    }

    /* Odstęp między kartami (stała szerokość kontenera bez zmian) */
    .accordion accordion-custom + accordion-custom { margin-block-start: 14px; }

    /* Karta — glassmorphism + miękki cień (na details, by radius clipował treść) */
    .accordion accordion-custom details {
      position: relative;
      margin: 0 !important;
      padding-left: 0 !important;
      /* Idle: obwódka rgb(18,18,18) */
      border: 1px solid rgb(18, 18, 18) !important;
      border-radius: 16px !important;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.012)) !important;
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      box-shadow:
        0 1px 1px rgba(0, 0, 0, 0.18),
        0 10px 30px -20px rgba(0, 0, 0, 0.65) !important;
      overflow: hidden;
      transition:
        border-color 0.3s ease,
        box-shadow 0.3s ease,
        background 0.3s ease,
        transform 0.3s ease;
    }

    /* Wiersze z grafiką — ciemne tło pod gradientem widoczności obrazu */
    .accordion accordion-custom details.details--art {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .accordion accordion-custom details.details--art:not(.details--art-shared) {
      background: #050505 !important;
    }
    /* Shared: nie używać shorthand `background` — kasuje obraz z CSS variables */
    .accordion accordion-custom details.details--art-shared {
      /* Idle: ta sama obwódka co pozostałe karty */
      border-color: rgb(18, 18, 18) !important;
      background-color: #050505 !important;
      background-image:
        linear-gradient(
          90deg,
          rgb(5, 5, 5) 0%,
          rgba(5, 5, 5, 0.98) calc(var(--faq-art-gradient-reach, 100) * 0.42%),
          rgba(5, 5, 5, 0.94) calc(var(--faq-art-gradient-reach, 100) * 0.58%),
          rgba(5, 5, 5, 0.78) calc(var(--faq-art-gradient-reach, 100) * 0.72%),
          rgba(5, 5, 5, 0.42) calc(var(--faq-art-gradient-reach, 100) * 0.84%),
          rgba(5, 5, 5, 0.14) calc(var(--faq-art-gradient-reach, 100) * 0.93%),
          rgba(5, 5, 5, 0.02) calc(var(--faq-art-gradient-reach, 100) * 1%),
          transparent calc(var(--faq-art-gradient-reach, 100) * 1%)
        ),
        var(--details-art-image) !important;
      /* cover na niskiej karcie nie daje panu X — szerszy kadr (−50…150%) */
      background-size: auto, 200% auto !important;
      background-position: 0 0, var(--details-art-ox, 72%) var(--details-art-oy, 50%) !important;
      background-repeat: no-repeat !important;
      background-clip: padding-box !important;
      box-shadow:
        0 10px 30px -20px rgba(0, 0, 0, 0.65) !important;
    }
    .accordion accordion-custom details.details--art .details__art-veil {
      background: linear-gradient(
        90deg,
        rgb(5, 5, 5) 0%,
        rgba(5, 5, 5, 0.98) calc(var(--faq-art-gradient-reach, 100) * 0.42%),
        rgba(5, 5, 5, 0.94) calc(var(--faq-art-gradient-reach, 100) * 0.58%),
        rgba(5, 5, 5, 0.78) calc(var(--faq-art-gradient-reach, 100) * 0.72%),
        rgba(5, 5, 5, 0.42) calc(var(--faq-art-gradient-reach, 100) * 0.84%),
        rgba(5, 5, 5, 0.14) calc(var(--faq-art-gradient-reach, 100) * 0.93%),
        rgba(5, 5, 5, 0.02) calc(var(--faq-art-gradient-reach, 100) * 1%),
        transparent calc(var(--faq-art-gradient-reach, 100) * 1%)
      );
    }
    .accordion accordion-custom details.details--art .details__heading-label {
      text-shadow:
        0 1px 2px rgba(0, 0, 0, 0.9),
        0 2px 14px rgba(0, 0, 0, 0.75);
    }

    /* Subtelna złota linia u góry karty */
    .accordion accordion-custom details::before {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(198, 169, 107, 0.5), transparent);
      opacity: 0;
      transition: opacity 0.35s ease;
      pointer-events: none;
      z-index: 1;
    }

    /* Hover — delikatne podświetlenie + lekkie uniesienie */
    @media (hover: hover) {
      .accordion accordion-custom details:not(.details--art-shared):hover {
        border-color: rgba(198, 169, 107, 0.45) !important;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02)) !important;
        box-shadow:
          0 1px 1px rgba(0, 0, 0, 0.2),
          0 18px 40px -22px rgba(0, 0, 0, 0.75) !important;
        transform: translateY(-1px);
      }
      .accordion accordion-custom details.details--art-shared:hover {
        border-color: rgba(198, 169, 107, 0.45) !important;
        box-shadow:
          0 0 0 1px #000,
          inset 0 0 0 1px rgba(0, 0, 0, 0.55),
          0 18px 40px -22px rgba(0, 0, 0, 0.75) !important;
        transform: translateY(-1px);
      }
      .accordion accordion-custom details.details--art:not(.details--art-shared):hover {
        background: #050505 !important;
      }
      .accordion accordion-custom details:hover::before { opacity: 0.7; }
    }

    /*
      Fokus hover akordeonu (blur pozostałych + kaskadowy powrót) —
      assets/faq-accordion-entrance.js → initAccordionFocusBlur.
    */

    /* Otwarta (aktywna) — złota ramka + glow */
    .accordion accordion-custom details:not(.details--art-shared)[open] {
      border-color: rgba(198, 169, 107, 0.6) !important;
      background: linear-gradient(180deg, rgba(198, 169, 107, 0.06), rgba(198, 169, 107, 0.015)) !important;
      box-shadow:
        0 1px 1px rgba(0, 0, 0, 0.2),
        0 20px 46px -22px rgba(0, 0, 0, 0.8),
        0 0 0 1px rgba(198, 169, 107, 0.12),
        0 0 30px -6px rgba(198, 169, 107, 0.18) !important;
    }
    .accordion accordion-custom details.details--art-shared[open] {
      border-color: rgba(198, 169, 107, 0.6) !important;
      box-shadow:
        0 0 0 1px #000,
        inset 0 0 0 1px rgba(0, 0, 0, 0.55),
        0 20px 46px -22px rgba(0, 0, 0, 0.8),
        0 0 0 1px rgba(198, 169, 107, 0.12),
        0 0 30px -6px rgba(198, 169, 107, 0.18) !important;
    }
    .accordion accordion-custom details.details--art:not(.details--art-shared)[open] {
      background: #050505 !important;
    }
    .accordion accordion-custom details[open]::before { opacity: 1; }

    /* Pytanie (summary) — większy obszar dotyku, wyrazista hierarchia */
    .accordion accordion-custom details summary.details__header {
      align-items: center;
      gap: 18px;
      padding: 22px 24px !important;
      min-height: 64px;
      color: rgba(255, 255, 255, 0.86);
      font-weight: 600;
      letter-spacing: 0.005em;
      border-radius: 16px;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition: color 0.25s ease, letter-spacing 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .accordion accordion-custom details[open] summary.details__header {
      letter-spacing: 0.02em;
    }
    .accordion accordion-custom details summary.details__header:focus-visible {
      outline: 2px solid rgba(198, 169, 107, 0.85);
      outline-offset: 3px;
    }

    /* Ikona — okrągły badge, strzałka obraca się przy otwieraniu */
    .accordion accordion-custom details summary.details__header .svg-wrapper.icon-caret {
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      margin-inline-start: auto;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.03);
      color: #c8cdd4;
      transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    }
    /* Przy tle-obrazie: nieprzezroczyste tło, żeby grafika nie wchodziła w przycisk */
    .accordion accordion-custom details.details--art summary.details__header .svg-wrapper.icon-caret {
      background: #0a0a0a;
      background-image: none;
      isolation: isolate;
      z-index: 3;
    }
    .accordion accordion-custom details summary.details__header .svg-wrapper.icon-caret svg {
      width: 14px;
      height: 14px;
      color: inherit;
      fill: none !important;
      stroke: currentColor;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @media (hover: hover) {
      .accordion accordion-custom details:hover summary .svg-wrapper.icon-caret {
        border-color: rgba(255, 255, 255, 0.28);
        background: rgba(200, 205, 212, 0.08);
        color: #e8ecf0;
      }
      .accordion accordion-custom details.details--art:hover summary .svg-wrapper.icon-caret {
        background: #121216;
        background-image: none;
      }
    }
    .accordion accordion-custom details[open] summary .svg-wrapper.icon-caret {
      border-color: rgba(255, 255, 255, 0.28);
      background: rgba(200, 205, 212, 0.12);
      color: #e8ecf0;
    }
    .accordion accordion-custom details.details--art[open] summary .svg-wrapper.icon-caret {
      background: #121216;
      background-image: none;
    }

    /* Odpowiedź — spokojniejsza, czytelna; płynne height + opacity + slide */
    .accordion accordion-custom details .details-content,
    .accordion accordion-custom details::details-content {
      color: rgba(255, 255, 255, 0.62);
      line-height: 1.75;
      /* stan zwinięty = cel animacji zamykania (bez visibility/content-visibility — ucinały exit) */
      block-size: 0;
      min-block-size: 0;
      opacity: 0;
      padding-block: 0 !important;
      padding-inline: 24px !important;
      overflow-y: clip;
      transform: translateY(-4px);
      interpolate-size: allow-keywords;
      transition:
        display 0.32s allow-discrete,
        content-visibility 0.32s allow-discrete,
        block-size 0.32s cubic-bezier(0.4, 0, 0.2, 1),
        padding-block 0.32s cubic-bezier(0.4, 0, 0.2, 1),
        opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.32s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    .accordion accordion-custom details .details-content :is(p, li) {
      color: rgba(255, 255, 255, 0.62);
    }
    .accordion accordion-custom details[open] .details-content,
    .accordion accordion-custom details[open]::details-content {
      block-size: auto;
      opacity: 1;
      padding-block: 2px 24px !important;
      transform: translateY(0);
      overflow-y: clip;

      @starting-style {
        block-size: 0;
        opacity: 0;
        padding-block: 0;
        transform: translateY(-4px);
      }
    }
    /* nadpisz transition:none z accordion-custom (poza focus) — bez tego zamykanie jest skokowe */
    .accordion accordion-custom details:not(:focus-within) .details-content,
    .accordion accordion-custom details:not(:focus-within)::details-content {
      transition:
        display 0.32s allow-discrete,
        content-visibility 0.32s allow-discrete,
        block-size 0.32s cubic-bezier(0.4, 0, 0.2, 1),
        padding-block 0.32s cubic-bezier(0.4, 0, 0.2, 1),
        opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.32s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    .accordion accordion-custom details.details--art-shared summary.details__header {
      border-radius: 0;
    }

    /* =====================================================================
       FAQ Style 2 — świecący hover jak Galaxy Button («Losuj obraz»)
       Klasa: .faq-accordion-style2 (GicleeApp → Pytania i odpowiedzi → Styl)
       ===================================================================== */
    .faq-accordion-style2 .accordion accordion-custom details {
      --faq-gx: 50%;
      --faq-gy: 50%;
      /* Krawędź jak .giclee-galaxy-btn__shell (2px · rgba(255,255,255,0.15)) */
      border: 2px solid rgba(255, 255, 255, 0.15) !important;
      box-shadow:
        0 1px 1px rgba(0, 0, 0, 0.2),
        0 12px 32px -22px rgba(0, 0, 0, 0.7) !important;
      transition:
        border-color 0.45s ease,
        box-shadow 0.45s ease,
        transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
        background 0.45s ease;
    }

    .faq-accordion-style2 .accordion accordion-custom details:not(.details--art) {
      background: rgba(0, 0, 0, 0.81) !important;
      -webkit-backdrop-filter: blur(20px);
      backdrop-filter: blur(20px);
    }

    .faq-accordion-style2 .accordion accordion-custom details.details--art:not(.details--art-shared) {
      background: #050505 !important;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    /* Grafika na karcie pytania (shared) — zachowana; shell Galaxy zamiast czarnej ramki */
    .faq-accordion-style2 .accordion accordion-custom details.details--art-shared {
      border: 2px solid rgba(255, 255, 255, 0.15) !important;
      background-color: #050505 !important;
      background-image:
        linear-gradient(
          90deg,
          rgb(5, 5, 5) 0%,
          rgba(5, 5, 5, 0.98) calc(var(--faq-art-gradient-reach, 100) * 0.42%),
          rgba(5, 5, 5, 0.94) calc(var(--faq-art-gradient-reach, 100) * 0.58%),
          rgba(5, 5, 5, 0.78) calc(var(--faq-art-gradient-reach, 100) * 0.72%),
          rgba(5, 5, 5, 0.42) calc(var(--faq-art-gradient-reach, 100) * 0.84%),
          rgba(5, 5, 5, 0.14) calc(var(--faq-art-gradient-reach, 100) * 0.93%),
          rgba(5, 5, 5, 0.02) calc(var(--faq-art-gradient-reach, 100) * 1%),
          transparent calc(var(--faq-art-gradient-reach, 100) * 1%)
        ),
        var(--details-art-image) !important;
      background-size: auto, 200% auto !important;
      background-position: 0 0, var(--details-art-ox, 72%) var(--details-art-oy, 50%) !important;
      background-repeat: no-repeat !important;
      background-clip: padding-box !important;
      box-shadow:
        0 12px 32px -22px rgba(0, 0, 0, 0.7) !important;
    }

    /*
      Pointer-follow jak Galaxy Button:
      — ::before: bardzo stonowany fill pod kursorem
      — ::after: świecący pierścień na krawędzi (maska = tylko 2px shell)
    */
    .faq-accordion-style2 .accordion accordion-custom details::before {
      inset: 0;
      height: auto;
      background: radial-gradient(
        circle 120px at var(--faq-gx, 50%) var(--faq-gy, 50%),
        rgba(200, 205, 212, 0.14) 0%,
        rgba(200, 205, 212, 0.04) 40%,
        transparent 72%
      );
      opacity: 0;
      filter: blur(2px);
      z-index: 2;
      mix-blend-mode: screen;
      transition: opacity 0.45s ease;
    }

    .faq-accordion-style2 .accordion accordion-custom details::after {
      content: "";
      position: absolute;
      inset: 0;
      height: auto;
      border-radius: inherit;
      padding: 2px;
      background: radial-gradient(
        circle 130px at var(--faq-gx, 50%) var(--faq-gy, 50%),
        rgba(200, 205, 212, 0.95) 0%,
        rgba(200, 205, 212, 0.55) 28%,
        rgba(200, 205, 212, 0.12) 55%,
        transparent 72%
      );
      -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      pointer-events: none;
      z-index: 5;
      transition: opacity 0.45s ease;
    }

    .faq-accordion-style2 .accordion accordion-custom details summary.details__header,
    .faq-accordion-style2 .accordion accordion-custom details .details-content,
