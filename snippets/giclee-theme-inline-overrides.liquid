      .faq-accordion-style2 .accordion accordion-custom details::after {
        display: none;
      }
    }

    /* =====================================================================
       FAQ Style 3 — Galaxy («Losuj obraz»): shell / plate (bez orbów / Lottie)
       Klasa: .faq-accordion-style3 · chrome: assets/faq-accordion-galaxy.css
