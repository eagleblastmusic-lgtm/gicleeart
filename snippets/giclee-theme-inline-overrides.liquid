    /* Dekoracje — pozycje z obniżeniem o 160px; parallax GSAP (yPercent + scrub) */
    body.template-page-faq .faq-artwork-decoration {
      position: absolute;
      top: calc(var(--faq-decoration-anchor-y, 50%) + 160px);
      z-index: 0;
      pointer-events: none;
      transform: translateY(-50%);
      will-change: transform, filter;
    }

    body.template-page-faq .faq-artwork-decoration svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    body.template-page-faq .faq-artwork-decoration--left {
      left: clamp(-290px, -14vw, -120px);
      width: clamp(420px, 39vw, 720px);
      height: min(92vh, 920px);
      opacity: 0.74;
      filter: brightness(
        calc(1 + var(--faq-accordion-distance-energy, 0) * 0.9)
      );
      -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 58%, transparent 100%);
      mask-image: linear-gradient(90deg, #000 0%, #000 58%, transparent 100%);
    }

    /* Prawa tarcza — wyżej (-80px offset) */
    body.template-page-faq .faq-disc--right {
      position: absolute;
      z-index: 0;
      pointer-events: none;
      top: calc(var(--faq-decoration-anchor-y, 50%) - 80px);
      right: clamp(-170px, -7vw, -70px);
      width: clamp(310px, 28vw, 520px);
      aspect-ratio: 0.64;
      transform: translateY(-50%);
      opacity: 0.75;
      overflow: visible;
      filter: brightness(
        calc(1 + var(--faq-accordion-distance-energy, 0) * 1.15)
      );
      will-change: transform, filter;
    }

    body.template-page-faq .faq-disc__surface,
    body.template-page-faq .faq-disc__ring {
      position: absolute;
      border-radius: 50%;
    }

    body.template-page-faq .faq-disc__surface {
      inset: 5%;
      background:
        radial-gradient(
          ellipse at 34% 48%,
          rgba(225, 229, 230, 0.1) 0%,
          rgba(131, 138, 142, 0.07) 27%,
          rgba(50, 54, 57, 0.07) 52%,
          rgba(5, 6, 7, 0) 74%
        ),
        repeating-linear-gradient(
          82deg,
          rgba(255, 255, 255, 0.012) 0,
          rgba(255, 255, 255, 0.012) 1px,
          transparent 1px,
          transparent 4px
        );
      box-shadow:
        inset 18px 0 45px rgba(255, 255, 255, 0.02),
        inset -30px 0 60px rgba(0, 0, 0, 0.7);
      opacity: 0.72;
    }

    body.template-page-faq .faq-disc__ring {
      border-style: solid;
      border-color: rgba(220, 228, 232, 0.65);
      box-shadow:
        0 0 16px rgba(220, 228, 232, 0.15),
        inset 0 0 12px rgba(255, 255, 255, 0.1);
    }

    body.template-page-faq .faq-disc__ring--outer {
      inset: 0;
      border-width: 1px;
      border-color: rgba(215, 225, 230, 0.6);
    }

    body.template-page-faq .faq-disc__ring--middle {
      inset: 5%;
      border-width: 1px;
      border-color: rgba(235, 240, 245, 0.7);
    }

    body.template-page-faq .faq-disc__ring--inner {
      inset: 10%;
      border-width: 1px;
      border-color: rgba(245, 248, 250, 0.45);
    }

