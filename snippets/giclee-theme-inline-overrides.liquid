      to   { opacity: 1; transform: translateY(-50%) translateX(0); filter: blur(0); }
    }
    @keyframes pmRailAmbient {
      0%, 100% {
        transform: translateY(-50%) translateX(0);
      }
      50% {
        transform: translateY(calc(-50% - 3px)) translateX(0);
      }
    }
    @keyframes pmInviteAmbientMobile {
      0%, 100% {
        text-shadow: 0 8px 26px rgba(0, 0, 0, 0.55);
        transform: translateX(-50%) translateY(0);
