{%- doc -%}
  Renders media block contents (used in _media and _media-without-appearance blocks)

  @param {object} [block] - The block object
  @param {boolean} [unset_image_tag] - if true, ignores the image focal point in the image
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign show_image = false
  assign show_video = false
  assign show_scroll_video = false

  if block_settings.media_type == 'image'
    assign show_image = true
  endif

  if block_settings.media_type == 'video'
    assign show_video = true
  endif

  if block_settings.media_type == 'scroll_video'
    assign show_scroll_video = true
  endif

  assign scroll_video_quality = block_settings.scroll_video_quality | default: '720p'
  assign scroll_video_engine = block_settings.scroll_video_engine | default: 'video'
  assign scroll_video_container = block_settings.scroll_video_container | default: 'mp4'
  assign scroll_video_asset = block_settings.scroll_video_asset | default: 'giclee-philosophy-frames'
  assign scroll_is_wrota = false
  if scroll_video_asset == 'giclee-philosophy-wrota'
    assign scroll_is_wrota = true
  endif
  assign scroll_frame_count = 210
  if scroll_is_wrota
    assign scroll_frame_count = 778
  endif
  if scroll_video_quality == '1080p'
    if scroll_is_wrota
      assign scroll_frame_first = 'giclee-philosophy-wrota-1080-frame-000.webp'
      assign scroll_frame_manifest = 'giclee-philosophy-wrota-1080-manifest.json'
      assign scroll_native_video = 'giclee-philosophy-wrota-scroll-1080.mp4'
      assign scroll_native_poster = 'giclee-philosophy-wrota-video-1080-poster.webp'
      assign scroll_native_manifest = 'giclee-philosophy-wrota-video-1080-manifest.json'
    else
      assign scroll_frame_first = 'giclee-philosophy-1080-frame-000.webp'
      assign scroll_frame_manifest = 'giclee-philosophy-1080-manifest.json'
      assign scroll_native_video = 'giclee-philosophy-scroll-1080.mp4'
      assign scroll_native_poster = 'giclee-philosophy-video-1080-poster.webp'
      assign scroll_native_manifest = 'giclee-philosophy-video-1080-manifest.json'
    endif
    assign scroll_frame_width = 1920
    assign scroll_frame_height = 1080
  else
    assign scroll_video_quality = '720p'
    if scroll_is_wrota
      assign scroll_frame_first = 'giclee-philosophy-wrota-720-frame-000.webp'
      assign scroll_frame_manifest = 'giclee-philosophy-wrota-720-manifest.json'
      assign scroll_native_video = 'giclee-philosophy-wrota-scroll-720.mp4'
      assign scroll_native_poster = 'giclee-philosophy-wrota-video-720-poster.webp'
      assign scroll_native_manifest = 'giclee-philosophy-wrota-video-720-manifest.json'
    else
      assign scroll_frame_first = 'giclee-philosophy-v3-frame-000.webp'
      assign scroll_frame_manifest = 'giclee-philosophy-v3-manifest.json'
      assign scroll_native_video = 'giclee-philosophy-scroll-720.mp4'
      assign scroll_native_poster = 'giclee-philosophy-video-720-poster.webp'
      assign scroll_native_manifest = 'giclee-philosophy-video-720-manifest.json'
    endif
    assign scroll_frame_width = 1280
    assign scroll_frame_height = 720
  endif
  assign scroll_native_mime = 'video/mp4'
  assign scroll_native_codec = 'h264'
  assign scroll_native_has_alpha = 'false'
  assign scroll_native_alpha_mode = 'none'
  if scroll_video_container == 'webm'
    assign scroll_native_mime = 'video/webm'
    assign scroll_native_codec = 'vp9'
    assign scroll_native_has_alpha = 'unknown'
    assign scroll_native_alpha_mode = 'unknown'
    if scroll_video_quality == '1080p'
      if scroll_is_wrota
        assign scroll_native_video = 'giclee-philosophy-wrota-scroll-1080.webm'
        assign scroll_native_poster = 'giclee-philosophy-wrota-webm-1080-poster.webp'
        assign scroll_native_manifest = 'giclee-philosophy-wrota-webm-1080-manifest.json'
      else
        assign scroll_native_video = 'giclee-philosophy-scroll-1080.webm'
        assign scroll_native_poster = 'giclee-philosophy-webm-1080-poster.webp'
        assign scroll_native_manifest = 'giclee-philosophy-webm-1080-manifest.json'
      endif
    else
      if scroll_is_wrota
        assign scroll_native_video = 'giclee-philosophy-wrota-scroll-720.webm'
        assign scroll_native_poster = 'giclee-philosophy-wrota-webm-720-poster.webp'
        assign scroll_native_manifest = 'giclee-philosophy-wrota-webm-720-manifest.json'
      else
        assign scroll_native_video = 'giclee-philosophy-scroll-720.webm'
        assign scroll_native_poster = 'giclee-philosophy-webm-720-poster.webp'
        assign scroll_native_manifest = 'giclee-philosophy-webm-720-manifest.json'
      endif
    endif
  else
    assign scroll_video_container = 'mp4'
  endif
  assign scroll_poster = scroll_frame_first
  if scroll_video_engine == 'video'
    assign scroll_poster = scroll_native_poster
  endif
%}

<div
  class="
    media-block
    spacing-style
    {% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}
    {% if show_scroll_video %} media-block--scroll-scrub{% endif %}
    {% if scroll_is_wrota %} media-block--portal-wrota{% endif %}
    {% if show_image and block_settings.image_position == 'contain' or show_video and block_settings.video_position == 'contain' or show_scroll_video and block_settings.video_position == 'contain' %}
      media-block--contain
    {% endif %}
  "
  {% if show_scroll_video %}
    data-scroll-motion-root
    data-scroll-video-asset="{{ scroll_video_asset | escape }}"
    data-scroll-video-container="{{ scroll_video_container }}"
    {% if scroll_is_wrota %}data-fm-portal-root{% endif %}
    data-motion-presets-url="{{ 'giclee-scroll-motion-presets.json' | asset_url }}"
    data-motion-preset="{{ block_settings.scroll_motion_preset | default: 'direct' }}"
    data-motion-speed="{{ block_settings.scroll_motion_speed | default: 1 }}"
    data-motion-easing="{{ block_settings.scroll_motion_easing | default: 'linear' }}"
    data-motion-bezier="{{ block_settings.scroll_motion_bezier | default: '0.25,0.10,0.25,1.00' | escape }}"
    data-motion-smoothing-ms="{{ block_settings.scroll_motion_smoothing_ms | default: 0 }}"
    data-motion-lag-ms="{{ block_settings.scroll_motion_lag_ms | default: 0 }}"
    data-motion-inertia="{{ block_settings.scroll_motion_inertia | default: 0 }}"
    data-motion-damping="{{ block_settings.scroll_motion_damping | default: 100 }}"
    data-motion-max-catchup="{{ block_settings.scroll_motion_max_catchup | default: 0 }}"
    data-motion-stop-behavior="{{ block_settings.scroll_motion_stop_behavior | default: 'immediate' }}"
    data-motion-snap-points="{{ block_settings.scroll_motion_snap_points | default: 5 }}"
    data-motion-direction="{{ block_settings.scroll_motion_direction | default: 'normal' }}"
    data-motion-material-start="{{ block_settings.scroll_motion_material_start | default: 0 }}"
    data-motion-material-end="{{ block_settings.scroll_motion_material_end | default: 100 }}"
    data-motion-interpolation="{{ block_settings.scroll_motion_interpolation | default: 'none' }}"
    data-motion-frame-rounding="{{ block_settings.scroll_motion_frame_rounding | default: 'round' }}"
    data-motion-mp4-dead-zone-ms="{{ block_settings.scroll_motion_mp4_dead_zone_ms | default: 4 }}"
    data-motion-webp-dead-zone-frames="{{ block_settings.scroll_motion_webp_dead_zone_frames | default: 1 }}"
    data-motion-preload-radius="{{ block_settings.scroll_motion_preload_radius | default: 12 }}"
    data-motion-cache-frames="{{ block_settings.scroll_motion_cache_frames | default: 0 }}"
    data-motion-tail-pacing="{{ block_settings.scroll_motion_tail_pacing | default: false }}"
    data-motion-tail-window-frames="{{ block_settings.scroll_motion_tail_window_frames | default: 12 }}"
    data-preserve-alpha="{{ block_settings.scroll_preserve_alpha | default: true, allow_false: true }}"
    {%- liquid
      assign scroll_bg_mode = block_settings.scroll_background_mode | default: 'auto'
      assign scroll_bg_value = block_settings.scroll_background_value | default: '#000000'
      unless scroll_is_wrota
        if scroll_bg_mode == 'asset'
          assign scroll_bg_value = 'giclee-philosophy-scroll-bg.webp' | asset_url
        elsif scroll_bg_mode == 'webm'
          assign scroll_bg_value = 'giclee-philosophy-scroll-bg.webm' | asset_url
        endif
      endunless
    -%}
    data-background-mode="{{ scroll_bg_mode }}"
    data-background-value="{{ scroll_bg_value | escape }}"
    data-alpha-diagnostics="{{ block_settings.scroll_alpha_diagnostics | default: false, allow_false: true }}"
    data-force-transparent="{{ block_settings.scroll_force_transparent | default: false, allow_false: true }}"
  {% endif %}
  style="
    {% render 'border-override', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --image-position: {{ block_settings.image_position }};
    --video-position: {{ block_settings.video_position }};
    --scroll-scrub-height: {{ block_settings.scroll_video_viewport | default: 400 }}vh;
  "
  {{ block.shopify_attributes }}
>
  {%- if show_image -%}
    {% capture image_tag %}
      {% if block_settings.image != blank %}
        {% render 'image',
          image: block_settings.image,
          class: 'media-block__media border-style',
          unset_image_tag: unset_image_tag
        %}
      {% else %}
        <div class="media-block__media border-style">
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'media-block__placeholder' }}
        </div>
      {% endif %}
    {% endcapture %}

    {% if block_settings.link != blank %}
      <a
        href="{{ block_settings.link }}"
        class="media-block__media-link"
      >
        {{ image_tag }}
      </a>
    {% else %}
      {{ image_tag }}
    {% endif %}
  {%- elsif show_video -%}
    {% render 'video',
      video: block_settings.video,
      video_autoplay: block_settings.video_autoplay,
      video_loop: block_settings.video_loop,
      video_class: 'media-block__media media-block__media--video border-style'
    %}
  {%- elsif show_scroll_video -%}
    {% if block_settings.scroll_video_asset != blank %}
      <link
        rel="preload"
        as="image"
        href="{{ scroll_poster | asset_url }}"
        fetchpriority="high"
      >
      <div class="media-block__scroll-stage{% if scroll_video_asset == 'giclee-philosophy-frames' %} media-block__scroll-stage--philosophy{% endif %}{% if scroll_is_wrota %} giclee-fm-wrota-portal{% endif %}"{% if scroll_is_wrota %} data-fm-portal style="--giclee-fm-portal-inset: 50%;"{% endif %}>
        <img
          class="media-block__scroll-poster"
          src="{{ scroll_poster | asset_url }}"
          width="{{ scroll_frame_width }}"
          height="{{ scroll_frame_height }}"
          alt=""
          decoding="async"
          fetchpriority="high"
          aria-hidden="true"
        >
        {% if scroll_video_engine == 'video' %}
          <video
            class="media-block__media media-block__media--scroll border-style"
            data-scroll-native-video
            data-frame-quality="{{ scroll_video_quality }}"
            data-frame-count="{{ scroll_frame_count }}"
            data-frame-fps="60"
            data-video-manifest="{{ scroll_native_manifest | asset_url }}"
            data-video-container="{{ scroll_video_container }}"
            data-source-has-alpha="{{ scroll_native_has_alpha }}"
            data-alpha-mode="{{ scroll_native_alpha_mode }}"
            data-source-codec="{{ scroll_native_codec }}"
            width="{{ scroll_frame_width }}"
            height="{{ scroll_frame_height }}"
            muted
            playsinline
            preload="none"
            poster="{{ scroll_poster | asset_url }}"
            aria-hidden="true"
            tabindex="-1"
          >
            <source
              src="{{ scroll_native_video | asset_url }}"
              type="{{ scroll_native_mime }}"
            >
          </video>
        {% else %}
          <canvas
            class="media-block__media media-block__media--scroll border-style"
            data-scroll-frame-canvas
            data-frame-quality="{{ scroll_video_quality }}"
            data-frame-count="{{ scroll_frame_count }}"
            data-frame-width="{{ scroll_frame_width }}"
            data-frame-height="{{ scroll_frame_height }}"
            data-frame-fps="60"
            data-frame-manifest="{{ scroll_frame_manifest | asset_url }}"
            data-source-has-alpha="true"
            data-alpha-mode="straight"
            data-source-codec="webp"
            width="{{ scroll_frame_width }}"
            height="{{ scroll_frame_height }}"
            aria-hidden="true"
            tabindex="-1"
          ></canvas>
        {% endif %}
        {% if scroll_video_asset == 'giclee-philosophy-frames' %}
          <div class="media-block__scroll-separators" aria-hidden="true">
            <span></span>
            <span></span>
          </div>
          <div class="media-block__scroll-separators media-block__scroll-separators--bottom" aria-hidden="true">
            <span></span>
            <span></span>
          </div>
          <div class="media-block__scroll-intro">
            <span class="media-block__scroll-intro-line" aria-hidden="true"></span>
            <h1 class="media-block__scroll-intro-title">
              {{ block_settings.scroll_intro_title | default: 'FILOZOFIA|MARKI' | escape | replace: '|', '<br>' }}
            </h1>
            <p class="media-block__scroll-intro-subtitle">
              {{
                block_settings.scroll_intro_subtitle
                | default: '<p>Giclée Art opiera się na idei, że dzieło sztuki nie kończy się na pliku cyfrowym.</p>'
                | strip_html
                | escape
              }}
            </p>
          </div>
          <div class="media-block__scroll-outro" aria-hidden="true">
            <span class="media-block__scroll-outro-line" aria-hidden="true"></span>
            <p class="media-block__scroll-outro-text">
              {{
                block_settings.scroll_outro_text
                | default: '<p>Kończy się dopiero wtedy, gdy otrzymuje swoją ostateczną formę — spójną, archiwalną i gotową do ekspozycji.</p>'
                | strip_html
                | escape
              }}
            </p>
          </div>
        {% endif %}
        {% if scroll_is_wrota %}
          {%- liquid
            assign tresc3d_text_1 = block_settings.tresc3d_text_1 | default: '<p>Pierwszym są obrazy malarskie — często stare, pożółkłe, zapomniane lub wymagające ponownego opracowania w formie reprodukcji.</p>'
            assign tresc3d_text_2 = block_settings.tresc3d_text_2 | default: '<p>W tym procesie traktuję je jak materię kulturową, którą można przywrócić do życia poprzez korekcję tonalną i kolorystyczną, precyzyjny druk Fine Art i świadomą oprawę</p>'
          -%}
          <div class="giclee-fm-tresc3d" data-fm-tresc3d aria-hidden="true">
            <div
              class="giclee-fm-tresc3d__pair"
              data-fm-tresc3d-pair="1"
              style="--fm-tresc3d-pair-opacity: 0;"
            >
              <p class="giclee-fm-tresc3d__text">
                {{ tresc3d_text_1 | strip_html | escape }}
              </p>
              <div class="giclee-fm-tresc3d__compare" data-fm-tresc3d-compare>
                <div class="giclee-fm-tresc3d__compare-frame">
                  <div class="giclee-fm-tresc3d__compare-media" data-orientation="horizontal">
                    <div class="giclee-fm-tresc3d__layer giclee-fm-tresc3d__layer--before">
                      {%- if block_settings.tresc3d_pair1_before != blank -%}
                        {{
                          block_settings.tresc3d_pair1_before
                          | image_url: width: 2400
                          | image_tag:
                            loading: 'lazy',
                            class: 'giclee-fm-tresc3d__image',
                            alt: 'Przed',
                            sizes: '(min-width: 990px) 42vw, 90vw'
                        }}
                      {%- endif -%}
                      <span class="giclee-fm-tresc3d__label">Przed</span>
                    </div>
                    <div class="giclee-fm-tresc3d__layer giclee-fm-tresc3d__layer--after">
                      {%- if block_settings.tresc3d_pair1_after != blank -%}
                        {{
                          block_settings.tresc3d_pair1_after
                          | image_url: width: 2400
                          | image_tag:
                            loading: 'lazy',
                            class: 'giclee-fm-tresc3d__image',
                            alt: 'Po',
                            sizes: '(min-width: 990px) 42vw, 90vw'
                        }}
                      {%- endif -%}
                      <span class="giclee-fm-tresc3d__label giclee-fm-tresc3d__label--after">Po</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div
              class="giclee-fm-tresc3d__pair"
              data-fm-tresc3d-pair="2"
              style="--fm-tresc3d-pair-opacity: 0;"
            >
              <p class="giclee-fm-tresc3d__text">
                {{ tresc3d_text_2 | strip_html | escape }}
              </p>
              <div class="giclee-fm-tresc3d__compare" data-fm-tresc3d-compare>
                <div class="giclee-fm-tresc3d__compare-frame">
                  <div class="giclee-fm-tresc3d__compare-media" data-orientation="horizontal">
                    <div class="giclee-fm-tresc3d__layer giclee-fm-tresc3d__layer--before">
                      {%- if block_settings.tresc3d_pair2_before != blank -%}
                        {{
                          block_settings.tresc3d_pair2_before
                          | image_url: width: 2400
                          | image_tag:
                            loading: 'lazy',
                            class: 'giclee-fm-tresc3d__image',
                            alt: 'Przed',
                            sizes: '(min-width: 990px) 42vw, 90vw'
                        }}
                      {%- endif -%}
                      <span class="giclee-fm-tresc3d__label">Przed</span>
                    </div>
                    <div class="giclee-fm-tresc3d__layer giclee-fm-tresc3d__layer--after">
                      {%- if block_settings.tresc3d_pair2_after != blank -%}
                        {{
                          block_settings.tresc3d_pair2_after
                          | image_url: width: 2400
                          | image_tag:
                            loading: 'lazy',
                            class: 'giclee-fm-tresc3d__image',
                            alt: 'Po',
                            sizes: '(min-width: 990px) 42vw, 90vw'
                        }}
                      {%- endif -%}
                      <span class="giclee-fm-tresc3d__label giclee-fm-tresc3d__label--after">Po</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
      <script
        src="{{ 'giclee-scroll-scrub-video.js' | asset_url }}"
        defer="defer"
      ></script>
    {% else %}
      <div class="media-block__media border-style">
        {{ 'hero-apparel-3' | placeholder_svg_tag: 'media-block__placeholder' }}
      </div>
    {% endif %}
  {%- else -%}
    <div class="media-block__media border-style">
      {{ 'hero-apparel-3' | placeholder_svg_tag }}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .media-block {
    overflow: hidden;
    position: relative;

    @media screen and (min-width: 750px) {
      min-height: var(--media-height);
    }
  }

  .media-block__media {
    height: var(--media-height-mobile, auto);
    object-fit: var(--image-position, 'cover');
    object-position: center center;
    width: 100%;

    @media screen and (min-width: 750px) {
      height: 100%;
      position: absolute;
    }
  }

  deferred-media[class].media-block__media
    :is(.deferred-media__poster-button img, .deferred-media__poster-button ~ video) {
    object-fit: var(--video-position, 'cover');
  }

  /* This is to support corner radius on video and align the video to the center of the block */
  .media-block__placeholder {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center center;
    overflow: hidden;
    position: relative;
  }

  .media-block__media--video {
    display: flex;
    align-items: center;
    justify-content: center;

    @media screen and (max-width: 749px) {
      --media-height-mobile: auto;
    }
  }

  .media-block--scroll-scrub {
    contain: layout paint style;
    background: transparent;
    height: var(--scroll-scrub-height, 400vh);
    min-height: var(--scroll-scrub-height, 400vh);
    overflow: visible;
    width: 100%;
  }

  .media-block__scroll-stage {
    --scroll-separator-band: 50px;
    background: var(--scroll-runtime-background, #000);
    height: calc(100svh - var(--header-group-height, 0px));
    min-height: calc(100vh - var(--header-group-height, 0px));
    overflow: hidden;
    pointer-events: none;
    position: sticky;
    top: var(--header-group-height, 0px);
    width: 100%;
  }

  .media-block__scroll-bg-video {
    display: block;
    height: 100%;
    inset: 0;
    object-fit: cover;
    object-position: center center;
    pointer-events: none;
    position: absolute;
    width: 100%;
    z-index: 0;
  }

  /*
    Dolne linie: czarny pas nad filmem (jak u góry), żeby między separatorami
    i w paddingu pod nimi było #000 — nie tło scrolla prześwitujące z alfą.
  */
  .media-block__scroll-stage--philosophy {
    background: var(--scroll-runtime-background, #000);
  }

  .media-block__media--scroll {
    display: block;
    image-rendering: auto;
    inset: var(--scroll-separator-band, 50px) 0 0;
    max-height: none;
    object-fit: var(--video-position, cover);
    object-position: center center;
    pointer-events: none;
    position: absolute;
    width: 100%;
    z-index: 1;
  }

  .media-block__scroll-poster {
    height: calc(100% - var(--scroll-separator-band, 50px));
    inset: var(--scroll-separator-band, 50px) 0 0;
    object-fit: var(--video-position, cover);
    object-position: center center;
    opacity: 1;
    pointer-events: none;
    position: absolute;
    transition: opacity 120ms linear;
    width: 100%;
    z-index: 0;
  }

  .media-block--scroll-scrub.is-scroll-frame-ready
    .media-block__scroll-poster {
    opacity: 0;
  }

  .media-block__scroll-separators {
    --scroll-separator-band-bottom: 83px;
    background: #000;
    inset: 0 0 auto;
    height: var(--scroll-separator-band, 50px);
    pointer-events: none;
    position: absolute;
    z-index: 3;
  }

  .media-block__scroll-separators--bottom {
    inset: auto 0 0;
    height: var(--scroll-separator-band-bottom, 83px);
  }

  .media-block__scroll-separators span {
    background: rgb(255 255 255 / 0.72);
    height: 1px;
    left: 0;
    position: absolute;
    right: 0;
  }

  .media-block__scroll-separators span:first-child {
    top: 0;
  }

  .media-block__scroll-separators span:last-child {
    top: 33px;
  }

  .media-block__scroll-intro {
    color: #fff;
    display: flex;
    flex-direction: column;
    left: clamp(2rem, 7vw, 9rem);
    max-width: min(48vw, 54rem);
    pointer-events: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    transition:
      opacity 520ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 520ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    width: 100%;
    z-index: 2;
  }

  .media-block--scroll-scrub.is-scroll-alpha-debug
    .media-block__scroll-stage {
    background-color: #fff;
    background-image:
      linear-gradient(45deg, #c8c8c8 25%, transparent 25%),
      linear-gradient(-45deg, #c8c8c8 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #c8c8c8 75%),
      linear-gradient(-45deg, transparent 75%, #c8c8c8 75%);
    background-position:
      0 0,
      0 8px,
      8px -8px,
      -8px 0;
    background-size: 16px 16px;
  }

  .media-block__scroll-intro::before {
    background: radial-gradient(
      ellipse at left,
      rgb(0 0 0 / 0.72) 0%,
      rgb(0 0 0 / 0.28) 46%,
      transparent 76%
    );
    content: '';
    inset: -12rem -18rem;
    pointer-events: none;
    position: absolute;
    z-index: -1;
  }

  .media-block__scroll-intro-line {
    background: linear-gradient(90deg, #a88949, rgb(201 168 76 / 0.2));
    height: 1px;
    margin-block-end: clamp(1.2rem, 2.2vw, 2.25rem);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition:
      opacity 700ms ease-out 120ms,
      transform 1000ms cubic-bezier(0.16, 1, 0.3, 1) 120ms;
    width: clamp(4rem, 7vw, 7.5rem);
  }

  .media-block__scroll-intro-title {
    color: #fff;
    font-family: 'Bodoni Moda', var(--font-heading--family), serif;
    font-size: clamp(4rem, 7.2vw, 8.75rem);
    font-style: normal;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.82;
    margin: 0;
    opacity: 0;
    text-wrap: balance;
    text-shadow: 0 0.16em 0.8em rgb(0 0 0 / 0.38);
    transform: translate3d(0, 2.2rem, 0);
    transition:
      opacity 900ms ease-out 240ms,
      transform 1200ms cubic-bezier(0.16, 1, 0.3, 1) 240ms;
  }

  .media-block__scroll-intro-subtitle {
    color: rgb(255 255 255 / 0.82);
    font-family: var(--font-body--family);
    font-size: clamp(1rem, 1.25vw, 1.4rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.5;
    margin: clamp(1.75rem, 3vw, 3rem) 0 0;
    max-width: 39ch;
    opacity: 0;
    text-wrap: balance;
    text-shadow: 0 0.12em 1em rgb(0 0 0 / 0.5);
    transform: translate3d(0, 1.5rem, 0);
    transition:
      opacity 850ms ease-out 680ms,
      transform 1100ms cubic-bezier(0.16, 1, 0.3, 1) 680ms;
  }

  .media-block--scroll-scrub.is-scroll-frame-ready .media-block__scroll-intro-line {
    opacity: 1;
    transform: scaleX(1);
  }

  .media-block--scroll-scrub.is-scroll-frame-ready .media-block__scroll-intro-title,
  .media-block--scroll-scrub.is-scroll-frame-ready .media-block__scroll-intro-subtitle {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .media-block--scroll-scrub.is-scroll-frame-intro-past .media-block__scroll-intro {
    filter: blur(4px);
    opacity: 0;
    transform: translate3d(-2rem, -54%, 0);
  }

  .media-block__scroll-outro {
    align-items: flex-end;
    color: #fff;
    display: flex;
    flex-direction: column;
    max-width: min(40vw, 42rem);
    opacity: 0;
    pointer-events: none;
    position: absolute;
    right: clamp(2rem, 7vw, 9rem);
    text-align: right;
    top: 50%;
    transform: translate3d(2.5rem, -50%, 0);
    transition:
      opacity 900ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 1100ms cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
    z-index: 2;
  }

  .media-block__scroll-outro::before {
    background: radial-gradient(
      ellipse at right,
      rgb(0 0 0 / 0.68) 0%,
      rgb(0 0 0 / 0.24) 48%,
      transparent 76%
    );
    content: '';
    inset: -12rem -18rem;
    pointer-events: none;
    position: absolute;
    z-index: -1;
  }

  .media-block__scroll-outro-line {
    background: linear-gradient(270deg, #a88949, rgb(201 168 76 / 0.2));
    height: 1px;
    margin-block-end: clamp(1.5rem, 2.5vw, 2.75rem);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: right;
    transition:
      opacity 650ms ease-out 100ms,
      transform 950ms cubic-bezier(0.16, 1, 0.3, 1) 100ms;
    width: clamp(4rem, 7vw, 7.5rem);
  }

  .media-block__scroll-outro-text {
    color: rgb(255 255 255 / 0.94);
    font-family: 'Bodoni Moda', var(--font-heading--family), serif;
    font-size: clamp(2rem, 3vw, 3.75rem);
    font-weight: 400;
    letter-spacing: -0.018em;
    line-height: 1.12;
    margin: 0;
    max-width: 21ch;
    opacity: 0;
    text-shadow: 0 0.16em 0.9em rgb(0 0 0 / 0.48);
    text-wrap: balance;
    transform: translate3d(0, 1.5rem, 0);
    transition:
      opacity 850ms ease-out 180ms,
      transform 1100ms cubic-bezier(0.16, 1, 0.3, 1) 180ms;
  }

  .media-block--scroll-scrub.is-scroll-frame-outro-visible .media-block__scroll-outro {
    opacity: 1;
    transform: translate3d(0, -50%, 0);
  }

  .media-block--scroll-scrub.is-scroll-frame-outro-visible .media-block__scroll-outro-line {
    opacity: 1;
    transform: scaleX(1);
  }

  .media-block--scroll-scrub.is-scroll-frame-outro-visible .media-block__scroll-outro-text {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  /* Full-viewport scrub stage: video edge-to-edge, intro overlaid */
  .media-with-content:has(.media-block--scroll-scrub) {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: 'stack';
    width: 100%;
  }

  .media-with-content:has(.media-block--scroll-scrub) .media-block--scroll-scrub {
    grid-area: stack;
    width: 100%;
  }

  .media-with-content:has(.media-block--scroll-scrub) .media-with-content__content {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .media-block__scroll-intro {
      left: 1.5rem;
      max-width: calc(100vw - 3rem);
      top: 44%;
    }

    .media-block__scroll-intro::before {
      inset: -10rem -6rem;
    }

    .media-block__scroll-intro-title {
      font-size: clamp(3.5rem, 17vw, 5.4rem);
    }

    .media-block__scroll-intro-subtitle {
      font-size: 1rem;
      max-width: 29ch;
    }

    .media-block__scroll-outro {
      max-width: calc(100vw - 3rem);
      right: 1.5rem;
      top: 52%;
    }

    .media-block__scroll-outro::before {
      inset: -10rem -6rem;
    }

    .media-block__scroll-outro-text {
      font-size: clamp(2rem, 8vw, 3.2rem);
      max-width: 18ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .media-block__scroll-intro,
    .media-block__scroll-intro-line,
    .media-block__scroll-intro-title,
    .media-block__scroll-intro-subtitle,
    .media-block__scroll-outro,
    .media-block__scroll-outro-line,
    .media-block__scroll-outro-text {
      transition: none;
    }
  }
{% endstylesheet %}
