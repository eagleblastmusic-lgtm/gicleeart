  <script>
    (function() {
      var handle = 'twoje-zdjecie-jako-wydruk-giclee-na-papierze-fine-art-w-drewnianej-ramie';
      var productPath = '/products/' + handle;
      function fixWlasnaFotografiaLinks() {
        document.querySelectorAll('a[href*="/pages/fotografia-obraz"]').forEach(function(a) {
          a.setAttribute('href', productPath);
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fixWlasnaFotografiaLinks);
      } else {
        fixWlasnaFotografiaLinks();
      }
    })();
  </script>
  {% render 'giclee-site-notice' %}
  {% if template.suffix == 'faq' %}
  <script>
    /* FAQ a11y + wycinki akordeonów (fade-in, prawy dół sekcji FAQ pod gradientem) */
    (function () {
      var CUTOUTS = [
        {
          index: 0,
          src: {{ 'faq-accordion-first-cutout.png' | asset_url | json }},
          className: 'faq-accordion-cutout faq-accordion-cutout--1'
        },
        {
          index: 1,
          src: {{ 'faq-accordion-second-cutout.png' | asset_url | json }},
          className: 'faq-accordion-cutout faq-accordion-cutout--2'
        },
        {
          index: 2,
          src: {{ 'faq-accordion-third-cutout.png' | asset_url | json }},
          className: 'faq-accordion-cutout faq-accordion-cutout--3'
        },
        {
          index: 3,
          src: {{ 'faq-accordion-fourth-cutout.png' | asset_url | json }},
          className: 'faq-accordion-cutout faq-accordion-cutout--4'
        },
        {
          index: 4,
          src: {{ 'faq-accordion-fifth-cutout.png' | asset_url | json }},
          className: 'faq-accordion-cutout faq-accordion-cutout--5'
        }
      ];

      function findFaqSection() {
        return document.querySelector('.faq-section');
      }

      function ensureAccordionCutout(config) {
        var selector = '.faq-accordion-cutout--' + (config.index + 1);
        var existing = document.querySelector(selector);
        if (existing) return existing;

        var faqSection = findFaqSection();
        if (!faqSection) return null;

        var img = document.createElement('img');
        img.className = config.className;
        img.src = config.src;
        img.alt = '';
        img.setAttribute('aria-hidden', 'true');
        img.decoding = 'async';
        img.loading = 'eager';
        faqSection.appendChild(img);
        return img;
      }

      function syncAccordionCutout(details, config) {
        var cutout = ensureAccordionCutout(config);
        if (!cutout) return;
        if (details.open) {
          cutout.classList.add('is-visible');
        } else {
          cutout.classList.remove('is-visible');
        }
      }

      function bindAccordionCutouts() {
        var items = document.querySelectorAll('.accordion accordion-custom');
        CUTOUTS.forEach(function (config) {
          var item = items[config.index];
          if (!item) return;
          var details = item.querySelector('details');
          if (!details) return;

          ensureAccordionCutout(config);
          syncAccordionCutout(details, config);
          details.addEventListener('toggle', function () {
            syncAccordionCutout(details, config);
          });
        });
      }

      function enhanceFaqA11y() {
        var items = document.querySelectorAll('.accordion accordion-custom');
        items.forEach(function (item, i) {
          var details = item.querySelector('details');
          if (!details) return;
          var summary = details.querySelector('summary');
          var content = details.querySelector('.details-content');
          if (!summary) return;

          if (content) {
            if (!content.id) content.id = 'faq-answer-' + (i + 1);
            summary.setAttribute('aria-controls', content.id);
          }
          summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');

          details.addEventListener('toggle', function () {
            summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');
          });
        });
        bindAccordionCutouts();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', enhanceFaqA11y);
      } else {
        enhanceFaqA11y();
      }
    })();
  </script>
  {% endif %}
