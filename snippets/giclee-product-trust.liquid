{%- comment -%}
  Sekcja zaufania PDP — szablon product.nowy-szblon-produktu.
  Pod separatorem pod galeria+warianty.
{%- endcomment -%}

<section class="giclee-trust" aria-labelledby="giclee-trust-heading">
  <h2 class="giclee-trust__heading" id="giclee-trust-heading">
    Na czym budujemy Twoje zaufanie
  </h2>

  <ul class="giclee-trust__grid list-unstyled">
    <li class="giclee-trust__item">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <img
            class="giclee-trust__logo giclee-trust__logo--epson"
            src="{{ 'logo-epson.png' | asset_url }}"
            alt="Epson"
            width="300"
            height="74"
            loading="lazy"
          >
        </span>
        <p class="giclee-trust__detail">Epson — papier Velvet Fine Art + tusze UltraChrome Pro 12</p>
      </div>
    </li>

    <li class="giclee-trust__item">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <img
            class="giclee-trust__logo giclee-trust__logo--hahnemuhle"
            src="{{ 'logo-hahnemuhle.png' | asset_url }}"
            alt="Hahnemühle"
            width="1024"
            height="294"
            loading="lazy"
          >
        </span>
        <p class="giclee-trust__detail">Hahnemühle Photo Rag 308 — papier muzealny, certyfikat 100+ lat</p>
      </div>
    </li>

    <li class="giclee-trust__item">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <img
            class="giclee-trust__logo giclee-trust__logo--rubio"
            src="{{ 'logo-rubio-monocoat.png' | asset_url }}"
            alt="Rubio Monocoat"
            width="1024"
            height="640"
            loading="lazy"
          >
        </span>
        <p class="giclee-trust__detail">Rubio Monocoat — olej do drewna, naturalne wykończenie</p>
      </div>
    </li>

    <li class="giclee-trust__item giclee-trust__item--icon">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <span class="giclee-trust__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 3h12v11H1z"/>
              <path d="M13 6h4l3 3v5h-7V6z"/>
              <circle cx="5.5" cy="17.5" r="2"/>
              <circle cx="17.5" cy="17.5" r="2"/>
            </svg>
          </span>
        </span>
        <p class="giclee-trust__detail">Darmowa wysyłka — bez dodatkowych opłat</p>
      </div>
    </li>

    <li class="giclee-trust__item giclee-trust__item--icon">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <span class="giclee-trust__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l7 3v6c0 4.5-3.5 7.5-7 9-3.5-1.5-7-4.5-7-9V6l7-3z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          </span>
        </span>
        <p class="giclee-trust__detail">14 dni na zwrot — satysfakcja gwarantowana</p>
      </div>
    </li>
  </ul>
</section>

{% style %}
  /* Brak sekcji przed/po nie może zostawiać pustego rzędu ani grid gapu.
     Między kotwicą i wrapperem pozostaje inline <script>, dlatego potrzebny
     jest selektor rodzeństwa ~, a nie selektor bezpośredni +. */
  main[data-template='product.szablon-produktu-v3']
    .product-information
    .giclee-before-after-target:empty {
    display: none;
  }

  main[data-template='product.szablon-produktu-v3']
    .product-information
    .giclee-before-after-target:empty
    ~ .pdp-v3-pt-wrap {
    margin-top: calc(-1 * var(--gap, 48px));
  }

  main[data-template='product.szablon-produktu-v3']
    .product-information
    .giclee-before-after-target:empty
    ~ .pdp-v3-pt-wrap.has-bg::before {
    clip-path: inset(0);
    transform: translateX(-50%) scaleX(1.03);
  }

  main[data-template='product.szablon-produktu-v3']
    .product-information
    .giclee-before-after-target:empty
    ~ .pdp-v3-pt-wrap.has-bg::after {
    top: 0;
    background: rgb(0 0 0 / 0.45);
  }

  /* Jedna pełnoekranowa kompozycja: proces ma spokojną górną strefę,
     a zaufanie uporządkowaną dolną strefę na tym samym tle. */
  main[data-template='product.szablon-produktu-v3']
    .product-information
    .pdp-v3-pt-wrap {
    display: grid;
    grid-column: 1 / -1;
    grid-template-rows: minmax(0, 56fr) minmax(0, 44fr);
    align-content: stretch;
    row-gap: 0;
    width: 100vw;
    min-width: 100vw;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    margin-left: calc(50% - 50vw);
    overflow: clip;
    box-sizing: border-box;
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    > .product-description-trailing-separator {
    display: none;
  }

  main[data-template='product.szablon-produktu-v3']
    .product-information
    .pdp-v3-pt-wrap
    > .giclee-process,
  main[data-template='product.szablon-produktu-v3']
    .product-information
    .pdp-v3-pt-wrap
    > .giclee-trust {
    position: relative;
    top: auto;
    z-index: auto;
    width: 100%;
    height: 100%;
    min-height: 0;
    margin: 0;
    background-color: transparent;
    isolation: auto;
    box-sizing: border-box;
  }

  @media screen and (min-width: 990px) {
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      > .giclee-process {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(1.1rem, 2.6vh, 2.15rem) clamp(2rem, 5vw, 6rem)
        clamp(0.8rem, 1.8vh, 1.45rem);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      > .giclee-trust {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding: clamp(0.45rem, 1.1vh, 0.9rem) clamp(2rem, 5vw, 6rem)
        clamp(1.25rem, 2.8vh, 2.25rem);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-process__eyebrow {
      margin: 0 0 clamp(0.2rem, 0.45vh, 0.4rem);
      font-size: clamp(0.68rem, 0.75vw, 0.78rem);
      letter-spacing: 0.24em;
      color: rgb(var(--color-foreground-rgb, 255, 255, 255) / 0.62);
      text-shadow: 0 1px 1rem rgb(0 0 0 / 0.45);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-process__heading,
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-trust__heading {
      margin-top: 0;
      line-height: 1.08;
      text-shadow: 0 2px 1.25rem rgb(0 0 0 / 0.5);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-process__heading {
      margin-bottom: clamp(0.85rem, 1.9vh, 1.5rem);
      font-size: clamp(1.5rem, 2vw, 1.95rem);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-trust__heading {
      margin-bottom: clamp(0.75rem, 1.55vh, 1.25rem);
      font-size: clamp(1.4rem, 1.8vw, 1.75rem);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-process__grid,
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-trust__grid {
      width: min(100%, 96rem);
      margin-inline: auto;
      align-items: start;
      column-gap: clamp(1rem, 2.4vw, 2.75rem);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-process__step-body,
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-trust__item-body {
      gap: clamp(0.22rem, 0.48vh, 0.4rem);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-process__icon {
      width: clamp(1.65rem, 2.1vw, 2rem);
      height: clamp(1.65rem, 2.1vw, 2rem);
      margin-bottom: 0.05rem;
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-process__num {
      font-size: clamp(0.66rem, 0.72vw, 0.76rem);
      letter-spacing: 0.11em;
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-process__title {
      font-size: clamp(0.92rem, 1.2vw, 1.1rem);
      line-height: 1.18;
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-process__text {
      margin-top: 0.08rem;
      max-width: 23ch;
      font-size: clamp(0.76rem, 0.92vw, 0.9rem);
      line-height: 1.38;
      color: rgb(var(--color-foreground-rgb, 255, 255, 255) / 0.7);
      text-shadow: 0 1px 0.8rem rgb(0 0 0 / 0.55);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-trust__logo-slot {
      height: clamp(2.65rem, 4.5vh, 3.65rem);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-trust__logo--epson {
      width: min(100%, 10rem);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-trust__logo--hahnemuhle {
      width: min(100%, 10.5rem);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-trust__logo--rubio {
      width: min(100%, 7.6rem);
      max-height: clamp(2.75rem, 4.25vh, 3.5rem);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-trust__icon {
      width: clamp(2.25rem, 3.4vh, 2.85rem);
      height: clamp(2.25rem, 3.4vh, 2.85rem);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-trust__detail {
      max-width: 21ch;
      font-size: clamp(0.76rem, 0.9vw, 0.88rem);
      line-height: 1.34;
      color: rgb(var(--color-foreground-rgb, 255, 255, 255) / 0.74);
      text-shadow: 0 1px 0.8rem rgb(0 0 0 / 0.55);
    }
  }

  @media screen and (min-width: 990px) and (max-height: 760px) {
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap {
      grid-template-rows: minmax(0, 57fr) minmax(0, 43fr);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      > .giclee-process {
      padding-top: clamp(0.65rem, 1.5vh, 1rem);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-process__text,
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-trust__detail {
      font-size: clamp(0.72rem, 1.2vh, 0.82rem);
      line-height: 1.28;
    }
  }

  @media screen and (max-width: 989px) {
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap {
      display: block;
      height: auto;
      min-height: 100vh;
      min-height: 100dvh;
      overflow: visible;
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      > .giclee-process,
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      > .giclee-trust {
      height: auto;
      padding-inline: clamp(1.25rem, 5vw, 2rem);
    }
  }
{% endstyle %}
