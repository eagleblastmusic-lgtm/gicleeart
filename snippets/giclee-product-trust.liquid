{%- comment -%}
  Sekcja zaufania PDP — szablon product.nowy-szblon-produktu.
  Pod separatorem pod galeria+warianty.
{%- endcomment -%}

<section class="giclee-trust" aria-labelledby="giclee-trust-heading">
  <h2 class="giclee-trust__heading" id="giclee-trust-heading">
    Na czym budujemy Twoje zaufanie
  </h2>

  <ul class="giclee-trust__grid list-unstyled">
    <li class="giclee-trust__item">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <img
            class="giclee-trust__logo giclee-trust__logo--epson"
            src="{{ 'logo-epson.png' | asset_url }}"
            alt="Epson"
            width="300"
            height="74"
            loading="lazy"
          >
        </span>
        <p class="giclee-trust__detail">Epson — papier Velvet Fine Art + tusze UltraChrome Pro 12</p>
      </div>
    </li>

    <li class="giclee-trust__item">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <img
            class="giclee-trust__logo giclee-trust__logo--hahnemuhle"
            src="{{ 'logo-hahnemuhle.png' | asset_url }}"
            alt="Hahnemühle"
            width="1024"
            height="294"
            loading="lazy"
          >
        </span>
        <p class="giclee-trust__detail">Hahnemühle Photo Rag 308 — papier muzealny, certyfikat 100+ lat</p>
      </div>
    </li>

    <li class="giclee-trust__item">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <img
            class="giclee-trust__logo giclee-trust__logo--rubio"
            src="{{ 'logo-rubio-monocoat.png' | asset_url }}"
            alt="Rubio Monocoat"
            width="1024"
            height="640"
            loading="lazy"
          >
        </span>
        <p class="giclee-trust__detail">Rubio Monocoat — olej do drewna, naturalne wykończenie</p>
      </div>
    </li>

    <li class="giclee-trust__item giclee-trust__item--icon">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <span class="giclee-trust__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 3h12v11H1z"/>
              <path d="M13 6h4l3 3v5h-7V6z"/>
              <circle cx="5.5" cy="17.5" r="2"/>
              <circle cx="17.5" cy="17.5" r="2"/>
            </svg>
          </span>
        </span>
        <p class="giclee-trust__detail">Darmowa wysyłka — bez dodatkowych opłat</p>
      </div>
    </li>

    <li class="giclee-trust__item giclee-trust__item--icon">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <span class="giclee-trust__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l7 3v6c0 4.5-3.5 7.5-7 9-3.5-1.5-7-4.5-7-9V6l7-3z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          </span>
        </span>
        <p class="giclee-trust__detail">14 dni na zwrot — satysfakcja gwarantowana</p>
      </div>
    </li>
  </ul>
</section>

{% style %}
  /* PDP v3 bez sekcji przed/po: pusta kotwica wraz z grid gapem tworzyła
     pełnoszerokie pasy między konfiguratorem a końcową sceną. */
  main[data-template='product.szablon-produktu-v3']
    .product-information
    .giclee-before-after-target:empty {
    display: none;
  }

  main[data-template='product.szablon-produktu-v3']
    .product-information
    .giclee-before-after-target:empty
    + .pdp-v3-pt-wrap {
    margin-top: calc(-1 * var(--gap, 48px));
  }

  main[data-template='product.szablon-produktu-v3']
    .product-information
    .giclee-before-after-target:empty
    + .pdp-v3-pt-wrap.has-bg::before {
    clip-path: inset(0);
    transform: translateX(-50%) scaleX(1.03);
  }

  main[data-template='product.szablon-produktu-v3']
    .product-information
    .giclee-before-after-target:empty
    + .pdp-v3-pt-wrap.has-bg::after {
    top: 0;
    background: rgb(0 0 0 / 0.45);
  }

  /* Jedna końcowa scena: wrapper zapewnia dystans scrolla, a stage pozostaje
     przypięty przez jeden viewport. Proces i trust zajmują dokładnie tę samą
     powierzchnię i korzystają wyłącznie z jednego tła wrappera. */
  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap[data-pdp-v3-pt-scene] {
    min-height: 200vh;
    min-height: 200dvh;
    --pdp-v3-process-opacity: 1;
    --pdp-v3-process-y: 0px;
    --pdp-v3-trust-opacity: 0;
    --pdp-v3-trust-y: 18px;
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-stage {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: clip;
    isolation: isolate;
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-stage
    > .giclee-process,
  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-stage
    > .giclee-trust {
    position: relative;
    top: auto;
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    min-height: 100%;
    margin: 0;
    pointer-events: none;
    will-change: opacity, transform;
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-stage
    > .giclee-process {
    z-index: 1;
    opacity: var(--pdp-v3-process-opacity);
    transform: translate3d(0, var(--pdp-v3-process-y), 0);
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-stage
    > .giclee-trust {
    z-index: 2;
    opacity: var(--pdp-v3-trust-opacity);
    transform: translate3d(0, var(--pdp-v3-trust-y), 0);
  }

  /* Nie wolno odtwarzać obrazu osobno na panelu trust. Tło i przyciemnienie
     istnieją tylko na ::before/::after wspólnego .pdp-v3-pt-wrap. */
  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap.has-bg
    .pdp-v3-pt-stage
    > .giclee-process,
  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap.has-bg
    .pdp-v3-pt-stage
    > .giclee-trust {
    background-color: transparent;
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap.has-bg
    .pdp-v3-pt-stage
    > .giclee-process::before,
  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap.has-bg
    .pdp-v3-pt-stage
    > .giclee-trust::before {
    background: transparent;
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-stage
      > .giclee-process,
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-stage
      > .giclee-trust {
      transform: none;
      will-change: auto;
    }
  }
{% endstyle %}