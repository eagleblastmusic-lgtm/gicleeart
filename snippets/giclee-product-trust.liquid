{%- comment -%}
  Sekcja zaufania PDP — szablon product.nowy-szblon-produktu.
  Pod separatorem pod galeria+warianty.
{%- endcomment -%}

<section class="giclee-trust" aria-labelledby="giclee-trust-heading">
  <h2 class="giclee-trust__heading" id="giclee-trust-heading">
    Na czym budujemy Twoje zaufanie
  </h2>

  <ul class="giclee-trust__grid list-unstyled">
    <li class="giclee-trust__item">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <img
            class="giclee-trust__logo giclee-trust__logo--epson"
            src="{{ 'logo-epson.png' | asset_url }}"
            alt="Epson"
            width="300"
            height="74"
            loading="lazy"
          >
        </span>
        <p class="giclee-trust__detail">Epson — papier Velvet Fine Art + tusze UltraChrome Pro 12</p>
      </div>
    </li>

    <li class="giclee-trust__item">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <img
            class="giclee-trust__logo giclee-trust__logo--hahnemuhle"
            src="{{ 'logo-hahnemuhle.png' | asset_url }}"
            alt="Hahnemühle"
            width="1024"
            height="294"
            loading="lazy"
          >
        </span>
        <p class="giclee-trust__detail">Hahnemühle Photo Rag 308 — papier muzealny, certyfikat 100+ lat</p>
      </div>
    </li>

    <li class="giclee-trust__item">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <img
            class="giclee-trust__logo giclee-trust__logo--rubio"
            src="{{ 'logo-rubio-monocoat.png' | asset_url }}"
            alt="Rubio Monocoat"
            width="1024"
            height="640"
            loading="lazy"
          >
        </span>
        <p class="giclee-trust__detail">Rubio Monocoat — olej do drewna, naturalne wykończenie</p>
      </div>
    </li>

    <li class="giclee-trust__item giclee-trust__item--icon">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <span class="giclee-trust__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 3h12v11H1z"/>
              <path d="M13 6h4l3 3v5h-7V6z"/>
              <circle cx="5.5" cy="17.5" r="2"/>
              <circle cx="17.5" cy="17.5" r="2"/>
            </svg>
          </span>
        </span>
        <p class="giclee-trust__detail">Darmowa wysyłka — bez dodatkowych opłat</p>
      </div>
    </li>

    <li class="giclee-trust__item giclee-trust__item--icon">
      <div class="giclee-trust__item-body">
        <span class="giclee-trust__logo-slot">
          <span class="giclee-trust__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l7 3v6c0 4.5-3.5 7.5-7 9-3.5-1.5-7-4.5-7-9V6l7-3z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          </span>
        </span>
        <p class="giclee-trust__detail">14 dni na zwrot — satysfakcja gwarantowana</p>
      </div>
    </li>
  </ul>
</section>

{% style %}
  /* PDP v3 bez sekcji przed/po: pusta kotwica wraz z grid gapem tworzyła
     pełnoszerokie pasy między konfiguratorem a końcową sekcją. */
  main[data-template='product.szablon-produktu-v3']
    .product-information
    .giclee-before-after-target:empty {
    display: none;
  }

  main[data-template='product.szablon-produktu-v3']
    .product-information
    .giclee-before-after-target:empty
    + .pdp-v3-pt-wrap {
    margin-top: calc(-1 * var(--gap, 48px));
  }

  main[data-template='product.szablon-produktu-v3']
    .product-information
    .giclee-before-after-target:empty
    + .pdp-v3-pt-wrap.has-bg::before {
    clip-path: inset(0);
    transform: translateX(-50%) scaleX(1.03);
  }

  main[data-template='product.szablon-produktu-v3']
    .product-information
    .giclee-before-after-target:empty
    + .pdp-v3-pt-wrap.has-bg::after {
    top: 0;
    background: rgb(0 0 0 / 0.45);
  }

  /* Jedna statyczna końcowa sekcja 100vh na jednym tle. Proces zajmuje górną
     część, a zaufanie dolną; oba bloki są widoczne razem bez przełączania. */
  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap {
    display: grid;
    grid-template-rows: minmax(0, 58fr) minmax(0, 42fr);
    width: 100%;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: clip;
    box-sizing: border-box;
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    > .product-description-trailing-separator {
    display: none;
  }

  main[data-template='product.szablon-produktu-v3']
    .product-information
    .pdp-v3-pt-wrap
    > .giclee-process,
  main[data-template='product.szablon-produktu-v3']
    .product-information
    .pdp-v3-pt-wrap
    > .giclee-trust {
    position: relative;
    top: auto;
    z-index: auto;
    width: 100%;
    height: 100%;
    min-height: 0;
    margin: 0;
    background-color: transparent;
    isolation: auto;
    box-sizing: border-box;
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    > .giclee-process {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(0.65rem, 1.5vh, 1.25rem) 0 clamp(0.45rem, 1vh, 0.85rem);
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    > .giclee-trust {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(0.35rem, 0.8vh, 0.7rem) 0 clamp(0.65rem, 1.5vh, 1.15rem);
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    .giclee-process__eyebrow {
    margin-bottom: clamp(0.2rem, 0.5vh, 0.45rem);
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    .giclee-process__heading {
    margin-bottom: clamp(0.75rem, 1.8vh, 1.35rem);
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    .giclee-trust__heading {
    margin-bottom: clamp(0.55rem, 1.35vh, 1rem);
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    .giclee-process__grid,
  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    .giclee-trust__grid {
    gap: clamp(0.75rem, 1.6vw, 1.35rem);
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    .giclee-process__step-body,
  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    .giclee-trust__item-body {
    gap: clamp(0.2rem, 0.55vh, 0.45rem);
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    .giclee-trust__logo-slot {
    height: clamp(2.6rem, 4.8vh, 4rem);
  }

  main[data-template='product.szablon-produktu-v3']
    .pdp-v3-pt-wrap
    .giclee-trust__icon {
    width: clamp(2.25rem, 3.9vh, 3.25rem);
    height: clamp(2.25rem, 3.9vh, 3.25rem);
  }

  @media screen and (min-width: 990px) and (max-height: 760px) {
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap {
      grid-template-rows: minmax(0, 60fr) minmax(0, 40fr);
    }

    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-process__text,
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap
      .giclee-trust__detail {
      font-size: clamp(0.78rem, 1.4vh, 0.9rem);
      line-height: 1.32;
    }
  }

  @media screen and (max-width: 989px) {
    main[data-template='product.szablon-produktu-v3']
      .pdp-v3-pt-wrap {
      display: block;
      height: auto;
      min-height: 100vh;
      min-height: 100dvh;
      overflow: visible;
    }

    main[data-template='product.szablon-produktu-v3']
      .product-information
      .pdp-v3-pt-wrap
      > .giclee-process,
    main[data-template='product.szablon-produktu-v3']
      .product-information
      .pdp-v3-pt-wrap
      > .giclee-trust {
      height: auto;
      min-height: auto;
    }
  }
{% endstyle %}
