{%- doc -%}
  Renders a wrapper section

  @param {section} section - The section object
  @param {string} children - The children of the section
{%- enddoc -%}

{%- liquid
  assign giclee_faq_bg_mode = section.settings.giclee_faq_bg_mode | default: 'none'
  assign giclee_faq_bg_gradient = section.settings.giclee_faq_bg_gradient | default: 'v1'
  if giclee_faq_bg_gradient != 'v2'
    assign giclee_faq_bg_gradient = 'v1'
  endif
  assign giclee_faq_gradient_active = false
  if giclee_faq_bg_mode == 'gradient'
    assign giclee_faq_gradient_active = true
  endif
  assign giclee_faq_image_active = false
  if giclee_faq_bg_mode == 'image' and section.settings.background_media != 'none'
    assign giclee_faq_image_active = true
  endif
  assign giclee_faq_custom_bg = false
  if giclee_faq_gradient_active or giclee_faq_image_active
    assign giclee_faq_custom_bg = true
  endif
  assign giclee_faq_accordion_style = ''
  assign giclee_faq_bg_blur = 0
  assign giclee_faq_bg_saturate = 100
  assign giclee_faq_bg_brightness = 100
  assign giclee_faq_bg_dim_overlay = 0
  assign giclee_faq_bg_scale = 0
  assign giclee_faq_art_gradient_reach = 100
  if template.suffix == 'faq'
    assign giclee_faq_accordion_style = section.settings.giclee_faq_accordion_style | default: 'style1'
    unless giclee_faq_accordion_style == 'style2' or giclee_faq_accordion_style == 'style3'
      assign giclee_faq_accordion_style = 'style1'
    endunless
    assign giclee_faq_bg_blur = section.settings.giclee_faq_bg_blur_px | default: 0 | plus: 0
    assign giclee_faq_bg_saturate = section.settings.giclee_faq_bg_saturate_pct | default: 100 | plus: 0
    assign giclee_faq_bg_brightness = section.settings.giclee_faq_bg_brightness_pct | default: 100 | plus: 0
    assign giclee_faq_bg_dim_overlay = section.settings.giclee_faq_bg_dim_overlay_pct | default: 0 | plus: 0
    assign giclee_faq_bg_scale = section.settings.giclee_faq_bg_scale_pct | default: 0 | plus: 0
    assign giclee_faq_art_gradient_reach = section.settings.giclee_faq_art_gradient_reach_pct | default: 100 | plus: 0
    if giclee_faq_bg_blur < 0
      assign giclee_faq_bg_blur = 0
    elsif giclee_faq_bg_blur > 20
      assign giclee_faq_bg_blur = 20
    endif
    if giclee_faq_bg_saturate < 0
      assign giclee_faq_bg_saturate = 0
    elsif giclee_faq_bg_saturate > 100
      assign giclee_faq_bg_saturate = 100
    endif
    if giclee_faq_bg_brightness < 0
      assign giclee_faq_bg_brightness = 0
    elsif giclee_faq_bg_brightness > 100
      assign giclee_faq_bg_brightness = 100
    endif
    if giclee_faq_bg_dim_overlay < 0
      assign giclee_faq_bg_dim_overlay = 0
    elsif giclee_faq_bg_dim_overlay > 100
      assign giclee_faq_bg_dim_overlay = 100
    endif
    if giclee_faq_bg_scale < 0
      assign giclee_faq_bg_scale = 0
    elsif giclee_faq_bg_scale > 12
      assign giclee_faq_bg_scale = 12
    endif
    if giclee_faq_art_gradient_reach < 0
      assign giclee_faq_art_gradient_reach = 0
    elsif giclee_faq_art_gradient_reach > 200
      assign giclee_faq_art_gradient_reach = 200
    endif
  endif
-%}
<div class="section-background color-{{ section.settings.color_scheme }}{% if giclee_faq_custom_bg %} section-background--faq-custom{% endif %}{% if giclee_faq_gradient_active %} section-background--faq-gradient{% endif %}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    {% if giclee_faq_custom_bg %}faq-section{% endif %}
    {% if giclee_faq_image_active %}faq-section--bg-image{% endif %}
    {% if giclee_faq_gradient_active %}faq-section--gradient-{{ giclee_faq_bg_gradient }}{% endif %}
    {% if giclee_faq_accordion_style != blank %}faq-accordion-{{ giclee_faq_accordion_style }}{% endif %}
  "
  data-testid="ui-test-section"

  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}

  style="
    {% if section.settings.section_height == 'custom' %}
      --section-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == 'full-screen' %}
      --section-min-height: 100svh;
    {% elsif section.settings.section_height != '' %}
      --section-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}

    {% if section.settings.section_height != '' %}
     --section-preview-height: 600px;
     {% endif %}
    {% if giclee_faq_custom_bg %}
      --faq-bg-blur: {{ giclee_faq_bg_blur }};
      --faq-bg-saturate: {{ giclee_faq_bg_saturate }};
      --faq-bg-brightness: {{ giclee_faq_bg_brightness }};
      --faq-bg-dim-overlay: {{ giclee_faq_bg_dim_overlay }};
      --faq-bg-scale: {{ giclee_faq_bg_scale }};
    {% endif %}
    {% if giclee_faq_accordion_style != blank %}
      --faq-art-gradient-reach: {{ giclee_faq_art_gradient_reach }};
    {% endif %}
  "
>
  <div class="custom-section-background">
    {%- unless giclee_faq_gradient_active -%}
      {% render 'background-media',
        background_media: section.settings.background_media,
        background_video: section.settings.video,
        background_video_position: section.settings.video_position,
        background_image: section.settings.background_image,
        background_image_position: section.settings.background_image_position,
        background_image_object_y: section.settings.background_image_object_y
      %}
      {%- if section.settings.background_media != 'none' and section.settings.background_overlay_pct > 0 -%}
        <div
          class="giclee-section-bg-overlay"
          style="opacity: {{ section.settings.background_overlay_pct | times: 0.01 }};"
          aria-hidden="true"
        ></div>
      {%- endif -%}
    {%- endunless -%}
  </div>

  {%- if giclee_faq_custom_bg -%}
    <div class="faq-artwork-decoration faq-artwork-decoration--left" aria-hidden="true">
      <svg viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="faq-warm-stroke" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#6b3d17" stop-opacity="0" />
            <stop offset="35%" stop-color="#a96027" stop-opacity="0.36" />
            <stop offset="62%" stop-color="#efb46d" stop-opacity="0.88" />
            <stop offset="100%" stop-color="#6b3d17" stop-opacity="0" />
          </linearGradient>
          <radialGradient id="faq-warm-fog">
            <stop offset="0%" stop-color="#c87a34" stop-opacity="0.16" />
            <stop offset="55%" stop-color="#744018" stop-opacity="0.05" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0" />
          </radialGradient>
          <filter id="faq-warm-glow" x="-100%" y="-100%" width="300%" height="300%">
            <feGaussianBlur stdDeviation="7" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          <filter id="faq-warm-blur">
            <feGaussianBlur stdDeviation="45" />
          </filter>
        </defs>
        <ellipse cx="-35" cy="450" rx="420" ry="355" fill="url(#faq-warm-fog)" filter="url(#faq-warm-blur)" />
        <ellipse cx="-35" cy="450" rx="405" ry="350" fill="none" stroke="url(#faq-warm-stroke)" stroke-width="2" filter="url(#faq-warm-glow)" />
        <ellipse cx="-40" cy="450" rx="320" ry="278" fill="none" stroke="url(#faq-warm-stroke)" stroke-width="1.4" opacity="0.7" />
        <ellipse cx="-48" cy="450" rx="262" ry="228" fill="none" stroke="#e0a05f" stroke-width="1" opacity="0.18" />
      </svg>
    </div>

    <div class="faq-disc faq-disc--right" aria-hidden="true">
      <div class="faq-disc__surface"></div>
      <div class="faq-disc__ring faq-disc__ring--outer"></div>
      <div class="faq-disc__ring faq-disc__ring--middle"></div>
      <div class="faq-disc__ring faq-disc__ring--inner"></div>
      <div class="faq-disc__flare"></div>
    </div>
  {%- endif -%}

  <div
    class="border-style custom-section-content"
    style="{% render 'border-override', settings: section.settings %}"
  >
    {% if section.settings.toggle_overlay %}
      {% render 'overlay', settings: section.settings, layer: '0' %}
    {% endif %}

    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--{{ section.settings.content_direction }}
        section-content-wrapper
        {% if section.settings.vertical_on_mobile %} mobile-column{% endif %}
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
      data-testid="section-content"
    >
      {{ children }}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-wrapper {
    --section-height-offset: 0px;
  }

  .section[data-shopify-visual-preview] {
    min-height: var(--section-preview-height);
    padding-top: 0;
  }

  .section[data-shopify-visual-preview] .custom-section-background {
    display: none;
  }

  body:has(> #header-group > .header-section > #header-component[transparent]):not(
      :has(> #header-group > .header-section + .shopify-section)
    )
    > main
    > .section-wrapper:first-child {
    --section-height-offset: var(--header-group-height, 0);
  }

  .custom-section-background {
    grid-column: 1 / -1;
    position: relative;
  }

  .custom-section-content {
    z-index: var(--layer-flat);
  }
{% endstylesheet %}
