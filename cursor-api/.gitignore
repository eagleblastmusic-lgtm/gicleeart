# Python bytecode / test cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Environment Configuration
.env
.env.*

# OAuth offline session (access token)
.shopify_session.json

# Dependency directory
node_modules

# Test coverage directory
coverage

# Ignore Apple macOS Desktop Services Store
.DS_Store

# Logs
logs
*.log

# extensions build output
extensions/*/build
extensions/*/dist

# lock files




# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# nazwijobraz - trwaly cache wynikow API (TTL 30 dni)
.cache/

# blog - runtime data (topics.json trzymamy lokalnie, articles_cache + preview.html to artefakty)
Komponenty/blog/data/articles_cache.json
Komponenty/blog/data/preview.html

# zadania - signals_cache to snapshot Shopify (moze byc duzy, nie trzymamy w repo)
Komponenty/zadania/data/signals_cache.json

# stronyzobrazami - cache CSV/JSON z NGA, Walters, Wikidata (pobierany lokalnie, duzy)
Komponenty/stronyzobrazami/data/cache/

# PyInstaller (python -m PyInstaller giclee_app.spec)
/build/
/dist/

# Auto-backup zipow - nie chcemy ich w repo (sa duze i regenerowalne)
/backups/

# Logi komponentow (stdout/stderr przekierowany przez launcher)
/logs/
giclee_app/logs/studio_state.json
giclee_app/logs/*.log

# FX cache (regeneruje sie z NBP)
Komponenty/_shared/data/fx_cache.json

# Stan synchronizacji zamowien z Shopify
Komponenty/produkcja/dane/sync_state.json

# Lokalna baza zamowien (adresy klientow — nie w repo)
Komponenty/produkcja/dane/zamowienia.json
Komponenty/produkcja/dane/notified.json

# notatnik - notatki osobiste (nie techniczne)
Komponenty/notatnik/notatki/

# socialmedia/cykl - lokalne dane runtime (tokeny Meta API - SEKRET)
Komponenty/socialmedia/data/cykl/meta_credentials.json
# log publikacji (duzy)
Komponenty/socialmedia/data/cykl/meta_state.json
# zdjecia lokalne - duze pliki
Komponenty/socialmedia/data/cykl/Obrazy/

# integracjagpt — lokalny clone lustra repo GPT (nie commituj)
.gpt_mirror/

# integracjagpt — ZIP wiedzy Custom GPT (lokalnie, nie w repo)
Komponenty/integracjagpt/data/gpt_knowledge.zip

# integracjagpt — lokalne nagrania wideo (duże pliki, poza lustrem GPT)
Komponenty/integracjagpt/data/nagrania/

# bazapromptow — załączniki kontekstu promptów (pliki użytkownika)
Komponenty/bazapromptow/data/context_images/
Komponenty/bazapromptow/data/context_files/
Komponenty/bazapromptow/data/context_videos/

# segregatorplikow — lokalne ścieżki folderów użytkownika (szablon: data/tiles.example.json)
Komponenty/segregatorplikow/data/tiles.json

# Analiza ruchu — lokalna baza eventów
Komponenty/analytics/dane/analytics.db
# queue.json + generation_state.json + config.json - commitujemy (to plan cyklu)

# GicleeApp runtime / generated data
Komponenty/_shared/data/activity_log.jsonl
Komponenty/dokumentysprzedazy/documents/
Komponenty/kpir/documents/
Komponenty/print_optimize/data/
Komponenty/stronaglowna/data/tmp/

# Local test/build scratch (repo root)
/_tmp_*
/_test_*
/_test_out/
/_test_squoosh.jpg
/_build_czesc7.py
/_czesc7_parts/
/czesc5*.json
/czesc6*.json
/czesc7*.json
/tmp_getty*.txt
/tmp_getty*.json
/tmp_getty_row.json

# Performance Agent — generated audit bundles (PA-1A+)
reports/performance/

