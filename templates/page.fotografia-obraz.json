    "custom_liquid_GWUxgw": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Mockup Liquid",
      "settings": {
        "custom_liquid": "<div id=\"pm-hero\">\n\n  <div class=\"pm-stage\">\n    <div id=\"pm-wrapper\">\n      <canvas id=\"pm-canvas\"></canvas>\n      <img id=\"pm-frame\" alt=\"\">\n      <div class=\"pm-glow\"></div>\n      <div class=\"pm-vignette\"></div>\n      <div class=\"pm-grain\"></div>\n      <div class=\"pm-sheen\"></div>\n    </div>\n  </div>\n\n  <div class=\"pm-overlay\">\n    <div class=\"pm-badge\">Fine Art Preview</div>\n    <h1>Stwórz swój wydruk</h1>\n    <p>Prześlij zdjęcie i zobacz elegancki podgląd w ramie</p>\n\n    <label class=\"pm-upload-btn\">\n      <span>Wybierz zdjęcie</span>\n      <input type=\"file\" id=\"pm-upload\" accept=\"image/*\">\n    </label>\n\n    <div class=\"pm-hint\">\n      Przeciągnij • Scroll • Dwuklik\n    </div>\n  </div>\n\n</div>\n\n\n<style>\n#pm-hero{\n  position:relative;\n  width:100%;\n  height:90vh;\n  min-height:700px;\n  overflow:hidden;\n  background:#000;\n  font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Display\",Arial,sans-serif;\n}\n\n/* CANVAS FULLSCREEN */\n.pm-stage{\n  position:absolute;\n  inset:0;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n}\n\n/* WRAPPER (mockup frame) */\n#pm-wrapper{\n  position:relative;\n  border-radius:20px;\n  overflow:hidden;\n  box-shadow:0 60px 140px rgba(0,0,0,.7);\n  transform:scale(1.1); /* lekki zoom jak hero */\n}\n\n#pm-canvas{\n  display:block;\n  cursor:grab;\n}\n\n#pm-frame{\n  position:absolute;\n  inset:0;\n  width:100%;\n  height:100%;\n  pointer-events:none;\n}\n\n/* OVERLAY (tekst na środku) */\n.pm-overlay{\n  position:absolute;\n  top:50%;\n  left:50%;\n  transform:translate(-50%, -50%);\n  text-align:center;\n  color:#fff;\n  z-index:20;\n  width:90%;\n  max-width:700px;\n}\n\n/* gradient fade żeby tekst był czytelny */\n.pm-overlay::before{\n  content:\"\";\n  position:absolute;\n  inset:-80px;\n  background:radial-gradient(circle, rgba(0,0,0,.55), transparent 70%);\n  z-index:-1;\n}\n\n/* badge */\n.pm-badge{\n  display:inline-block;\n  padding:6px 12px;\n  border-radius:999px;\n  background:rgba(255,255,255,.1);\n  border:1px solid rgba(255,255,255,.2);\n  font-size:12px;\n  letter-spacing:.12em;\n  margin-bottom:16px;\n}\n\n/* heading */\n.pm-overlay h1{\n  font-size:48px;\n  font-weight:700;\n  margin:0 0 12px;\n  letter-spacing:-0.04em;\n}\n\n/* text */\n.pm-overlay p{\n  font-size:18px;\n  opacity:.8;\n  margin-bottom:26px;\n}\n\n/* button */\n.pm-upload-btn{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  padding:16px 28px;\n  border-radius:14px;\n  background:linear-gradient(180deg,#fff,#ddd);\n  color:#000;\n  font-weight:600;\n  cursor:pointer;\n  transition:.25s;\n}\n\n.pm-upload-btn:hover{\n  transform:translateY(-2px);\n}\n\n.pm-upload-btn input{\n  display:none;\n}\n\n/* hint */\n.pm-hint{\n  margin-top:18px;\n  font-size:12px;\n  opacity:.6;\n}\n</style>\n\n<script> (function(){ const canvas = document.getElementById(\"pm-canvas\"); const ctx = canvas.getContext(\"2d\", { alpha: true }); const frame = document.getElementById(\"pm-frame\"); const wrapper = document.getElementById(\"pm-wrapper\"); const upload = document.getElementById(\"pm-upload\"); const frames = { landscape: { src: \"https://cdn.shopify.com/s/files/1/1011/0517/2828/files/a4_poziom.png?v=1775501770\", rendered: { w: 1000, h: 800 }, source: { w: 1447, h: 1086 }, window: { x: 311, y: 269, w: 829, h: 549 } }, portrait: { src: \"https://cdn.shopify.com/s/files/1/1011/0517/2828/files/a4_pion_10e07819-b9f8-4529-a9e2-0f217a5d092b.png?v=1775501771\", rendered: { w: 800, h: 1000 }, source: { w: 1086, h: 1447 }, window: { x: 269, y: 306, w: 549, h: 829 } } }; const MAX_ZOOM = 12; const MIN_ZOOM = 1; let img = null; let mode = \"portrait\"; let baseScale = 1; let objectUrl = null; const view = { zoom: 1, x: 0, y: 0 }; const target = { zoom: 1, x: 0, y: 0 }; let dragging = false; let raf = 0; let lastPointer = { x: 0, y: 0 }; function getWindow(){ const f = frames[mode]; const sx = f.rendered.w / f.source.w; const sy = f.rendered.h / f.source.h; return { x: f.window.x * sx, y: f.window.y * sy, w: f.window.w * sx, h: f.window.h * sy }; } function setFrame(nextMode){ mode = nextMode; const f = frames[mode]; canvas.width = f.rendered.w; canvas.height = f.rendered.h; canvas.style.width = f.rendered.w + \"px\"; canvas.style.height = f.rendered.h + \"px\"; wrapper.style.width = f.rendered.w + \"px\"; wrapper.style.height = f.rendered.h + \"px\"; frame.src = f.src; } function clampToWindow(x, y, zoom){ if(!img) return { x, y }; const win = getWindow(); const w = img.width * baseScale * zoom; const h = img.height * baseScale * zoom; let cx = x; let cy = y; if(w <= win.w){ cx = win.x + (win.w - w) / 2; } else { const minX = win.x + win.w - w; const maxX = win.x; cx = Math.max(minX, Math.min(maxX, cx)); } if(h <= win.h){ cy = win.y + (win.h - h) / 2; } else { const minY = win.y + win.h - h; const maxY = win.y; cy = Math.max(minY, Math.min(maxY, cy)); } return { x: cx, y: cy }; } function syncTargetToWindow(){ const clamped = clampToWindow(target.x, target.y, target.zoom); target.x = clamped.x; target.y = clamped.y; } function fitImage(instant = true){ if(!img) return; const win = getWindow(); baseScale = Math.max(win.w / img.width, win.h / img.height); const x = win.x + (win.w - img.width * baseScale) / 2; const y = win.y + (win.h - img.height * baseScale) / 2; target.zoom = 1; target.x = x; target.y = y; if(instant){ view.zoom = 1; view.x = x; view.y = y; draw(); } else { schedule(); } } function draw(){ ctx.clearRect(0, 0, canvas.width, canvas.height); ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = \"high\"; if(!img) return; const scale = baseScale * view.zoom; ctx.drawImage(img, view.x, view.y, img.width * scale, img.height * scale); } function lerp(current, destination, alpha){ return current + (destination - current) * alpha; } function nearlyEqual(a, b, eps){ return Math.abs(a - b) <= eps; } function schedule(){ if(!raf) raf = requestAnimationFrame(tick); } function tick(){ raf = 0; if(!img){ draw(); return; } const zoomSpeed = dragging ? 0.22 : 0.12; const posSpeed = dragging ? 0.28 : 0.14; view.zoom = lerp(view.zoom, target.zoom, zoomSpeed); view.x = lerp(view.x, target.x, posSpeed); view.y = lerp(view.y, target.y, posSpeed); const clampedView = clampToWindow(view.x, view.y, view.zoom); view.x = clampedView.x; view.y = clampedView.y; if(nearlyEqual(view.zoom, target.zoom, 0.0005)) view.zoom = target.zoom; if(nearlyEqual(view.x, target.x, 0.03)) view.x = target.x; if(nearlyEqual(view.y, target.y, 0.03)) view.y = target.y; draw(); const stillMoving = !nearlyEqual(view.zoom, target.zoom, 0.0005) || !nearlyEqual(view.x, target.x, 0.03) || !nearlyEqual(view.y, target.y, 0.03) || dragging; if(stillMoving) schedule(); } function endDrag(e){ if(!dragging) return; dragging = false; canvas.style.cursor = \"grab\"; try { canvas.releasePointerCapture(e.pointerId); } catch(_){} syncTargetToWindow(); schedule(); } setFrame(\"portrait\"); upload.addEventListener(\"change\", (e) => { const file = e.target.files && e.target.files[0]; if(!file) return; const image = new Image(); const url = URL.createObjectURL(file); image.onload = () => { if(objectUrl){ try { URL.revokeObjectURL(objectUrl); } catch(_){} } objectUrl = url; img = image; const isLandscape = image.width >= image.height; setFrame(isLandscape ? \"landscape\" : \"portrait\"); fitImage(true); upload.value = \"\"; }; image.src = url; }); canvas.addEventListener(\"pointerdown\", (e) => { if(!img) return; dragging = true; canvas.setPointerCapture(e.pointerId); lastPointer = { x: e.clientX, y: e.clientY }; canvas.style.cursor = \"grabbing\"; }); canvas.addEventListener(\"pointermove\", (e) => { if(!dragging || !img) return; const dx = e.clientX - lastPointer.x; const dy = e.clientY - lastPointer.y; lastPointer = { x: e.clientX, y: e.clientY }; target.x += dx; target.y += dy; syncTargetToWindow(); schedule(); }); canvas.addEventListener(\"pointerup\", endDrag); canvas.addEventListener(\"pointercancel\", endDrag); canvas.addEventListener(\"pointerleave\", () => { if(dragging) schedule(); }); canvas.addEventListener(\"wheel\", (e) => { if(!img) return; e.preventDefault(); const rect = canvas.getBoundingClientRect(); const mx = e.clientX - rect.left; const my = e.clientY - rect.top; const factor = Math.exp(-e.deltaY * 0.001); const nextZoom = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, target.zoom * factor)); const beforeScale = baseScale * target.zoom; const worldX = (mx - target.x) / beforeScale; const worldY = (my - target.y) / beforeScale; target.zoom = nextZoom; const nextScale = baseScale * nextZoom; target.x = mx - worldX * nextScale; target.y = my - worldY * nextScale; syncTargetToWindow(); schedule(); }, { passive: false }); canvas.addEventListener(\"dblclick\", () => { if(!img) return; fitImage(false); schedule(); }); window.addEventListener(\"resize\", () => { if(!img) return; const prevZoom = target.zoom; const prevX = target.x; const prevY = target.y; const isLandscape = img.width >= img.height; setFrame(isLandscape ? \"landscape\" : \"portrait\"); baseScale = Math.max(getWindow().w / img.width, getWindow().h / img.height); target.zoom = prevZoom; target.x = prevX; target.y = prevY; syncTargetToWindow(); view.zoom = Math.min(view.zoom, MAX_ZOOM); schedule(); }); })(); </script>",
