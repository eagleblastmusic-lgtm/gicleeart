        "custom_liquid": "<div id=\"giclee-shell\">\n  <button type=\"button\" id=\"giclee-back\" class=\"giclee-back\">\n    <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\">\n      <path d=\"M8 14V2M2 8l6-6 6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </svg>\n    Wróć do podglądu\n  </button>\n\n  <iframe\n    id=\"giclee-tool\"\n    src=\"https://kalkulator1-henna.vercel.app/\"\n    title=\"Giclée Art Calculator\"\n    loading=\"lazy\"\n    allow=\"clipboard-read; clipboard-write\"\n  ></iframe>\n</div>\n\n<style>\n  html,\n  body {\n    overflow-x: hidden;\n  }\n\n  .shopify-section:has(#giclee-shell) {\n  display: none;\n    position: relative;\n    z-index: 60;\n    isolation: isolate;\n    margin-top: clamp(-20vh, -14rem, -8rem);\n    padding: 0 !important;\n  }\n\n.shopify-section:has(#giclee-shell).giclee-section-active {\n  display: block;\n}\n  #giclee-shell {\n    width: 100vw;\n    height: 100vh;\n    min-height: 560px;\n    margin-left: calc(-50vw + 50%);\n    position: relative;\n    overflow: hidden;\n    background: #000;\n\n    opacity: 0;\n    transform: translateY(56px) scale(0.97);\n    transition:\n      opacity 1s cubic-bezier(0.22, 1, 0.36, 1),\n      transform 1s cubic-bezier(0.22, 1, 0.36, 1);\n  }\n\n  #giclee-shell.giclee-visible {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n\n  #giclee-tool {\n    width: 100%;\n    height: 100%;\n    border: 0;\n    display: block;\n    background: #000;\n  }\n\n  .giclee-back {\n    position: absolute;\n    top: 16px;\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 10;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 9px 18px;\n    border: 1px solid rgba(255, 255, 255, 0.18);\n    border-radius: 999px;\n    background: rgba(0, 0, 0, 0.52);\n    color: rgba(255, 255, 255, 0.75);\n    font: 600 12px/1 system-ui, sans-serif;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    cursor: pointer;\n    backdrop-filter: blur(10px);\n    transition: color 0.2s ease, background 0.2s ease, opacity 0.2s ease;\n\n    opacity: 0;\n    animation: glBackIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.8s forwards;\n  }\n\n  .giclee-back:hover {\n    color: #fff;\n    background: rgba(255, 255, 255, 0.12);\n  }\n\n  @keyframes glBackIn {\n    from { opacity: 0; transform: translateX(-50%) translateY(-8px); }\n    to   { opacity: 1; transform: translateX(-50%) translateY(0); }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #giclee-shell {\n      opacity: 1 !important;\n      transform: none !important;\n      transition: none !important;\n    }\n    .giclee-back {\n      animation: none !important;\n      opacity: 1 !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var shell = document.getElementById(\"giclee-shell\");\n    if (!shell) return;\n\n    var host = shell.closest(\".shopify-section\");\n    if (host) {\n      host.style.position = \"relative\";\n      host.style.zIndex = \"60\";\n    }\n\n    new IntersectionObserver(\n      function (entries) {\n        entries.forEach(function (entry) {\n          if (entry.isIntersecting) {\n            shell.classList.add(\"giclee-visible\");\n          }\n        });\n      },\n      { threshold: 0.06, rootMargin: \"0px 0px -4% 0px\" }\n    ).observe(shell);\n\n    var backBtn = document.getElementById(\"giclee-back\");\n    if (backBtn) {\n      backBtn.addEventListener(\"click\", function () {\n        var target =\n          document.getElementById(\"pm-hero\") ||\n          document.querySelector(\"[id*='pm-hero']\");\n        if (target) {\n          var top =\n            target.getBoundingClientRect().top +\n            (window.pageYOffset || window.scrollY);\n          window.scrollTo({ top: top, behavior: \"smooth\" });\n        } else {\n          window.scrollTo({ top: 0, behavior: \"smooth\" });\n        }\n      });\n    }\n  })();\n</script>",
