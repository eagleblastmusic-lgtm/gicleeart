0, 0) 52%),\n      linear-gradient(180deg, var(--pm-bg0) 0%, var(--pm-bg1) 55%, #050505 100%);\n\n    transition: padding 0.55s ease;\n  }\n\n  #pm-hero .pm-badge {\n    display: inline-block;\n    margin: 0 0 14px;\n    padding: 6px 12px;\n    border: 1px solid var(--pm-line);\n    border-radius: 999px;\n    font-size: 11px;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: rgba(255, 255, 255, 0.62);\n    background: rgba(255, 255, 255, 0.03);\n  }\n\n  #pm-hero .pm-header {\n    width: min(920px, 100%);\n    margin: 0 auto;\n  }\n\n  #pm-hero .pm-header h2 {\n    margin: 0 0 12px;\n    font-size: clamp(30px, 4.2vw, 46px);\n    font-weight: 650;\n    letter-spacing: -0.03em;\n    line-height: 1.08;\n    text-shadow: 0 18px 55px rgba(0, 0, 0, 0.55);\n  }\n\n  #pm-hero .pm-header p {\n    margin: 0 auto;\n    max-width: 46ch;\n    font-size: 15px;\n    line-height: 1.55;\n    color: var(--pm-muted);\n  }\n\n  #pm-hero .pm-upload-btn {\n    margin-top: 18px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 14px 20px;\n    border-radius: 999px;\n    border: 1px solid rgba(255, 255, 255, 0.14);\n    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(235, 235, 235, 0.96));\n    color: #101010;\n    font-size: 14px;\n    font-weight: 650;\n    letter-spacing: 0.01em;\n    cursor: pointer;\n    box-shadow:\n      0 1px 0 rgba(255, 255, 255, 0.55) inset,\n      0 18px 45px rgba(0, 0, 0, 0.38);\n    transition: transform 0.18s ease, box-shadow 0.18s ease;\n  }\n\n  #pm-hero .pm-upload-btn:hover {\n    transform: translateY(-1px);\n    box-shadow:\n      0 1px 0 rgba(255, 255, 255, 0.65) inset,\n      0 22px 55px rgba(0, 0, 0, 0.45);\n  }\n\n  #pm-hero .pm-upload-btn input {\n    display: none;\n  }\n\n  .pm-stage {\n    width: 100%;\n    margin-top: clamp(22px, 3.5vw, 34px);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 14px;\n  }\n\n  #pm-wrapper {\n    position: relative;\n    width: min(800px, 100%);\n    border-radius: 18px;\n    overflow: hidden;\n    background: #0a0a0a;\n    box-shadow:\n      0 30px 90px rgba(0, 0, 0, 0.62),\n      0 0 0 1px rgba(255, 255, 255, 0.05) inset;\n    transform: translateZ(0);\n    transition: transform 0.65s ease, box-shadow 0.65s ease;\n  }\n\n  #pm-canvas {\n    position: relative;\n    z-index: 1;\n    display: block;\n    width: 100%;\n    height: auto;\n    vertical-align: top;\n    touch-action: none;\n    cursor: grab;\n  }\n\n  #pm-canvas.pm-dragging {\n    cursor: grabbing;\n  }\n\n  #pm-frame {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: fill;\n    pointer-events: none;\n    z-index: 2;\n  }\n\n  .pm-glow,\n  .pm-vignette,\n  .pm-grain,\n  .pm-sheen {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    z-index: 3;\n  }\n\n  .pm-hint {\n    margin: 0;\n    font-size: 11px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: rgba(255, 255, 255, 0.42);\n  }\n\n  #pm-hero.loaded {\n    min-height: 0;\n    padding-top: clamp(22px, 4vw, 40px);\n    padding-bottom: clamp(30px, 5vw, 56px);\n  }\n\n  #pm-hero.loaded #pm-wrapper {\n    transform: scale(0.985);\n    box-shadow:\n      0 22px 70px rgba(0, 0, 0, 0.55),\n      0 0 0 1px rgba(255, 255, 255, 0.05) inset;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #pm-hero,\n    #pm-wrapper,\n    #pm-hero .pm-upload-btn {\n      transition: none !important;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    const hero = document.getElementById(\"pm-hero\");\n    const canvas = document.getElementById(\"pm-canvas\");\n    const ctx = canvas.getContext(\"2d\");\n    const frame = document.getElementById(\"pm-frame\");\n    const wrapper = document.getElementById(\"pm-wrapper\");\n    const upload = document.getElementById(\"pm-upload\");\n\n    const frames = {\n      landscape: {\n        src: \"https://cdn.shopify.com/s/files/1/1011/0517/2828/files/a4_poziom.png?v=1775501770\",\n        rendered: { w: 1000, h: 800 },\n        source: { w: 1447, h: 1086 },\n        window: { x: 311, y: 269, w: 829, h: 549 },\n      },\n      portrait: {\n        src: \"https://cdn.shopify.com/s/files/1/1011/0517/2828/files/a4_pion.png?v=1775501771\",\n        rendered: { w: 800, h: 1000 },\n        source: { w: 1086, h: 1447 },\n        window: { x: 269, y: 306, w: 549, h: 829 },\n      },\n    };\n\n    let img = null;\n    let mode = \"portrait\";\n    let baseScale = 1;\n\n    const view = { zoom: 1, x: 0, y: 0 };\n    let targetZoom = 1;\n    let zoomAnchor = { x: 0, y: 0 };\n\n    let dragging = false;\n    let dragStart = { x: 0, y: 0 };\n    let viewStart = { x: 0, y: 0 };\n\n    let raf = 0;\n\n    function clientToCanvas(clientX, clientY) {\n      const rect = canvas.getBoundingClientRect();\n      const sx = canvas.width / rect.width;\n      const sy = canvas.height / rect.height;\n      return { x: (clientX - rect.left) * sx, y: (clientY - rect.top) * sy };\n    }\n\n    function setFrame(nextMode) {\n      mode = nextMode;\n      const f = frames[mode];\n\n      canvas.width = f.rendered.w;\n      canvas.height = f.rendered.h;\n\n      wrapper.style.width = f.rendered.w + \"px\";\n      wrapper.style.maxWidth = \"100%\";\n      wrapper.style.height = \"auto\";\n      wrapper.style.aspectRatio = f.rendered.w + \" / \" + f.rendered.h;\n\n      frame.src = f.src;\n    }\n\n    function getWindow() {\n      const f = frames[mode];\n      const sx = f.rendered.w / f.source.w;\n      const sy = f.rendered.h / f.source.h;\n      return {\n        x: f.window.x * sx,\n        y: f.window.y * sy,\n        w: f.window.w * sx,\n        h: f.window.h * sy,\n      };\n    }\n\n    function clampView() {\n      if (!img) return;\n\n      const win = getWindow();\n      const scale = baseScale * view.zoom;\n      const iw = img.width * scale;\n      const ih = img.height * scale;\n\n      const minX = win.x + win.w - iw;\n      const maxX = win.x;\n      const minY = win.y + win.h - ih;\n      const maxY = win.y;\n\n      view.x = Math.min(maxX, Math.max(minX, view.x));\n      view.y = Math.min(maxY, Math.max(minY, view.y));\n    }\n\n    function applyZoomAtPoint(newZoom, anchor) {\n      const z = Math.max(1, Math.min(4, newZoom));\n      const oldZoom = view.zoom;\n      if (Math.abs(z - oldZoom) < 1e-9) return;\n\n      const sOld = baseScale * oldZoom;\n      const sNew = baseScale * z;\n      const relX = (anchor.x - view.x) / sOld;\n      const relY = (anchor.y - view.y) / sOld;\n\n      view.zoom = z;\n      view.x = anchor.x - relX * sNew;\n      view.y = anchor.y - relY * sNew;\n\n      clampView();\n    }\n\n    function fitImage() {\n      if (!img) return;\n\n      const win = getWindow();\n      baseScale = Math.max(win.w / img.width, win.h / img.height);\n\n      view.zoom = 1;\n      targetZoom = 1;\n\n      const scale = baseScale * view.zoom;\n      view.x = win.x + (win.w - img.width * scale) / 2;\n      view.y = win.y + (win.h - img.height * scale) / 2;\n\n      clampView();\n      draw();\n    }\n\n    function draw() {\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\n      if (!img) return;\n      const scale = baseScale * view.zoom;\n      ctx.drawImage(img, view.x, view.y, img.width * scale, img.height * scale);\n    }\n\n    function tickZoom() {\n      if (!img) return;\n\n      const damp = 0.18;\n      const next = view.zoom + (targetZoom - view.zoom) * damp;\n\n      if (Math.abs(targetZoom - view.zoom) < 0.002) {\n        applyZoomAtPoint(targetZoom, zoomAnchor);\n        draw();\n        return;\n      }\n\n      applyZoomAtPoint(next, zoomAnchor);\n      draw();\n      raf = requestAnimationFrame(tickZoom);\n    }\n\n    function scheduleZoomAnim() {\n      cancelAnimationFrame(raf);\n      raf = requestAnimationFrame(tickZoom);\n    }\n\n    canvas.addEventListener(\n      \"wheel\",\n      function (e) {\n        if (!img) return;\n        e.preventDefault();\n\n        zoomAnchor = clientToCanvas(e.clientX, e.clientY);\n        const factor = Math.exp(-e.deltaY * 0.00115);\n        targetZoom = Math.max(1, Math.min(4, view.zoom * factor));\n\n        scheduleZoomAnim();\n      },\n      { passive: false }\n    );\n\n    canvas.addEventListener(\"pointerdown\", function (e) {\n      if (!img || e.button !== 0) return;\n      e.preventDefault();\n      canvas.setPointerCapture(e.pointerId);\n      dragging = true;\n      canvas.classList.add(\"pm-dragging\");\n\n      const p = clientToCanvas(e.clientX, e.clientY);\n      dragStart = p;\n      viewStart = { x: view.x, y: view.y };\n    });\n\n    canvas.addEventListener(\"pointermove\", function (e) {\n      if (!dragging || !img) return;\n      const p = clientToCanvas(e.clientX, e.clientY);\n      view.x = viewStart.x + (p.x - dragStart.x);\n      view.y = viewStart.y + (p.y - dragStart.y);\n      clampView();\n      draw();\n    });\n\n    function endDrag(e) {\n      if (!dragging) return;\n      dragging = false;\n      canvas.classList.remove(\"pm-dragging\");\n      try {\n        canvas.releasePointerCapture(e.pointerId);\n      } catch (err) {}\n    }\n\n    canvas.addEventListener(\"pointerup\", endDrag);\n    canvas.addEventListener(\"pointercancel\", endDrag);\n\n    canvas.addEventListener(\"dblclick\", function (e) {\n      if (!img) return;\n      e.preventDefault();\n      fitImage();\n    });\n\n    setFrame(\"portrait\");\n\n    upload.addEventListener(\"change\", function (e) {\n      const file = e.target.files[0];\n      if (!file) return;\n\n      const image = new Image();\n      const url = URL.createObjectURL(file);\n\n      image.onload = function () {\n        img = image;\n        hero.classList.add(\"loaded\");\n\n        const isLandscape = image.width >= image.height;\n        setFrame(isLandscape ? \"landscape\" : \"portrait\");\n        fitImage();\n      };\n\n      image.src = url;\n    });\n  })();\n</script>",
