/* ===== GALLERY DROPDOWN ===== */
#giclee-catalog-panel {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  z-index: 2147483647;
  background: #0c0b09;
  border-bottom: 1px solid rgba(201,168,76,0.2);
  box-shadow: 0 60px 120px rgba(0,0,0,0.95);
  display: grid;
  grid-template-columns: 1fr var(--giclee-catalog-preview-width, 560px);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: opacity 0.4s ease, transform 0.4s ease, visibility 0.4s;
  max-height: var(--giclee-catalog-panel-max-height, 82vh);
  overflow: hidden;
  font-family: 'Inter', sans-serif;
}

#giclee-catalog-panel.is-open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

#giclee-artists-list {
  padding: 36px 48px;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(201,168,76,0.25) transparent;
  border-right: 1px solid rgba(201,168,76,0.1);
  display: flex;
  flex-direction: column;
  clip-path: inset(0 0 0 0);
  will-change: clip-path;
}

.giclee-artists-columns {
  display: grid;
  grid-template-columns: repeat(var(--giclee-catalog-list-columns, 3), minmax(0, 1fr));
  gap: 32px;
  flex: 1;
  align-items: start;
}

.giclee-artists-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

#giclee-artists-list a {
  display: block;
  color: rgba(230,225,215,0.75);
  text-decoration: none;
  font-size: 12.5px;
  font-weight: 400;
  letter-spacing: 0.05em;
  padding: 3px 0;
  line-height: 1.4;
  transition: color 0.2s ease, padding-left 0.25s ease, letter-spacing 0.25s ease;
  white-space: nowrap;
  cursor: pointer;
}
#giclee-catalog-panel.is-open.staggering #giclee-artists-list a {
  opacity: 0;
  transform: translateY(10px);
}
#giclee-catalog-panel.is-open.staggering #giclee-artists-list a.is-in {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1), transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
}

#giclee-artists-list a:hover,
#giclee-artists-list a.is-active {
  color: rgba(201,168,76,1);
  padding-left: 10px;
  letter-spacing: 0.08em;
}

#giclee-artists-list .giclee-artists-list-header {
  font-size: 9px;
  letter-spacing: 0.45em;
  text-transform: uppercase;
  color: rgba(201,168,76,0.5);
  font-weight: 500;
  padding-bottom: 20px;
  font-family: 'Inter', sans-serif;
  flex-shrink: 0;
}

#giclee-artist-preview {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  position: relative;
  overflow: hidden;
  min-height: 440px;
  background: #080706;
}

/* KLUCZOWE: transition tylko przez CSS, bez inline styles */
#giclee-preview-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  filter: brightness(0.5) saturate(0.75);
  transition: opacity 0.6s ease;
}

#giclee-preview-img.is-visible {
  opacity: 1;
}

#giclee-preview-info {
  position: relative;
  z-index: 2;
  padding: 36px;
  background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.3) 60%, transparent 100%);
}

#giclee-preview-line {
  width: 28px;
  height: 1px;
  background: rgba(201,168,76,0.6);
  margin-bottom: 14px;
}

#giclee-preview-name {
  font-size: 20px;
  font-weight: 300;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.95);
  margin: 0 0 8px 0;
  font-family: 'Inter', sans-serif;
}

#giclee-preview-count {
  font-size: 9px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: rgba(201,168,76,0.75);
  font-family: 'Inter', sans-serif;
}

</style>


