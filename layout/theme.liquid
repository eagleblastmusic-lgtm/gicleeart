<!doctype html>
{%- liquid
  assign giclee_skip_splash = false
  if request.query_string contains 'giclee_skip_splash=1'
    assign giclee_skip_splash = true
  endif
-%}
<html
  class="{%- if request.design_mode -%}shopify-design-mode {%- endif -%}"
  lang="{{ request.locale.iso_code }}"
  {%- if giclee_skip_splash -%} data-giclee-skip-splash="1"{%- endif -%}
>
  <head>
    {%- if request.page_type == 'index' and request.design_mode == false -%}
    <script>
      (function() {
        try {
          if (new URLSearchParams(window.location.search).get('giclee_skip_splash') === '1') {
            document.documentElement.dataset.gicleeSkipSplash = '1';
            return;
          }
        } catch (e) {}
        document.documentElement.classList.add('splash-pending');
      })();
    </script>
    {%- endif -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500&family=Cormorant+Garamond:wght@300&display=swap" rel="stylesheet">



    
<style>
  html {
    scrollbar-gutter: stable;
  }
  @supports not (scrollbar-gutter: stable) {
    html { overflow-y: scroll; }
  }
  body { overflow-x: hidden; }
</style>

    {%- if request.page_type == 'index' -%}
    {% render 'giclee-home-stack-critical' %}
    <script src="{{ 'giclee-home-sections.js' | asset_url }}" defer></script>
    <script src="{{ 'giclee-home-mobile.js' | asset_url }}" defer></script>
    <script src="{{ 'giclee-home-sections-boot.js' | asset_url }}" defer></script>
    {{ 'giclee-home-stack.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'giclee-home-stack.js' | asset_url }}" defer></script>
    {{ 'giclee-home-section-scroll.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'giclee-home-section-scroll.js' | asset_url }}" defer></script>
    <script src="{{ 'giclee-hero-video-collage.js' | asset_url }}" defer></script>
    <script src="{{ 'giclee-hero-video-collage-player.js' | asset_url }}" defer></script>
    {{ 'giclee-hero-video-collage.css' | asset_url | stylesheet_tag }}
    {{ 'giclee-home-final-difference.css' | asset_url | stylesheet_tag }}
    {{ 'giclee-home-studio-reveal.css' | asset_url | stylesheet_tag }}
    <link
      rel="preload"
      as="image"
      href="{{ 'MALE_ORG.webp' | asset_url }}"
      media="(max-width: 767px)"
    >
    {%- endif -%}
    {%- if request.page_type == 'page' and template.suffix == 'giclee-frame' -%}
    <script src="{{ 'giclee-frame-section-effects.js' | asset_url }}" defer></script>
    {{ 'giclee-page-section-effects.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'giclee-page-section-effects-boot.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- if request.page_type == 'index' and request.design_mode == false -%}
    <style>
      html.splash-pending,
      html.splash-reveal {
        overflow-y: hidden;
        background: #000;
      }
      html.splash-pending body,
      html.splash-reveal body {
        overflow-y: hidden;
        background: #000;
      }
      html.splash-pending #splash-screen {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex !important;
        align-items: center;
        justify-content: center;
        background: #000;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
      }
      html.splash-pending body > :not(#page-transition):not(#splash-screen),
      html.splash-pending #header-group,
      html.splash-pending #MainContent,
      html.splash-pending body > footer {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
      }
      html.splash-reveal body > :not(#page-transition):not(#splash-screen) {
        opacity: 0 !important;
        visibility: visible !important;
        pointer-events: none !important;
        transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }
      html.splash-reveal.splash-reveal-active body > :not(#page-transition):not(#splash-screen) {
        opacity: 1 !important;
        pointer-events: auto !important;
      }
      html.splash-reveal slideshow-component,
      html.splash-reveal slideshow-component * {
        transition: none !important;
        animation: none !important;
      }
      html.splash-pending #page-transition,
      html.splash-reveal #page-transition {
        display: none !important;
      }
      html.splash-pending #MainContent,
      html.splash-reveal #MainContent {
        overflow: hidden;
        max-height: 100vh;
      }
      html[data-giclee-skip-splash="1"] #splash-screen {
        display: none !important;
      }
    </style>
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      {% unless giclee_skip_splash %}
      <link
        rel="expect"
        href="#MainContent"
        id="view-transition-render-blocker"
      >
      {% endunless %}
    {% endif %}
    <script>
      try {
        if (new URLSearchParams(window.location.search).get('giclee_skip_splash') === '1') {
          document.getElementById('view-transition-render-blocker')?.remove();
        }
        if (sessionStorage.getItem('giclee-curtain-nav') === '1') {
          document.documentElement.classList.add('curtain-pending');
          document.getElementById('view-transition-render-blocker')?.remove();
        }
      } catch (e) {}
    </script>
    <style>
      html.curtain-pending body > :not(#page-transition) {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
      }
      html.curtain-pending #page-transition {
        z-index: 2147483647 !important;
        pointer-events: none;
      }
    </style>

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

