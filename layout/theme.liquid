<!doctype html>
{%- liquid
  assign giclee_skip_splash = false
  if request.query_string contains 'giclee_skip_splash=1'
    assign giclee_skip_splash = true
  endif
-%}
<html
  class="{%- if request.design_mode -%}shopify-design-mode {%- endif -%}"
  lang="{{ request.locale.iso_code }}"
  data-giclee-button-style="{{ settings.giclee_button_style | default: 'basic' }}"
  {%- if giclee_skip_splash -%} data-giclee-skip-splash="1"{%- endif -%}
>
  <head>
    {%- if request.page_type == 'index' and request.design_mode == false -%}
    <script>
      (function() {
        try {
          if (new URLSearchParams(window.location.search).get('giclee_skip_splash') === '1') {
            document.documentElement.dataset.gicleeSkipSplash = '1';
            return;
          }
        } catch (e) {}
        document.documentElement.classList.add('splash-pending');
      })();
    </script>
    {%- endif -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500&family=Cormorant+Garamond:wght@300&display=swap" rel="stylesheet">
    {%- if settings.giclee_button_style == 'nocturne' -%}
      <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500&display=swap"
        rel="stylesheet"
      >
    {%- endif -%}



    
<style>
  html {
    scrollbar-gutter: stable;
  }
  @supports not (scrollbar-gutter: stable) {
    html { overflow-y: scroll; }
  }
  body { overflow-x: hidden; }
</style>

    {%- if request.page_type == 'index' -%}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lenis@1.3.25/dist/lenis.css">
    <script src="https://cdn.jsdelivr.net/npm/lenis@1.3.25/dist/lenis.min.js" defer></script>
    {{ 'giclee-home-smooth-scroll.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'giclee-home-smooth-scroll.js' | asset_url }}" defer></script>
    {% render 'giclee-home-stack-critical' %}
    <script src="{{ 'giclee-home-sections.js' | asset_url }}" defer></script>
    <script src="{{ 'giclee-home-mobile.js' | asset_url }}" defer></script>
    <script src="{{ 'giclee-home-sections-boot.js' | asset_url }}" defer></script>
    {{ 'giclee-home-stack.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'giclee-home-stack.js' | asset_url }}" defer></script>
    {{ 'giclee-home-section-scroll.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'giclee-home-section-scroll.js' | asset_url }}" defer></script>
    <script src="{{ 'giclee-hero-video-collage.js' | asset_url }}" defer></script>
    <script src="{{ 'giclee-hero-video-collage-player.js' | asset_url }}" defer></script>
    {{ 'giclee-hero-video-collage.css' | asset_url | stylesheet_tag }}
    {{ 'giclee-home-final-difference.css' | asset_url | stylesheet_tag }}
    {{ 'giclee-home-studio-reveal.css' | asset_url | stylesheet_tag }}
    <link
      rel="preload"
      as="image"
      href="{{ 'MALE_ORG.webp' | asset_url }}"
      media="(max-width: 767px)"
    >
    {%- endif -%}
    {%- if request.page_type == 'page' and template.suffix == 'giclee-frame' -%}
    <script src="{{ 'giclee-frame-section-effects.js' | asset_url }}" defer></script>
    {{ 'giclee-page-section-effects.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'giclee-page-section-effects-boot.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- if request.page_type == 'page' and template.suffix == 'faq' -%}
    <script src="{{ 'faq-section-effects.js' | asset_url }}" defer></script>
    {{ 'giclee-page-section-effects.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'giclee-page-section-effects-boot.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- if request.page_type == 'index' and request.design_mode == false -%}
    <style>
      html.splash-pending,
      html.splash-reveal {
        overflow-y: hidden;
        background: #000;
      }
      html.splash-pending body,
      html.splash-reveal body {
        overflow-y: hidden;
        background: #000;
      }
      html.splash-pending #splash-screen {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex !important;
        align-items: center;
        justify-content: center;
        background: #000;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
      }
      html.splash-pending body > :not(#page-transition):not(#splash-screen),
      html.splash-pending #header-group,
      html.splash-pending #MainContent,
      html.splash-pending body > footer {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
      }
      html.splash-reveal body > :not(#page-transition):not(#splash-screen) {
        opacity: 0 !important;
        visibility: visible !important;
        pointer-events: none !important;
        transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }
      html.splash-reveal.splash-reveal-active body > :not(#page-transition):not(#splash-screen) {
        opacity: 1 !important;
        pointer-events: auto !important;
      }
      html.splash-reveal slideshow-component,
      html.splash-reveal slideshow-component * {
        transition: none !important;
        animation: none !important;
      }
      html.splash-pending #page-transition,
      html.splash-reveal #page-transition {
        display: none !important;
      }
      html.splash-pending #MainContent,
      html.splash-reveal #MainContent {
        overflow: hidden;
        max-height: 100vh;
      }
      html[data-giclee-skip-splash="1"] #splash-screen {
        display: none !important;
      }
    </style>
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      {% unless giclee_skip_splash %}
      <link
        rel="expect"
        href="#MainContent"
        id="view-transition-render-blocker"
      >
      {% endunless %}
    {% endif %}
    <script>
      try {
        if (new URLSearchParams(window.location.search).get('giclee_skip_splash') === '1') {
          document.getElementById('view-transition-render-blocker')?.remove();
        }
        if (sessionStorage.getItem('giclee-curtain-nav') === '1') {
          document.documentElement.classList.add('curtain-pending');
          document.getElementById('view-transition-render-blocker')?.remove();
        }
      } catch (e) {}
    </script>
    <style>
      html.curtain-pending body > :not(#page-transition) {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
      }
      html.curtain-pending #page-transition {
        z-index: 2147483647 !important;
        pointer-events: none;
      }
    </style>

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

<style>
  body { overflow-x: hidden; }
  .mega-menu__flyout-item--has-children.is-active > a {
  visibility: visible !important;
  opacity: 1 !important;
  color: rgba(255,255,255,1) !important;
}
</style>
{%- render 'giclee-catalog-panel', part: 'styles' -%}


{{ 'custom.css' | asset_url | stylesheet_tag }}
{{ 'giclee-button-styles.css' | asset_url | stylesheet_tag }}

{%- if request.page_type == 'product' and product != blank and template.suffix != 'szablon-wlasna-fotografia' -%}
  <script>
    window.__GICLEE_PDP_PRODUCT__ = {
      "id": {{ product.id | json }},
      "optionNames": [
        {%- for option_name in product.options -%}
          {{ option_name | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | json }},
            "compare_at_price": {{ variant.compare_at_price | json }},
            "options": {{ variant.options | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    };
  </script>
  <script src="{{ 'giclee-pdp-variant-sync.js' | asset_url }}&giclee_v=pdp-layout-20260623-2306" defer></script>
{%- endif -%}


  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">

  {% render 'giclee-i18n-js' %}

  <div id="page-transition">
    <div class="pt-panel pt-left" style="transform:translateX(0);transition:none"></div>
    <div class="pt-seam" style="opacity:1;transition:none"></div>
    <div class="pt-panel pt-right" style="transform:translateX(0);transition:none"></div>
  </div>

  {% unless request.page_type == 'index' %}<style>#splash-screen{display:none!important}</style>{% endunless %}
  {% if giclee_skip_splash %}<style>#splash-screen{display:none!important}</style>{% endif %}
  {% unless giclee_skip_splash %}
  <div id="splash-screen" style="position:fixed;inset:0;background:#000;z-index:99999;display:flex;align-items:center;justify-content:center;opacity:1;visibility:visible;">
    <div class="splash-content">
      <p class="splash-title">Giclée Art</p>
      <div class="splash-line"></div>
      <p class="splash-sub">{% render 'giclee-ui-t', key: 'giclee.ui.splash_subtitle', fallback: 'Witamy w świecie sztuki' %}</p>
    </div>
  </div>
  {% endunless %}

  {% render 'giclee-theme-inline-overrides' %}
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height and menu style calculations to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerTopRow = header.querySelector('.header__row--top');
        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        if (headerTopRow) {
          window.requestAnimationFrame(function () {
            document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
          });
        }

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();

      (function setHeaderMenuStyle() {
        const headerComponent = document.querySelector('#header-component');
        if (headerComponent) {
          const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
          const overflowList = headerComponent?.querySelector('overflow-list');
          const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
          headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
        }
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% unless request.page_type == 'product' %}
    <footer>
      {% sections 'footer-group' %}
    </footer>
    {% endunless %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

{% render 'giclee-theme-runtime' %}
</body>
</html>
