      function initPmQualityPanel(root, heroEl) {
        if (root.dataset.pmQualityInit === '1') return;
        root.dataset.pmQualityInit = '1';

        var panel = root.querySelector('#pm-quality-panel');
        if (!panel) return;

        var verdictEl = panel.querySelector('.pm-quality-panel__verdict');
        var metaEl = panel.querySelector('.pm-quality-panel__meta');
        var fileEl = panel.querySelector('.pm-quality-panel__file');
        if (!fileEl && metaEl) {
          fileEl = document.createElement('div');
          fileEl.className = 'pm-quality-panel__file';
          metaEl.insertAdjacentElement('afterend', fileEl);
        }
        var barFill = panel.querySelector('.pm-quality-panel__bar-fill');
        var noteEl = panel.querySelector('.pm-quality-panel__note');
        var formatEl = panel.querySelector('.pm-quality-panel__format');

        var imageData = null;
        var viewCrop = null;
        var currentSize = pmNormalizeShopifySize(
          (window.pmFrameConfig && window.pmFrameConfig.size) || 'M'
        );
        var orientation = 'portrait';
        var qualityRaf = 0;

        function formatFileInfo(data) {
          if (!data) return '';
          var w = data.decodeWidthPx || data.widthPx;
          var h = data.decodeHeightPx || data.heightPx;
          if (!w || !h) return '';
          var mp = (w * h) / 1e6;
          var parts = [w + '×' + h + ' px', mp.toFixed(1) + ' MP'];
          if (data.fileBytes > 0) parts.push(Math.round(data.fileBytes / 1024) + ' KB');
          return parts.join(' · ');
        }

        function setPlaceholder(msg) {
          panel.className = 'pm-quality-panel pm-quality-panel--empty';
          if (verdictEl) verdictEl.textContent = gicleeT('mockup_quality_title', 'Jakość wydruku');
          if (metaEl) metaEl.textContent = '';
          if (fileEl) fileEl.textContent = '';
          if (noteEl) noteEl.textContent = msg;
          if (formatEl) formatEl.textContent = '';
          if (barFill) barFill.style.width = '0%';
        }

        function renderQualityNow() {
          var analysis = window.GicleePrintAnalysis;
          if (!analysis) {
            setPlaceholder(gicleeT('mockup_quality_loading', 'Ładowanie analizy…'));
            return;
          }
          if (!imageData || !imageData.widthPx || !imageData.heightPx) {
            setPlaceholder(gicleeT('mockup_quality_upload', 'Wgraj zdjęcie, aby zobaczyć ocenę jakości wydruku.'));
            return;
          }

          var image = { widthPx: imageData.widthPx, heightPx: imageData.heightPx };
          var sizeKey = pmNormalizeShopifySize(currentSize);
          var fileResult = analysis.analyseForShopifySize(image, sizeKey, orientation);
          if (!fileResult) {
            setPlaceholder(gicleeT('mockup_quality_select_size', 'Wybierz rozmiar, aby zobaczyć analizę.'));
            return;
          }

          var displayResult = fileResult;
          var useCropPpi =
            viewCrop &&
            viewCrop.zoom > 1.01 &&
            viewCrop.visibleWidthPx > 0 &&
            viewCrop.visibleHeightPx > 0;
          if (useCropPpi) {
            var cropResult = analysis.analyseForShopifySize(
              image,
              sizeKey,
              orientation,
              {
                widthPx: viewCrop.visibleWidthPx,
                heightPx: viewCrop.visibleHeightPx
              }
            );
            if (cropResult) displayResult = cropResult;
          }

          var active = displayResult;
          panel.className = 'pm-quality-panel pm-quality-panel--' + (active.verdict.tone || 'gray');
          if (verdictEl) verdictEl.textContent = active.verdict.label;
          if (metaEl) {
            metaEl.textContent = Math.round(active.limitingPpi) + ' PPI · cel ' + analysis.TARGET_DPI + ' DPI';
            if (useCropPpi && Math.abs(active.limitingPpi - fileResult.limitingPpi) >= 1) {
              metaEl.textContent += ' · plik ' + Math.round(fileResult.limitingPpi) + ' PPI';
            }
          }
          if (fileEl) fileEl.textContent = formatFileInfo(imageData);
          if (noteEl) noteEl.textContent = active.verdict.note;
          if (formatEl) formatEl.textContent = fileResult.name + ' · ' + sizeKey;
          if (barFill) {
            barFill.style.width = Math.min(100, active.quality) + '%';
            barFill.className = 'pm-quality-panel__bar-fill pm-quality-panel__bar-fill--' +
              analysis.barColorForPpi(active.limitingPpi);
          }
        }

        function renderQuality() {
          if (qualityRaf) return;
          qualityRaf = requestAnimationFrame(function() {
            qualityRaf = 0;
            renderQualityNow();
          });
        }

        heroEl.addEventListener('pm-image-loaded', function(e) {
          if (e.detail) {
            imageData = e.detail;
            if (e.detail.orientation) orientation = e.detail.orientation;
          }
          renderQuality();
        });

        heroEl.addEventListener('pm-frame-change', function(e) {
          if (e.detail && e.detail.orientation) {
            orientation = e.detail.orientation;
            renderQuality();
          }
        });

        heroEl.addEventListener('pm-config-change', function(e) {
          if (e.detail && e.detail.size) {
            currentSize = pmNormalizeShopifySize(e.detail.size);
            renderQuality();
          }
        });

        heroEl.addEventListener('pm-view-change', function(e) {
          if (!e.detail) return;
          viewCrop = e.detail;
          if (e.detail.orientation) orientation = e.detail.orientation;
          renderQuality();
        });

        renderQuality();
      }

      function initPmConfigurator(root, heroEl) {
        if (root.dataset.pmConfigInit === '1') return;
        root.dataset.pmConfigInit = '1';

        var toggle = root.querySelector('.pm-config-trigger');
        var options = root.querySelector('.pm-config-options');
        if (!toggle || !options) return;
        var mockupAddBtn = document.getElementById('pm-mockup-add-to-cart');
        if (mockupAddBtn) mockupAddBtn.remove();
        ensurePmSideShop(heroEl);

        if (heroEl.dataset.pmCartClickInit !== '1') {
          heroEl.dataset.pmCartClickInit = '1';
          heroEl.addEventListener('click', function(e) {
            var addBtn = e.target.closest('#pm-config-add-to-cart');
            if (!addBtn || addBtn.disabled) return;
            e.preventDefault();
            e.stopPropagation();
            pmPauseMockupAutoScroll(4000);
            publishConfig();
            heroEl.dispatchEvent(new CustomEvent('pm-config-add-to-cart', {
              bubbles: true,
              detail: window.pmFrameConfig
            }));
            pmAddConfiguredToCart(window.pmFrameConfig, addBtn);
          });
        }

        var colorLabels = {
          'czarny': 'Czarny',
          'jasny-braz': 'Jasny Brąz',
          'braz': 'Brąz',
          'ciemny-braz': 'Ciemny Brąz'
        };
        var state = { wood: 'dab', color: 'czarny', size: 'M', passepartout: 'bialy' };
        var passepartoutLabels = { bialy: 'Białe', czarny: 'Czarne' };
        var colorRow = root.querySelector('.pm-config-row[data-row="color"]');
        var sizeRow = root.querySelector('.pm-config-row[data-row="size"]');
        var priceValueEl = document.getElementById('pm-config-price-value');

        function pmFormatMoney(cents) {
          if (cents == null || !isFinite(cents)) return '';
          return (cents / 100).toLocaleString('pl-PL', {
            style: 'currency',
            currency: 'PLN',
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
          });
        }

        function syncConfigPrice() {
          if (!priceValueEl) return;
          var cfg = {
            wood: state.wood === 'dab' ? 'Dąb' : 'Sosna',
            color: colorLabels[state.color] || 'Czarny',
            size: state.size
          };
          var variant = pmResolveVariant(cfg);
          priceValueEl.classList.remove('is-unavailable');
          if (!variant) {
            priceValueEl.textContent = gicleeT('mockup_unavailable', 'Niedostępny');
            priceValueEl.classList.add('is-unavailable');
            return;
          }
          var priceHtml = pmFormatMoney(variant.price);
          if (
            variant.compare_at_price &&
            variant.compare_at_price > variant.price
          ) {
            priceHtml +=
              '<span class="pm-config-price__compare">' +
              pmFormatMoney(variant.compare_at_price) +
              '</span>';
          }
          priceValueEl.innerHTML = priceHtml;
        }

        function syncDefaultSizeUi() {
          if (!sizeRow) return;
          sizeRow.querySelectorAll('.pm-opt').forEach(function(btn) {
            var isDefaultSize = btn.getAttribute('data-value') === 'M';
            btn.classList.toggle('is-selected', isDefaultSize);
            btn.setAttribute('aria-pressed', isDefaultSize ? 'true' : 'false');
          });
        }

        function publishConfig() {
          window.pmFrameConfig = {
            wood: state.wood === 'dab' ? 'Dąb' : 'Sosna',
            color: colorLabels[state.color] || 'Czarny',
            size: state.size,
            passepartout: passepartoutLabels[state.passepartout] || 'Białe'
          };
          heroEl.dispatchEvent(new CustomEvent('pm-config-change', {
            bubbles: true,
            detail: window.pmFrameConfig
          }));
          syncConfigPrice();
        }

        function syncColorOptionsForWood() {
          if (!colorRow) return;
          var pineOnly = state.wood === 'sosna';
          var swatches = colorRow.querySelectorAll('.pm-opt--swatch');
          swatches.forEach(function(btn) {
            var val = btn.getAttribute('data-value');
            var unavailable = pineOnly && val !== 'czarny';
            btn.classList.toggle('is-unavailable', unavailable);
            btn.disabled = unavailable;
            if (unavailable) {
              btn.classList.remove('is-selected');
              btn.setAttribute('aria-pressed', 'false');
            }
          });
          if (pineOnly) {
            var black = colorRow.querySelector('[data-value="czarny"]');
            if (black) {
              swatches.forEach(function(btn) {
                if (btn !== black) {
                  btn.classList.remove('is-selected');
                  btn.setAttribute('aria-pressed', 'false');
                }
              });
              black.classList.add('is-selected');
              black.setAttribute('aria-pressed', 'true');
              state.color = 'czarny';
            }
          }
        }

        toggle.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          var open = root.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          options.hidden = !open;
          syncPmSideShopVisibility();
        });

        root.querySelectorAll('.pm-opt').forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            if (btn.disabled || btn.classList.contains('is-unavailable')) return;
            var row = btn.closest('.pm-config-row');
            if (!row) return;
            row.querySelectorAll('.pm-opt').forEach(function(peer) {
              peer.classList.remove('is-selected');
              peer.setAttribute('aria-pressed', 'false');
            });
            btn.classList.add('is-selected');
            btn.setAttribute('aria-pressed', 'true');
            var key = row.getAttribute('data-row');
            if (key) state[key] = btn.getAttribute('data-value') || state[key];
            if (key === 'wood') syncColorOptionsForWood();
            publishConfig();
          });
        });

        syncDefaultSizeUi();
        syncColorOptionsForWood();
        publishConfig();
        pmNotifySideShopLayout();
      }

      buildPmLeftRail();
      hero.addEventListener('pm-image-loaded', syncPmSideShopVisibility);
      window.addEventListener('resize', syncPmSideShopVisibility);

      if (!cta) return;

      cta.setAttribute('href', '#');

      var chevronsWrap = cta.querySelector('.pm-cta-chevrons');
      if (chevronsWrap) {
        chevronsWrap.style.flexDirection = 'row';
        chevronsWrap.style.gap = '4px';
        chevronsWrap.style.marginTop = '0';
      }
      var chevrons = cta.querySelectorAll('.pm-cta-chevrons svg');
      var delays = ['0s', '0.18s', '0.36s'];
      chevrons.forEach(function(svg, idx) {
        svg.style.transform = 'rotate(-90deg)';
        svg.style.animationName = 'pmChevronHorizontalForced';
        svg.style.animationDuration = '1.8s';
        svg.style.animationTimingFunction = 'ease-in-out';
        svg.style.animationIterationCount = 'infinite';
        svg.style.animationDelay = delays[idx] || '0s';
      });
      document.addEventListener('click', function(e) {
        var trigger = e.target && e.target.closest ? e.target.closest('#pm-cta') : null;
        if (!trigger) return;
        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        root.classList.toggle('pm-app-drawer-open');
      }, true);

      backButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        root.classList.remove('pm-app-drawer-open');
      }, true);
    })();
  </script>
  {% endif %}
  <script>
    (function() {
      var handle = 'twoje-zdjecie-jako-wydruk-giclee-na-papierze-fine-art-w-drewnianej-ramie';
      var productPath = '/products/' + handle;
      function fixWlasnaFotografiaLinks() {
        document.querySelectorAll('a[href*="/pages/fotografia-obraz"]').forEach(function(a) {
          a.setAttribute('href', productPath);
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fixWlasnaFotografiaLinks);
      } else {
        fixWlasnaFotografiaLinks();
      }
    })();
  </script>
  {% render 'giclee-site-notice' %}
  {% if template.suffix == 'faq' %}
  <script>
    /* FAQ a11y — progresywne ulepszenie tylko na stronie FAQ (treść bez zmian) */
    (function () {
      function enhanceFaqA11y() {
        var items = document.querySelectorAll('.accordion accordion-custom');
        items.forEach(function (item, i) {
          var details = item.querySelector('details');
          if (!details) return;
          var summary = details.querySelector('summary');
          var content = details.querySelector('.details-content');
          if (!summary) return;

          if (content) {
            if (!content.id) content.id = 'faq-answer-' + (i + 1);
            summary.setAttribute('aria-controls', content.id);
          }
          summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');

          details.addEventListener('toggle', function () {
            summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');
          });
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', enhanceFaqA11y);
      } else {
        enhanceFaqA11y();
      }
    })();
  </script>
  {% endif %}
</body>
</html>
