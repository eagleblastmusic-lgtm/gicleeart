     // Zatrzymaj autoodtwarzanie na mobile
    if (window.innerWidth <= 767) {
      var observer = new MutationObserver(function() {
        var slideshow = document.querySelector('slideshow-component');
        if (slideshow) {
          slideshow.removeAttribute('autoplay');
          observer.disconnect();
        }
      });
      observer.observe(document.documentElement, { childList: true, subtree: true });
    }

    function removeMobileImages() {
      document.querySelectorAll('.mobile-slide-image').forEach(function(img) {
        img.remove();
      });
    }

    function injectMobileImages() {
      if (window.innerWidth > 767) {
        removeMobileImages();
        return;
      }

      var slides = document.querySelectorAll('slideshow-slide');
      slides.forEach(function(slide, i) {
        if (mobileImages[i] && !slide.querySelector('.mobile-slide-image')) {
          var img = document.createElement('img');
          img.src = mobileImages[i];
          img.className = 'mobile-slide-image';
          img.alt = '';
          img.setAttribute('aria-hidden', 'true');
          slide.insertBefore(img, slide.firstChild);
        }
      });
    }

    // Dodaj szewrony na mobile
    if (window.innerWidth <= 767) {
      document.addEventListener('DOMContentLoaded', function() {
        var slideshow = document.querySelector('slideshow-component');
        if (!slideshow) return;

        var prev = document.createElement('button');
        var next = document.createElement('button');

        prev.className = 'mobile-chevron mobile-chevron--prev';
        next.className = 'mobile-chevron mobile-chevron--next';

        prev.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>';
        next.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>';

        var currentSlide = 0;
        var totalSlides = slideshow.querySelectorAll('slideshow-slide').length;

        prev.addEventListener('click', function() {
          currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
          var dot = slideshow.querySelector('[on\\:click="/select/' + currentSlide + '"]');
          if (dot) dot.click();
        });

        next.addEventListener('click', function() {
          currentSlide = (currentSlide + 1) % totalSlides;
          var dot = slideshow.querySelector('[on\\:click="/select/' + currentSlide + '"]');
          if (dot) dot.click();
        });

        slideshow.appendChild(prev);
        slideshow.appendChild(next);
      });
    }

    var attempts = 0;
    var timer = setInterval(function() {
      injectMobileImages();
      attempts++;
      if (attempts > 20) clearInterval(timer);
    }, 300);

    window.addEventListener('resize', injectMobileImages);
  })();
</script>







  <script>

    (function() {
      // Scroll-triggered animations for homepage, giclee-frame, filozofia-marki
      var scrollPages = ['index', 'page'];
      var scrollSuffixes = ['giclee-frame', 'filozofia-marki', ''];
      var pageType = {{ request.page_type | json }};
      var pageSuffix = {{ template.suffix | default: '' | json }};
      var isScrollPage = pageType === 'index' ||
        (pageType === 'page' && (pageSuffix === 'giclee-frame' || pageSuffix === 'filozofia-marki'));

      if (isScrollPage) {
        var style = document.createElement('style');
        style.textContent = '.scroll-reveal{opacity:0;transform:translateY(28px);transition:opacity 0.75s cubic-bezier(0.16,1,0.3,1),transform 0.75s cubic-bezier(0.16,1,0.3,1)}.scroll-reveal.is-visible{opacity:1;transform:none}';
        document.head.appendChild(style);

        document.addEventListener('DOMContentLoaded', function() {
          var targets = document.querySelectorAll('.shopify-section > *, [class*="section"] > *, img, video, .rte > *');
          var delayed = ['section', 'div', 'article'];
          function shouldSkipReveal(el) {
            if (!el) return true;
            if (el.tagName === 'HR') return true;
            if (el.classList.contains('divider')) return true;
            if (el.classList.contains('divider__line')) return true;
            if (el.classList.contains('section-divider')) return true;
            if ((el.className || '').indexOf('divider') !== -1) return true;
            if ((el.className || '').indexOf('separator') !== -1) return true;
            if (el.querySelector && el.querySelector('.divider, .divider__line, hr')) return true;
            return false;
          }
          var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

          document.querySelectorAll('.shopify-section').forEach(function(section, i) {
            if (section.closest('footer')) return;
            var children = Array.from(section.children);
            children.forEach(function(el, j) {
              if (shouldSkipReveal(el)) return;
              el.classList.add('scroll-reveal');
              el.style.transitionDelay = (j * 0.1) + 's';
              observer.observe(el);
            });
          });
        });
      }
    })();

    (function() {
      document.addEventListener('DOMContentLoaded', function() {
        var allDetails = Array.from(document.querySelectorAll('accordion-custom details'));

        allDetails.forEach(function(details) {
          var summary = details.querySelector('summary');
          if (!summary) return;

          // For direct close (user clicks open accordion):
          // Keep :focus-within true during close so component's transition runs
          summary.addEventListener('mousedown', function(e) {
            if (details.open) {
              e.preventDefault();
              summary.focus({ preventScroll: true });
            }
          });

          // For mutual close (component closes this when another opens):
          // Force focus to this summary so :focus-within stays true during transition
          summary.addEventListener('click', function() {
            if (!details.open) return;
            // We opened another - focus on all currently open ones briefly
            allDetails.forEach(function(d) {
              if (d !== details && d.open) {
                var s = d.querySelector('summary');
                if (s) {
                  s.focus({ preventScroll: true });
                  setTimeout(function() { s.blur(); }, 800);
                }
              }
            });
          });
        });
      });
    })();

    (function() {
      function initCatalogPanel(panel) {
        if (panel._catalogInit) return;
        if (panel._catalogInlineStagger) return;
        panel._catalogInit = true;
        var wasOpen = panel.classList.contains('is-open');

        function runLinkStagger() {
          var links = panel.querySelectorAll('#giclee-artists-list a');
          panel.classList.add('staggering');
          if (panel._linkTimers && panel._linkTimers.length) {
            panel._linkTimers.forEach(function(t) { clearTimeout(t); });
          }
          panel._linkTimers = [];
          links.forEach(function(link) {
            link.classList.remove('is-in');
            link.style.willChange = 'opacity, transform';
            link.style.transition = 'none';
            link.style.opacity = '0';
            link.style.transform = 'translateY(10px)';
            link.style.visibility = 'hidden';
          });
          requestAnimationFrame(function() {
            var openRevealDelay = 100;
            // Keep cascade readable even for long artist lists.
            var maxCascadeMs = Math.min(2200, Math.max(1300, Math.max(0, links.length - 1) * 24));
            var minIntervalMs = 22;
            var maxIntervalMs = 68;
            var intervalCurve = 1.35; // smaller intervals at start, larger near the end
            var intervals = [];
            var totalIntervals = 0;
            for (var k = 0; k < Math.max(0, links.length - 1); k++) {
              var q = (links.length - 2) > 0 ? (k / (links.length - 2)) : 1;
              var rawInterval = minIntervalMs + (maxIntervalMs - minIntervalMs) * Math.pow(q, intervalCurve);
              intervals.push(rawInterval);
              totalIntervals += rawInterval;
            }
            var intervalScale = totalIntervals > 0 ? (maxCascadeMs / totalIntervals) : 1;
            var cumulativeDelay = 0;
            links.forEach(function(link, i) {
              if (i > 0) {
                cumulativeDelay += intervals[i - 1] * intervalScale;
              }
              var easedDelay = Math.round(cumulativeDelay);
              var timer = setTimeout(function() {
                link.style.visibility = 'visible';
                link.offsetHeight; // force style flush before transition
                link.style.transition = 'opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1)';
                link.style.opacity = '1';
                link.style.transform = 'translateY(0)';
                link.classList.add('is-in');
                if (i === links.length - 1) {
                  panel.classList.remove('staggering');
                }
              }, openRevealDelay + easedDelay);
              panel._linkTimers.push(timer);
            });
          });
        }

        function resetLinkStagger() {
          var links = panel.querySelectorAll('#giclee-artists-list a');
          panel.classList.remove('staggering');
          if (panel._linkTimers && panel._linkTimers.length) {
            panel._linkTimers.forEach(function(t) { clearTimeout(t); });
            panel._linkTimers = [];
          }
          links.forEach(function(link) {
            link.classList.remove('is-in');
            link.style.willChange = '';
            link.style.transition = '';
            link.style.opacity = '';
            link.style.transform = '';
            link.style.visibility = '';
          });
        }

        // --- Close on mouseleave ---
        panel.addEventListener('mouseleave', function(e) {
          clearTimeout(panel._closeTimer);
          panel._closeTimer = setTimeout(function() {
            panel.classList.remove('is-open');
          }, 180);
        });
        panel.addEventListener('mouseenter', function() {
          clearTimeout(panel._closeTimer);
        });

        // --- Stagger links on open ---
        panel.addEventListener('giclee:catalog-open', runLinkStagger);
        panel.addEventListener('giclee:catalog-close', resetLinkStagger);
        var observer = new MutationObserver(function(mutations) {
          mutations.forEach(function(m) {
            if (m.attributeName === 'class') {
              if (panel._skipNextObserver) {
                panel._skipNextObserver = false;
                return;
              }
              var isOpenNow = panel.classList.contains('is-open');
              if (isOpenNow === wasOpen) return;
              wasOpen = isOpenNow;
              if (isOpenNow) {
                runLinkStagger();
              } else {
                resetLinkStagger();
              }
            }
          });
        });
        observer.observe(panel, { attributes: true });
      }

      // Try on DOMContentLoaded, then poll in case it's dynamically created
      function tryInit() {
        var panel = document.getElementById('giclee-catalog-panel');
        if (panel) { initCatalogPanel(panel); return; }
        setTimeout(tryInit, 300);
      }
      document.addEventListener('DOMContentLoaded', tryInit);
    })();
  </script>

  <script>
    (function() {
      var overlay = document.getElementById('page-transition');

      var isHomepage = {{ request.page_type | json }} === 'index';
      var isNavigating = false;
      var isOpen = false;

      // Snap panels to closed instantly (no animation)
      overlay.classList.add('active', 'pt-init');
      overlay.querySelectorAll('.pt-panel, .pt-seam').forEach(function(el) {
        el.style.transform = '';
        el.style.transition = '';
        el.style.opacity = '';
      });

      window.addEventListener('load', function() {
        if (isHomepage) {
          // Elegant fade out before splash screen appears
          setTimeout(function() {
            overlay.classList.add('fade-to-splash');
            setTimeout(function() {
              overlay.classList.remove('active', 'pt-init', 'fade-to-splash');
              isOpen = true;
            }, 1500);
          }, 200);
          return;
        }
        // Wait 2 frames to ensure pt-init is rendered, then animate open
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            overlay.classList.remove('pt-init', 'closing');
            overlay.classList.add('opening');
            setTimeout(function() {
              overlay.classList.remove('active', 'opening');
              isOpen = true;
            }, 1700);
          });
        });
      });

      // Close curtains on link click, navigate after full close
      document.addEventListener('click', function(e) {
        if (isNavigating || !isOpen) return;
        var link = e.target.closest('a');
        if (!link) return;
        var href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('javascript') || link.target === '_blank') return;
        if (link.hostname && link.hostname !== window.location.hostname) return;
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('giclee:navigation-start', { detail: { href: href } }));
        isNavigating = true;
        document.body.classList.add('is-navigating');
        overlay.classList.remove('opening');
        overlay.classList.add('active', 'closing');
        setTimeout(function() {
          window.location.href = href;
        }, 950);
      });
    })();
  </script>

  <script>
    (function() {
      var isHomepage = {{ request.page_type | json }} === 'index';
      var splash = document.getElementById('splash-screen');
