    <style>
      html.splash-pending,
      html.splash-reveal {
        overflow-y: hidden;
        background: #000;
      }
      html.splash-pending body,
      html.splash-reveal body {
        overflow-y: hidden;
        background: #000;
      }
      html.splash-pending #splash-screen {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex !important;
        align-items: center;
        justify-content: center;
        background: #000;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
      }
      html.splash-pending body > :not(#page-transition):not(#splash-screen),
      html.splash-pending #header-group,
      html.splash-pending #MainContent,
      html.splash-pending body > footer {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
      }
      html.splash-reveal body > :not(#page-transition):not(#splash-screen) {
        opacity: 0 !important;
        visibility: visible !important;
        pointer-events: none !important;
        transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }
      html.splash-reveal.splash-reveal-active body > :not(#page-transition):not(#splash-screen) {
        opacity: 1 !important;
        pointer-events: auto !important;
      }
      html.splash-reveal slideshow-component,
      html.splash-reveal slideshow-component * {
        transition: none !important;
        animation: none !important;
      }
      html.splash-pending #page-transition,
      html.splash-reveal #page-transition {
        display: none !important;
      }
      html.splash-pending #MainContent,
      html.splash-reveal #MainContent {
        overflow: hidden;
        max-height: 100vh;
      }
      html[data-giclee-skip-splash="1"] #splash-screen {
        display: none !important;
      }
    </style>
