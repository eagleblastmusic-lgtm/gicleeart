  <script>
    (function() {
      var nativeScrollTo = window.scrollTo.bind(window);
      window.scrollTo = function(arg1, arg2) {
        var top = null;
        var behavior = '';
        if (typeof arg1 === 'object' && arg1) {
          if (typeof arg1.top === 'number') top = arg1.top;
          behavior = String(arg1.behavior || '');
        } else if (typeof arg1 === 'number') {
          top = arg1;
        }

        var current = window.pageYOffset || window.scrollY || 0;
        var delta = (typeof top === 'number') ? Math.abs(top - current) : Infinity;

        // Disable short magnetic smooth snaps on this template.
        if (behavior === 'smooth' && delta <= 260) return;
        return nativeScrollTo(arg1, arg2);
      };
    })();
  </script>
