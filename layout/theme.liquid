  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">

  <div id="page-transition">
    <div class="pt-panel pt-left" style="transform:scaleX(1);transition:none"></div>
    <div class="pt-seam" style="opacity:1;transition:none"></div>
    <div class="pt-panel pt-right" style="transform:scaleX(1);transition:none"></div>
  </div>

  {% unless request.page_type == 'index' %}<style>#splash-screen{display:none!important}</style>{% endunless %}
  <div id="splash-screen">
    <div class="splash-content">
      <p class="splash-title">Giclée Art</p>
      <div class="splash-line"></div>
      <p class="splash-sub">Witamy w świecie sztuki</p>
    </div>
  </div>

  <style>
    #page-transition {
      position: fixed;
      inset: 0;
      z-index: 99998;
      pointer-events: none;
      display: flex;
    }
    #page-transition.active {
      pointer-events: all;
    }
    .pt-panel {
      position: fixed;
      top: 0;
      width: 51%;
      height: 100%;
      background: #080808;
      will-change: transform;
      transform: scaleX(0);
    }
    .pt-left  { left: 0;  transform-origin: left center; }
    .pt-right { right: 0; transform-origin: right center; }
    .pt-seam {
      position: fixed;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 1px;
      height: 100%;
      background: linear-gradient(to bottom, transparent 10%, #c9a84c 40%, #c9a84c 60%, transparent 90%);
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1;
    }
    #page-transition.pt-init .pt-panel {
      transform: scaleX(1);
      transition: none !important;
    }
    #page-transition.pt-init .pt-seam {
      opacity: 1;
      transition: none !important;
    }
    #page-transition.closing .pt-panel {
      transform: scaleX(1);
      transition: transform 0.9s cubic-bezier(0.76, 0, 0.24, 1);
    }
    #page-transition.closing .pt-seam {
      opacity: 1;
      transition-delay: 0.75s;
    }
    #page-transition.opening .pt-panel {
      transform: scaleX(0);
      transition: transform 1.6s cubic-bezier(0.45, 0, 0.15, 1);
    }
    #page-transition.opening .pt-seam {
      opacity: 0;
      transition-delay: 0s;
    }
    {% if template.suffix == 'faq' %}
    /* ===== FAQ ANIMATIONS ===== */
    accordion-custom {
      --animation-speed-slow: 700ms;
      --animation-easing: cubic-bezier(0.4, 0, 0.2, 1);
    }
    @keyframes faqItemIn {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    accordion-custom {
      opacity: 0;
      animation: faqItemIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    accordion-custom:nth-child(1)  { animation-delay: 0.8s; }
    accordion-custom:nth-child(2)  { animation-delay: 0.95s; }
    accordion-custom:nth-child(3)  { animation-delay: 1.1s; }
    accordion-custom:nth-child(4)  { animation-delay: 1.25s; }
    accordion-custom:nth-child(5)  { animation-delay: 1.4s; }
    accordion-custom:nth-child(6)  { animation-delay: 1.55s; }
    accordion-custom:nth-child(7)  { animation-delay: 1.7s; }
    accordion-custom:nth-child(8)  { animation-delay: 1.85s; }
    accordion-custom:nth-child(n+9){ animation-delay: 2.0s; }

    /* Płynne rozwijanie i zwijanie — nadpisuje wbudowane transition: none przy :not(:focus-within) */
    accordion-custom details .details-content,
    accordion-custom details::details-content,
    accordion-custom details:not(:focus-within) .details-content,
    accordion-custom details:not(:focus-within)::details-content {
      transition:
        block-size 0.75s cubic-bezier(0.4, 0, 0.2, 1),
        opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
        padding-block 0.75s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

    /* Złota kreska po lewej przy otwartym */
    accordion-custom details {
      border-left: 1px solid transparent;
      padding-left: 0;
      transition: border-color 0.5s ease, padding-left 0.5s ease;
    }
    accordion-custom details[open] {
      border-left: 1px solid rgba(201, 168, 76, 0.4);
      padding-left: 16px;
    }

    /* Summary */
    accordion-custom details summary {
      transition: color 0.3s ease, letter-spacing 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    accordion-custom details[open] summary {
      letter-spacing: 0.025em;
    }
    {% endif %}

    /* ===== CONTACT TEXTAREA TRANSITION ===== */
    .contact-form__input--textarea {
      transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease !important;
    }

    /* ===== FAQ GOLDEN BAR SCROLLBAR FIX ===== */
    accordion-custom details {
      position: relative;
    }
    accordion-custom details[open] {
      border-left: 1px solid rgba(201, 168, 76, 0.4);
      padding-left: 16px;
    }

    {% if request.page_type == 'page' %}
    /* ===== CONTACT FORM STAGGER ANIMATION ===== */
    @keyframes fieldReveal {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .contact-form__form-row,
    .contact-form__form > .contact-form__input,
    .contact-form__form > .contact-form__input--textarea,
    .contact-form__form > *:last-child {
      opacity: 0;
      animation: fieldReveal 0.75s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .contact-form__form-row                             { animation-delay: 0.8s; }
    .contact-form__form > .contact-form__input          { animation-delay: 0.98s; }
    .contact-form__form > .contact-form__input--textarea { animation-delay: 1.16s; }
    .contact-form__form > *:last-child                  { animation-delay: 1.34s; }
    {% endif %}

    #page-transition:not(.closing):not(.pt-init) .pt-seam {
      opacity: 0 !important;
      transition: none !important;
    }
    body.is-navigating [class*="dropdown"],
    body.is-navigating [class*="submenu"],
    body.is-navigating [class*="mega-menu"],
    body.is-navigating [class*="popover"],
    body.is-navigating [class*="nav-"] [class*="child"],
    body.is-navigating details[open] > :not(summary),
    body.is-navigating .header__submenu,
    body.is-navigating [data-open="true"] {
      display: none !important;
      opacity: 0 !important;
      visibility: hidden !important;
    }
    #giclee-catalog-panel {
      clip-path: inset(0 0 100% 0) !important;
      transform: none !important;
      transition: clip-path 0.85s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.85s !important;
    }
    #giclee-catalog-panel.is-open {
      clip-path: inset(0 0 0% 0) !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
    #giclee-catalog-panel.is-open.is-closing {
      clip-path: inset(0 0 100% 0) !important;
      opacity: 1 !important;
      visibility: visible !important;
      transition: clip-path 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) !important;
    }
    #giclee-catalog-panel.is-closing #giclee-artist-preview {
      opacity: 0.88;
      transform: translateY(-6px);
      transition: opacity 0.22s ease, transform 0.22s ease;
    }
    #giclee-catalog-panel.is-closing #giclee-artists-list {
      opacity: 1;
      /* Close animation handled by JS height tween to avoid instant cut. */
    }
    @keyframes catalogColIn {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    #giclee-catalog-panel.is-open #giclee-artists-list {
      animation: none;
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
    #giclee-catalog-panel.is-open #giclee-artist-preview {
      animation: catalogColIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both;
    }
    @keyframes linkStagger {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    body.is-navigating #giclee-catalog-panel {
      clip-path: none !important;
      transform: translateY(-200vh) !important;
      transition: transform 0.9s cubic-bezier(0.76, 0, 0.24, 1) !important;
      pointer-events: none !important;
    }
    #page-transition.fade-to-splash {
      opacity: 0;
      transition: opacity 1.4s ease;
      pointer-events: none;
    }
    /* Force consistent collection tiles layout between local and live */
    main[data-template*="list-collections"] .resource-list--grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
    @media screen and (min-width: 750px) {
      main[data-template*="list-collections"] .resource-list--grid {
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      }
    }
    {% if template.suffix == 'fotografia-obraz' %}
    #pm-hero {
      --pm-lift: 0px !important;
      transform: none !important;
      will-change: auto !important;
      transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) !important;
    }
    #pm-hero-ui {
      transform: none !important;
      will-change: auto !important;
      transition: none !important;
    }
    html body #pm-hero.loaded .pm-cta {
      opacity: 1 !important;
      pointer-events: auto !important;
      visibility: visible !important;
      animation: pmCtaReveal 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both !important;
    }

    #shopify-section-template--29328540959068__custom_liquid_XCVirJ {
      position: relative;
      z-index: 60;
      isolation: isolate;
      transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }
    body.pm-app-drawer-open #shopify-section-template--29328540959068__custom_liquid_XCVirJ {
      transform: translateX(-100vw);
    }

    .shopify-section:has(#giclee-shell) {
      display: block !important;
      position: fixed !important;
      top: 0;
      right: 0;
      width: 100vw;
      height: 100vh;
      z-index: 100;
      transform: translateX(100%);
      transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      pointer-events: none;
      margin: 0 !important;
      padding: 0 !important;
      isolation: isolate;
    }
    .shopify-section:has(#giclee-shell) .section--page-width,
    .shopify-section:has(#giclee-shell) .spacing-style,
    .shopify-section:has(#giclee-shell) .section {
      max-width: none !important;
      width: 100vw !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    body.pm-app-drawer-open .shopify-section:has(#giclee-shell) {
      transform: translateX(0);
      pointer-events: auto;
    }
    #giclee-shell {
      width: 100vw !important;
      height: 100vh !important;
      margin-left: calc(-50vw + 50%) !important;
      position: relative !important;
      overflow: hidden !important;
      background: #000 !important;
    }
    #giclee-tool {
      width: 100% !important;
      height: 100% !important;
      border: 0 !important;
      display: block !important;
      background: #000 !important;
    }
    /* Ukryj pasek przewijania strony, gdy aplikacja jest otwarta */
    html:has(body.pm-app-drawer-open),
    body.pm-app-drawer-open {
      overflow: hidden !important;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    body.pm-app-drawer-open::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }
    html:has(body.pm-app-drawer-open)::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }

    #pm-cta {
      position: fixed !important;
      right: 16px !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      z-index: 120 !important;
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
      display: inline-flex !important;
      flex-direction: column !important;
      align-items: center !important;
      gap: 14px !important;
      text-align: center !important;
    }
    #pm-cta .pm-cta-label {
      order: 2;
      margin-top: 4px !important;
    }
    #pm-cta .pm-cta-chevrons {
      order: 1;
      flex-direction: row !important;
      gap: 4px;
      margin-top: 0 !important;
    }
    #pm-cta .pm-cta-chevrons svg {
      transform: rotate(-90deg);
    }
    #pm-cta .pm-cta-chevrons svg:nth-child(1) {
      animation: pmChevronRight 1.8s ease-in-out infinite 0s !important;
    }
    #pm-cta .pm-cta-chevrons svg:nth-child(2) {
      animation: pmChevronRight 1.8s ease-in-out infinite 0.18s !important;
    }
    #pm-cta .pm-cta-chevrons svg:nth-child(3) {
      animation: pmChevronRight 1.8s ease-in-out infinite 0.36s !important;
    }
    @keyframes pmChevronRight {
      0%, 100% { transform: rotate(-90deg) translateX(0); }
      50%      { transform: rotate(-90deg) translateX(6px); }
    }
    @keyframes pmChevronHorizontalForced {
      0%, 100% { transform: rotate(-90deg) translateX(0); }
      50%      { transform: rotate(-90deg) translateX(6px); }
    }
    @keyframes pmChevron {
      0%, 100% { transform: rotate(-90deg) translateX(0); }
      50%      { transform: rotate(-90deg) translateX(6px); }
    }
    #pm-lab-invite {
      position: absolute;
      left: clamp(20px, 4vw, 52px);
      top: 50%;
      transform: translateY(-50%) translateX(-18px);
      max-width: min(32ch, 37vw);
      z-index: 25;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      color: rgba(255, 255, 255, 0.9);
      font-family: "Cormorant Garamond", Georgia, serif;
      font-size: clamp(20px, 1.55vw, 28px);
      line-height: 1.3;
      letter-spacing: 0.01em;
      text-wrap: balance;
      text-shadow: 0 8px 26px rgba(0, 0, 0, 0.55);
      padding-left: clamp(18px, 2vw, 26px);
      border-left: none;
      transition: opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.85s cubic-bezier(0.22, 1, 0.36, 1),
                  visibility 0.85s;
    }
    #pm-lab-invite::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 2px;
      border-radius: 1px;
      background: linear-gradient(
        180deg,
        rgba(201, 168, 76, 0.2) 0%,
        rgba(201, 168, 76, 0.95) 50%,
        rgba(201, 168, 76, 0.25) 100%
      );
      box-shadow: 0 0 14px rgba(201, 168, 76, 0.22);
      animation: pmInviteLineShimmer 3.8s ease-in-out infinite;
    }
    html body #pm-hero.loaded #pm-lab-invite {
      opacity: 1;
      visibility: visible;
      transform: translateY(-50%) translateX(0);
      animation:
        pmInviteReveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both,
        pmInviteAmbient 7s ease-in-out infinite 1.15s;
    }
    #pm-lab-invite strong {
      display: block;
      margin-bottom: 10px;
      font-size: clamp(12px, 0.8vw, 14px);
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(201, 168, 76, 0.92);
      font-family: Inter, Arial, sans-serif;
      animation: pmInviteGoldPulse 5s ease-in-out infinite 0.4s;
    }
    @keyframes pmInviteReveal {
      from { opacity: 0; transform: translateY(-50%) translateX(-18px); filter: blur(2px); }
      to   { opacity: 1; transform: translateY(-50%) translateX(0); filter: blur(0); }
    }
    @keyframes pmInviteAmbient {
      0%, 100% {
        opacity: 1;
        text-shadow: 0 8px 26px rgba(0, 0, 0, 0.55);
        transform: translateY(-50%) translateX(0);
      }
      50% {
        opacity: 0.94;
        text-shadow: 0 12px 34px rgba(0, 0, 0, 0.62);
        transform: translateY(calc(-50% - 3px)) translateX(0);
      }
    }
    @keyframes pmInviteAmbientMobile {
      0%, 100% {
        opacity: 1;
        text-shadow: 0 8px 26px rgba(0, 0, 0, 0.55);
        transform: translateX(-50%) translateY(0);
      }
      50% {
        opacity: 0.93;
        text-shadow: 0 12px 34px rgba(0, 0, 0, 0.62);
        transform: translateX(-50%) translateY(-4px);
      }
    }
    @keyframes pmInviteLineShimmer {
      0%, 100% { opacity: 0.65; box-shadow: 0 0 10px rgba(201, 168, 76, 0.18); }
      50% { opacity: 1; box-shadow: 0 0 22px rgba(201, 168, 76, 0.42); }
    }
    @keyframes pmInviteGoldPulse {
      0%, 100% { color: rgba(201, 168, 76, 0.82); letter-spacing: 0.22em; }
      50% { color: rgba(230, 207, 146, 0.98); letter-spacing: 0.24em; }
    }
