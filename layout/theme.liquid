  <style>
    #page-transition {
      position: fixed;
      inset: 0;
      z-index: 99998;
      pointer-events: none;
      display: flex;
    }
    #page-transition.active,
    #page-transition.pt-init,
    #page-transition.closing,
    #page-transition.opening {
      z-index: 2147483647;
    }
    #page-transition.active {
      pointer-events: all;
    }
    #page-transition.opening {
      pointer-events: none;
    }
    #page-transition.closing,
    #page-transition.pt-init {
      pointer-events: all;
    }
    .pt-panel {
      position: fixed;
      top: 0;
      width: 50%;
      height: 100%;
      background: #080808;
      will-change: transform;
      --pt-open-duration: 1.25s;
      --pt-close-duration: 0.72s;
      transition: transform var(--pt-open-duration) cubic-bezier(0.45, 0, 0.15, 1);
    }
    .pt-left {
      left: 0;
      transform: translateX(-100%);
    }
    .pt-right {
      right: 0;
      transform: translateX(100%);
    }
    .pt-seam {
      position: fixed;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 1px;
      height: 100%;
      background: linear-gradient(to bottom, transparent 10%, #c9a84c 40%, #c9a84c 60%, transparent 90%);
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1;
      pointer-events: none;
    }
    #page-transition.pt-init .pt-left,
    #page-transition.closing .pt-left {
      transform: translateX(0);
    }
    #page-transition.pt-init .pt-right,
    #page-transition.closing .pt-right {
      transform: translateX(0);
    }
    #page-transition.pt-init .pt-panel,
    #page-transition.closing .pt-panel {
      transition: transform var(--pt-close-duration, 0.72s) cubic-bezier(0.76, 0, 0.24, 1);
    }
    #page-transition.pt-init .pt-seam {
      opacity: 1;
      transition: none !important;
    }
    #page-transition.closing .pt-seam {
      opacity: 1;
      transition: opacity 0.25s ease;
      transition-delay: 0.45s;
    }
    #page-transition.opening .pt-left {
      transform: translateX(-100%);
    }
    #page-transition.opening .pt-right {
      transform: translateX(100%);
    }
    #page-transition.opening .pt-panel {
      transition: transform var(--pt-open-duration, 1.25s) cubic-bezier(0.45, 0, 0.15, 1);
    }
    #page-transition.opening .pt-seam {
      opacity: 0;
      transition-delay: 0s;
    }
    #giclee-catalog-panel {
      clip-path: inset(0 0 100% 0) !important;
      transform: none !important;
      transition: clip-path 0.85s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.85s !important;
    }
    #giclee-catalog-panel.is-open {
      clip-path: inset(0 0 0% 0) !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
    #giclee-catalog-panel.is-open.is-closing {
      clip-path: inset(0 0 100% 0) !important;
      opacity: 1 !important;
      visibility: visible !important;
      transition: clip-path 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) !important;
    }
    body.is-navigating #giclee-catalog-panel.is-open.is-nav-lifting {
      z-index: 2147483647 !important;
      clip-path: inset(0 0 0% 0) !important;
      opacity: 1 !important;
